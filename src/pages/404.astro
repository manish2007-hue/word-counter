---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="404: Page Not Found | CleanWordCounter"
  description="The page you requested does not exist. Click to return to CleanWordCounter's free, private word counter workspace."
>
  <div class="mx-auto max-w-xl px-4 py-20 sm:py-28 text-center">
    
    <!-- Status Badge -->
    <div class="inline-flex h-16 w-16 items-center justify-center rounded-[12px] border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] text-[#0070f3] text-2xl font-bold font-mono shadow-sm mb-6">
      404
    </div>

    <!-- Main Heading -->
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed] mb-3">
      Page Not Found
    </h1>

    <p class="text-xs sm:text-sm text-[#8f8f8f] max-w-md mx-auto leading-relaxed mb-8">
      The destination you requested does not exist or may have moved. Use the quick links below to jump directly to our writing tools.
    </p>

    <!-- Primary Action Button -->
    <div class="mb-10">
      <a
        href={`${base}/`}
        class="vercel-btn-primary inline-flex text-sm py-2.5 px-6"
      >
        <span>Launch Word Counter Workspace</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

    <!-- Quick Tool Directory -->
    <div class="border-t border-[#ebebeb] dark:border-[#222222] pt-8">
      <div class="mono-eyebrow text-[#8f8f8f] mb-3 text-xs">Explore Other Utilities</div>
      <div class="flex flex-wrap items-center justify-center gap-2">
        <a
          href={`${base}/readability-checker`}
          class="px-3 py-1.5 rounded-[6px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e] text-xs font-mono text-[#171717] dark:text-[#ededed] hover:border-[#0070f3] hover:text-[#0070f3] transition"
        >
          Readability Calculator →
        </a>
        <a
          href={`${base}/social-media-counter`}
          class="px-3 py-1.5 rounded-[6px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e] text-xs font-mono text-[#171717] dark:text-[#ededed] hover:border-[#0070f3] hover:text-[#0070f3] transition"
        >
          Social Limits (10 Channels) →
        </a>
        <a
          href={`${base}/keyword-density-checker`}
          class="px-3 py-1.5 rounded-[6px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e] text-xs font-mono text-[#171717] dark:text-[#ededed] hover:border-[#0070f3] hover:text-[#0070f3] transition"
        >
          Keyword Density N-Grams →
        </a>
        <a
          href={`${base}/academic-word-counter`}
          class="px-3 py-1.5 rounded-[6px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e] text-xs font-mono text-[#171717] dark:text-[#ededed] hover:border-[#0070f3] hover:text-[#0070f3] transition"
        >
          Academic Citation Mode →
        </a>
      </div>
    </div>

  </div>
</Layout>
