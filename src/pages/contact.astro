---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Contact & Feedback — WordCountr";
const pageDescription = "Get in touch with the WordCountr team for feature suggestions, bug reports, and partnership inquiries.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalSlug="contact"
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-10 shadow-xs">
      
      <span class="inline-block rounded-full bg-blue-50 dark:bg-blue-950/40 px-3 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-4">
        Support & Feedback
      </span>

      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4">
        Contact the WordCountr Team
      </h1>

      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
        Have an idea for a new writing tool? Found an edge-case syllable bug? Or want to suggest support for a new academic citation style? We'd love to hear from you.
      </p>

      <div class="space-y-4">
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 p-4 bg-slate-50 dark:bg-slate-800/40">
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">General Inquiries & Feedback</div>
          <a href="mailto:hello@wordcountr.app" class="font-medium text-sm text-blue-600 dark:text-blue-400 hover:underline">hello@wordcountr.app</a>
        </div>

        <div class="rounded-xl border border-slate-200 dark:border-slate-800 p-4 bg-slate-50 dark:bg-slate-800/40">
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Bug Reports & Contributions</div>
          <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">Please submit detailed reproducibility steps and sample text snippets to help us keep tokenization accurate.</p>
        </div>
      </div>

    </div>
  </div>
</Layout>
