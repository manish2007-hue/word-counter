---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Contact & Feedback — WordCountr";
const pageDescription = "Get in touch with the WordCountr team for feature suggestions, bug reports, and partnership inquiries.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalSlug="contact"
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="vercel-card p-6 sm:p-10">
      
      <div class="mono-eyebrow text-[#0070f3] mb-3">
        Developer Support & Feedback
      </div>

      <h1 class="text-3xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed] mb-4">
        Contact the WordCountr Team
      </h1>

      <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed mb-6">
        Have an idea for a new writing tool? Found an edge-case tokenization bug? Or want to suggest support for a new academic citation format? We'd love to hear from you.
      </p>

      <div class="space-y-4">
        <div class="rounded-[8px] border border-[#ebebeb] dark:border-[#222222] p-4 bg-[#fafafa] dark:bg-[#0e0e0e]">
          <div class="mono-eyebrow text-[#8f8f8f] mb-1">General Inquiries & Feedback</div>
          <a href="mailto:hello@wordcountr.app" class="font-medium text-sm text-[#0070f3] hover:underline font-mono">hello@wordcountr.app</a>
        </div>

        <div class="rounded-[8px] border border-[#ebebeb] dark:border-[#222222] p-4 bg-[#fafafa] dark:bg-[#0e0e0e]">
          <div class="mono-eyebrow text-[#8f8f8f] mb-1">Bug Reports & Tokenization Issues</div>
          <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">Please submit detailed reproducibility steps and sample text snippets to help us keep parsing 100% accurate.</p>
        </div>
      </div>

    </div>
  </div>
</Layout>
