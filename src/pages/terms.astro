---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Terms & Conditions — CleanWordCounter";
const pageDescription = "Terms and conditions for using CleanWordCounter, the free, 100% private in-browser word counter and text analytics workbench.";
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalSlug="terms"
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-14 sm:py-20">
    
    <!-- Top Pill & Title -->
    <div class="mb-8">
      <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#0070f3]/25 bg-[#0070f3]/10 px-3 py-1 text-[#0070f3] mb-4">
        <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
        <span>Transparent User Agreement</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
        Terms &amp; Conditions
      </h1>

      <p class="mt-3 text-sm sm:text-base text-[#8f8f8f] leading-relaxed">
        Last updated: November 2026 · Plain-English legal terms governing the use of CleanWordCounter software.
      </p>
    </div>

    <!-- Terms Card -->
    <div class="vercel-card p-6 sm:p-10 space-y-8 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
      
      <div>
        <h2 class="text-base font-semibold text-[#171717] dark:text-[#ededed] mb-2 tracking-tight">1. Acceptance of Terms</h2>
        <p>
          By accessing, using, or installing CleanWordCounter (including our web application, Progressive Web App, and static utilities), you acknowledge that you have read, understood, and agreed to be bound by these Terms &amp; Conditions and our <a href={`${base}/privacy`} class="text-[#0070f3] hover:underline">Privacy Policy</a>. If you do not agree with any part of these terms, please discontinue using the tool.
        </p>
      </div>

      <div>
        <h2 class="text-base font-semibold text-[#171717] dark:text-[#ededed] mb-2 tracking-tight">2. Free &amp; Unrestricted Utility License</h2>
        <p>
          CleanWordCounter is provided completely free of charge. You are granted a non-exclusive, worldwide, royalty-free license to use the application for personal, educational, academic, editorial, non-profit, commercial, and enterprise purposes. There are no word count limits, file size paywalls, subscription fees, or feature gates.
        </p>
      </div>

      <div>
        <h2 class="text-base font-semibold text-[#171717] dark:text-[#ededed] mb-2 tracking-tight">3. User Content &amp; 100% Intellectual Property Retention</h2>
        <p>
          You retain exclusive and complete ownership, copyright, and intellectual property rights over all text, essays, books, poetry, legal filings, code, notes, and documents you type, paste, or upload into CleanWordCounter.
        </p>
        <p class="mt-2 font-mono text-xs text-[#0070f3]">
          Because CleanWordCounter operates 100% client-side in browser memory, we never receive, store, view, or claim any license to your work.
        </p>
      </div>

      <div>
        <h2 class="text-base font-semibold text-[#171717] dark:text-[#ededed] mb-2 tracking-tight">4. Permissible Use</h2>
        <p>
          You agree not to attempt to reverse engineer, disrupt, overload, or compromise the client-side delivery of CleanWordCounter, or redistribute the software in bad faith under misleading trademarks without attribution. You may utilize the tool for analyzing any lawful text of your choosing.
        </p>
      </div>

      <div>
        <h2 class="text-base font-semibold text-[#171717] dark:text-[#ededed] mb-2 tracking-tight">5. Algorithmic Disclaimer &amp; Verification</h2>
        <p>
          CleanWordCounter calculates word counts, character lengths, readability scores (Flesch-Kincaid, Gunning Fog, Coleman-Liau, ARI), keyword densities, and academic citation exclusions based on widely accepted computational linguistic standards. However, because different institutions, academic professors, or competition panels may utilize conflicting counting guidelines (e.g., whether hyphenated terms count as one word or two), users are advised to verify critical submission thresholds against their specific institutional guidelines.
        </p>
      </div>

      <div>
        <h2 class="text-base font-semibold text-[#171717] dark:text-[#ededed] mb-2 tracking-tight">6. Disclaimer of Warranties</h2>
        <p>
          CleanWordCounter is provided on an "AS IS" and "AS AVAILABLE" basis, without warranties of any kind, whether express, statutory, or implied, including but not limited to implied warranties of merchantability, fitness for a particular purpose, or non-infringement. We do not warrant that the application will be uninterrupted, error-free, or compatible with obsolete browser software.
        </p>
      </div>

      <div>
        <h2 class="text-base font-semibold text-[#171717] dark:text-[#ededed] mb-2 tracking-tight">7. Limitation of Liability</h2>
        <p>
          Under no circumstances shall CleanWordCounter, its creators, maintainers, or hosting contributors be liable for any direct, indirect, incidental, consequential, or punitive damages resulting from the use or inability to use the application, including but not limited to lost data, missed academic deadlines, or publisher submission disqualifications.
        </p>
      </div>

      <div>
        <h2 class="text-base font-semibold text-[#171717] dark:text-[#ededed] mb-2 tracking-tight">8. Updates to These Terms</h2>
        <p>
          We reserve the right to revise or update these terms periodically to reflect new features or regulatory standards. Continued use of CleanWordCounter following any updates constitutes acceptance of the revised terms.
        </p>
      </div>

      <div>
        <h2 class="text-base font-semibold text-[#171717] dark:text-[#ededed] mb-2 tracking-tight">9. Contact Information</h2>
        <p>
          For legal inquiries, licensing questions, or terms feedback, reach out to <a href="mailto:hello@cleanwordcounter.com" class="text-[#0070f3] hover:underline font-mono">hello@cleanwordcounter.com</a>.
        </p>
      </div>

    </div>

    <!-- Return to Workspace Button -->
    <div class="mt-8 text-center sm:text-left">
      <a href={`${base}/`} class="vercel-btn-primary inline-flex">
        <span>← Return to Word Counter Workspace</span>
      </a>
    </div>

  </div>
</Layout>
