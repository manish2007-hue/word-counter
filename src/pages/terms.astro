---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Terms of Service — WordCountr";
const pageDescription = "Terms of Service for using WordCountr, the free private online word counter and writing companion.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalSlug="terms"
>
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-12 shadow-xs">
      
      <span class="inline-block rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-4">
        Legal Agreement
      </span>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-6">
        Terms of Service
      </h1>

      <div class="prose text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-400 space-y-5">
        <p>Last updated: November 2026</p>

        <h3 class="text-lg font-bold text-slate-900 dark:text-white">1. Agreement to Terms</h3>
        <p>
          By accessing and using WordCountr (wordcountr.app), you agree to these Terms of Service. If you do not agree to these terms, please do not use the tool.
        </p>

        <h3 class="text-lg font-bold text-slate-900 dark:text-white">2. Free Utility License</h3>
        <p>
          WordCountr is provided free of charge for personal, academic, commercial, and professional use. You are free to calculate metrics for any amount of text, manuscripts, essays, or client documents without restrictions.
        </p>

        <h3 class="text-lg font-bold text-slate-900 dark:text-white">3. Client-Side Processing & Intellectual Property</h3>
        <p>
          You retain 100% ownership of all text, documents, files, and manuscripts you paste or upload into WordCountr. Because the tool runs locally in your web browser, WordCountr never claims, stores, or accesses any copyright or intellectual property rights over your content.
        </p>

        <h3 class="text-lg font-bold text-slate-900 dark:text-white">4. Disclaimer of Warranties</h3>
        <p>
          WordCountr is provided "as is" without warranty of any kind. While our tokenization and readability algorithms are thoroughly tested against standard literary corpora, users submitting academic assignments or publisher manuscripts are advised to perform standard final compliance reviews.
        </p>
      </div>

    </div>
  </div>
</Layout>
