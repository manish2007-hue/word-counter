---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Terms of Service — WordCountr";
const pageDescription = "Terms of Service for using WordCountr, the free private online word counter and writing companion.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalSlug="terms"
>
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <div class="vercel-card p-6 sm:p-12">
      
      <div class="mono-eyebrow text-[#0070f3] mb-3">
        Legal Agreement
      </div>

      <h1 class="text-3xl sm:text-4xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed] mb-6">
        Terms of Service
      </h1>

      <div class="text-xs sm:text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1a1] space-y-5">
        <p class="font-mono text-xs text-[#8f8f8f]">Last updated: November 2026</p>

        <h3 class="text-base font-semibold text-[#171717] dark:text-[#ededed] tracking-tight">1. Agreement to Terms</h3>
        <p>
          By accessing and using WordCountr, you agree to these Terms of Service. If you do not agree to these terms, please discontinue use.
        </p>

        <h3 class="text-base font-semibold text-[#171717] dark:text-[#ededed] tracking-tight">2. Free Utility License</h3>
        <p>
          WordCountr is provided free of charge for personal, academic, commercial, and professional use. You are free to calculate metrics for any amount of text, manuscripts, essays, or client documents without restrictions.
        </p>

        <h3 class="text-base font-semibold text-[#171717] dark:text-[#ededed] tracking-tight">3. Client-Side Processing & Intellectual Property</h3>
        <p>
          You retain 100% ownership of all text, documents, files, and manuscripts you paste or upload into WordCountr. Because the tool runs locally in your web browser, WordCountr never claims, stores, or accesses any copyright or intellectual property rights over your content.
        </p>

        <h3 class="text-base font-semibold text-[#171717] dark:text-[#ededed] tracking-tight">4. Disclaimer of Warranties</h3>
        <p>
          WordCountr is provided "as is" without warranty of any kind. While our tokenization and readability algorithms are thoroughly tested against standard literary corpora, users submitting academic assignments or publisher manuscripts are advised to perform standard final compliance reviews.
        </p>
      </div>

    </div>
  </div>
</Layout>
