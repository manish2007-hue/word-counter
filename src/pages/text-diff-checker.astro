---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Text Diff Checker Online – Compare Text & Code Differences Privately";
const pageDescription = "Compare two text versions or code snippets online. Free, private, and 100% in-browser text comparison tool with side-by-side split and unified views.";
const pageKeywords = "text diff checker, text compare online, compare two texts, difference finder, code diff checker, private text compare";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Text Diff Checker Online",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": pageDescription,
      "url": "https://cleanwordcounter.com/text-diff-checker/"
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalSlug="text-diff-checker"
  schema={schema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 pb-4 text-center">
    <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] px-3.5 py-1 text-[#0070f3] shadow-2xs mb-3">
      <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
      <span>Compare Text &amp; Code Differences</span>
    </div>
    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
      Text Diff <span class="vercel-gradient-develop">Checker</span>
    </h1>
    <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
      Compare two revisions of essays, code, or legal documents with live green additions and red deletions.
    </p>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 text-center my-8">
    <a
      href="/diff-checker"
      class="inline-flex items-center gap-2 px-6 py-3 rounded-[8px] bg-[#0070f3] text-white font-semibold text-sm hover:bg-[#0060df] transition shadow-md"
    >
      <span>Open Private Diff Checker Workspace →</span>
    </a>
  </div>
</Layout>
