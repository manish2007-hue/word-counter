---
import Layout from '../layouts/Layout.astro';
import ToolAuthoritySection from '../components/ToolAuthoritySection.astro';

const pageTitle = "Base64 Encoder & Decoder – Text and Image to Base64 Online";
const pageDescription = "Free online Base64 encoder and decoder for text and images. Convert images to Base64 data URIs, HTML img tags, and CSS backgrounds. Full UTF-8 Unicode support with 100% private in-browser conversion.";
const pageKeywords = "base64 encode, base64 decode, image to base64, base64 converter, text to base64, base64 data uri, online base64 decoder";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Base64 Encoder & Decoder",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": pageDescription,
      "url": "https://cleanwordcounter.com/base64-converter/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does this Base64 tool support international Unicode and emojis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Unlike basic web encoders that fail on non-ASCII characters, our engine uses UTF-8 byte streams via modern Web API TextEncoder, handling Japanese, Arabic, Cyrillic, accented characters, and emojis seamlessly."
          }
        },
        {
          "@type": "Question",
          "name": "Why does Base64 increase data size by ~33%?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Base64 converts 3 bytes of 8-bit binary data (24 bits) into 4 printable ASCII characters of 6 bits each. This 4/3 ratio creates an inherent ~33.3% size overhead."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalSlug="base64-converter"
  schema={schema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 pb-2 text-center">
    <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] px-3.5 py-1 text-[#0070f3] shadow-2xs mb-3">
      <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
      <span>Text &bull; Images &bull; Full UTF-8 Unicode &bull; Data URIs &bull; 100% Private</span>
    </div>
    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
      Base64 <span class="vercel-gradient-develop">Encoder &amp; Decoder</span>
    </h1>
    <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
      Encode and decode text with full Unicode support or convert images into ready-to-paste Base64 Data URIs, HTML tags, and CSS rules.
    </p>
  </div>

  <main class="mx-auto max-w-5xl px-4 sm:px-6 py-8">
    <!-- Mode Switcher -->
    <div class="flex justify-center mb-6">
      <div class="inline-flex p-1 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] shadow-2xs">
        <button
          type="button"
          id="tab-text"
          class="px-5 py-1.5 rounded-lg text-xs font-semibold bg-[#171717] dark:bg-[#ededed] text-white dark:text-[#171717] transition-all"
        >
          Text Converter
        </button>
        <button
          type="button"
          id="tab-image"
          class="px-5 py-1.5 rounded-lg text-xs font-semibold text-[#666666] dark:text-[#888888] hover:text-[#171717] dark:hover:text-[#ededed] transition-all"
        >
          Image to Base64
        </button>
      </div>
    </div>

    <!-- TEXT MODE -->
    <div id="section-text-mode" class="space-y-6">
      <!-- Encode/Decode Action Bar -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-mode-encode"
            class="px-4 py-1.5 rounded-full text-xs font-semibold bg-[#0070f3] text-white"
          >
            Encode Text
          </button>
          <button
            type="button"
            id="btn-mode-decode"
            class="px-4 py-1.5 rounded-full text-xs font-semibold border border-[#ebebeb] dark:border-[#262626] text-[#666666] dark:text-[#888888] hover:border-[#0070f3] hover:text-[#0070f3]"
          >
            Decode Base64
          </button>
        </div>
        <button
          type="button"
          id="btn-swap-text"
          class="inline-flex items-center gap-1.5 text-xs text-[#666666] dark:text-[#888888] hover:text-[#0070f3]"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
          Swap Input / Output
        </button>
      </div>

      <!-- Side-by-side or stacked textareas -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Input Box -->
        <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] p-4 shadow-2xs flex flex-col">
          <div class="flex items-center justify-between mb-2">
            <label class="text-xs font-semibold uppercase tracking-wider text-[#666666] dark:text-[#888888]" id="input-heading">
              Plain Text Input
            </label>
            <span class="text-[11px] font-mono text-[#888888]" id="input-stats">0 bytes</span>
          </div>
          <textarea
            id="text-input"
            rows="8"
            placeholder="Type or paste text here to encode..."
            class="w-full flex-1 p-3 rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] font-mono text-xs text-[#171717] dark:text-[#ededed] resize-none focus:outline-none focus:border-[#0070f3]"
          ></textarea>
        </div>

        <!-- Output Box -->
        <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] p-4 shadow-2xs flex flex-col">
          <div class="flex items-center justify-between mb-2">
            <label class="text-xs font-semibold uppercase tracking-wider text-[#666666] dark:text-[#888888]" id="output-heading">
              Base64 Result
            </label>
            <div class="flex items-center gap-2">
              <span class="text-[11px] font-mono text-[#888888]" id="output-stats">0 bytes</span>
              <button
                type="button"
                id="btn-copy-output"
                class="px-2.5 py-1 rounded text-[11px] font-medium bg-[#f0f0f0] dark:bg-[#202020] hover:bg-[#0070f3] hover:text-white transition-colors"
              >
                Copy
              </button>
            </div>
          </div>
          <textarea
            id="text-output"
            rows="8"
            readonly
            placeholder="Result will appear automatically..."
            class="w-full flex-1 p-3 rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] font-mono text-xs text-[#171717] dark:text-[#ededed] resize-none focus:outline-none"
          ></textarea>
        </div>
      </div>
    </div>

    <!-- IMAGE MODE -->
    <div id="section-image-mode" class="hidden space-y-6">
      <div
        id="image-dropzone"
        class="border-2 border-dashed border-[#ebebeb] dark:border-[#262626] hover:border-[#0070f3] rounded-2xl p-8 text-center transition-all bg-white dark:bg-[#0a0a0a] cursor-pointer shadow-2xs group"
      >
        <input type="file" id="image-file-input" accept="image/*" class="hidden" />
        <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-[#0070f3]/10 text-[#0070f3] flex items-center justify-center transition-transform group-hover:scale-105">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div class="text-sm font-semibold text-[#171717] dark:text-[#ededed] mb-1">
          Select or drop an image to convert to Base64
        </div>
        <p class="text-xs text-[#666666] dark:text-[#888888]">Supports PNG, JPG, WebP, SVG, GIF &amp; ICO</p>
      </div>

      <!-- Image Result Card -->
      <div id="image-result-card" class="hidden rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] p-5 shadow-2xs space-y-4">
        <div class="flex items-center gap-4 pb-4 border-b border-[#ebebeb] dark:border-[#262626]">
          <img id="img-preview-thumb" src="" alt="Preview" class="w-16 h-16 object-contain rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212]" />
          <div>
            <div class="font-medium text-xs text-[#171717] dark:text-[#ededed]" id="img-meta-name">image.png</div>
            <div class="text-[11px] text-[#888888] font-mono mt-0.5">
              Original: <span id="img-meta-orig">0 KB</span> &bull; Base64: <span id="img-meta-b64">0 KB</span>
            </div>
          </div>
        </div>

        <!-- Copy Quick Buttons -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <button
            type="button"
            id="btn-copy-datauri"
            class="py-2 px-3 rounded-lg border border-[#ebebeb] dark:border-[#262626] hover:border-[#0070f3] text-xs font-medium text-[#171717] dark:text-[#ededed] transition-colors text-center"
          >
            Copy Data URI
          </button>
          <button
            type="button"
            id="btn-copy-rawb64"
            class="py-2 px-3 rounded-lg border border-[#ebebeb] dark:border-[#262626] hover:border-[#0070f3] text-xs font-medium text-[#171717] dark:text-[#ededed] transition-colors text-center"
          >
            Copy Raw Base64
          </button>
          <button
            type="button"
            id="btn-copy-htmltag"
            class="py-2 px-3 rounded-lg border border-[#ebebeb] dark:border-[#262626] hover:border-[#0070f3] text-xs font-medium text-[#171717] dark:text-[#ededed] transition-colors text-center"
          >
            Copy &lt;img&gt; Tag
          </button>
          <button
            type="button"
            id="btn-copy-cssbg"
            class="py-2 px-3 rounded-lg border border-[#ebebeb] dark:border-[#262626] hover:border-[#0070f3] text-xs font-medium text-[#171717] dark:text-[#ededed] transition-colors text-center"
          >
            Copy CSS Background
          </button>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#666666] dark:text-[#888888] uppercase tracking-wider mb-1">
            Data URI Output
          </label>
          <textarea
            id="image-datauri-output"
            rows="5"
            readonly
            class="w-full p-3 rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] font-mono text-xs text-[#171717] dark:text-[#ededed] resize-none"
          ></textarea>
        </div>
      </div>
    </div>

    <!-- Authority Guide, Matrix, Portal Errors, FAQs, and Related Utilities -->
    <ToolAuthoritySection
      toolName="Base64 Encoder & Decoder"
      category="developer"
      currentToolId="base64-converter"
      guidelinesHeading="Understanding Base64 Encoding & Data URI Architecture"
      guidelinesIntro="Base64 converts binary streams into ASCII strings using a 64-character alphabet. It is extensively used to embed images directly into HTML/CSS without external HTTP network requests and to transport binary payloads across REST APIs. Our tool uses standard Web APIs to handle full UTF-8 Unicode characters without encoding crashes."
    />
  </main>
</Layout>

<script>
  // Tabs
  const tabText = document.getElementById('tab-text');
  const tabImage = document.getElementById('tab-image');
  const secText = document.getElementById('section-text-mode');
  const secImage = document.getElementById('section-image-mode');

  tabText?.addEventListener('click', () => {
    tabText.className = 'px-5 py-1.5 rounded-lg text-xs font-semibold bg-[#171717] dark:bg-[#ededed] text-white dark:text-[#171717] transition-all';
    tabImage!.className = 'px-5 py-1.5 rounded-lg text-xs font-semibold text-[#666666] dark:text-[#888888] hover:text-[#171717] dark:hover:text-[#ededed] transition-all';
    secText?.classList.remove('hidden');
    secImage?.classList.add('hidden');
  });

  tabImage?.addEventListener('click', () => {
    tabImage.className = 'px-5 py-1.5 rounded-lg text-xs font-semibold bg-[#171717] dark:bg-[#ededed] text-white dark:text-[#171717] transition-all';
    tabText!.className = 'px-5 py-1.5 rounded-lg text-xs font-semibold text-[#666666] dark:text-[#888888] hover:text-[#171717] dark:hover:text-[#ededed] transition-all';
    secImage?.classList.remove('hidden');
    secText?.classList.add('hidden');
  });

  // TEXT CONVERSION LOGIC
  let mode: 'encode' | 'decode' = 'encode';
  const textInput = document.getElementById('text-input') as HTMLTextAreaElement;
  const textOutput = document.getElementById('text-output') as HTMLTextAreaElement;
  const inputHeading = document.getElementById('input-heading');
  const outputHeading = document.getElementById('output-heading');
  const inputStats = document.getElementById('input-stats');
  const outputStats = document.getElementById('output-stats');
  const btnEncode = document.getElementById('btn-mode-encode');
  const btnDecode = document.getElementById('btn-mode-decode');
  const btnSwap = document.getElementById('btn-swap-text');
  const btnCopy = document.getElementById('btn-copy-output');

  // Unicode safe base64 encode
  function utf8ToBase64(str: string): string {
    const bytes = new TextEncoder().encode(str);
    const binString = Array.from(bytes, (b) => String.fromCharCode(b)).join('');
    return btoa(binString);
  }

  // Unicode safe base64 decode
  function base64ToUtf8(b64: string): string {
    const cleaned = b64.trim().replace(/\s+/g, '');
    const binString = atob(cleaned);
    const bytes = Uint8Array.from(binString, (m) => m.charCodeAt(0));
    return new TextDecoder().decode(bytes);
  }

  function processText() {
    const val = textInput?.value || '';
    if (inputStats) inputStats.textContent = `${new TextEncoder().encode(val).length} bytes`;

    if (!val) {
      if (textOutput) textOutput.value = '';
      if (outputStats) outputStats.textContent = '0 bytes';
      return;
    }

    try {
      if (mode === 'encode') {
        const encoded = utf8ToBase64(val);
        textOutput.value = encoded;
        if (outputStats) outputStats.textContent = `${encoded.length} bytes`;
      } else {
        const decoded = base64ToUtf8(val);
        textOutput.value = decoded;
        if (outputStats) outputStats.textContent = `${new TextEncoder().encode(decoded).length} bytes`;
      }
    } catch {
      textOutput.value = 'Invalid Base64 string for decoding.';
      if (outputStats) outputStats.textContent = 'Error';
    }
  }

  textInput?.addEventListener('input', processText);

  btnEncode?.addEventListener('click', () => {
    mode = 'encode';
    btnEncode.className = 'px-4 py-1.5 rounded-full text-xs font-semibold bg-[#0070f3] text-white';
    btnDecode!.className = 'px-4 py-1.5 rounded-full text-xs font-semibold border border-[#ebebeb] dark:border-[#262626] text-[#666666] dark:text-[#888888] hover:border-[#0070f3] hover:text-[#0070f3]';
    if (inputHeading) inputHeading.textContent = 'Plain Text Input';
    if (outputHeading) outputHeading.textContent = 'Base64 Result';
    processText();
  });

  btnDecode?.addEventListener('click', () => {
    mode = 'decode';
    btnDecode.className = 'px-4 py-1.5 rounded-full text-xs font-semibold bg-[#0070f3] text-white';
    btnEncode!.className = 'px-4 py-1.5 rounded-full text-xs font-semibold border border-[#ebebeb] dark:border-[#262626] text-[#666666] dark:text-[#888888] hover:border-[#0070f3] hover:text-[#0070f3]';
    if (inputHeading) inputHeading.textContent = 'Base64 Input';
    if (outputHeading) outputHeading.textContent = 'Decoded Plain Text';
    processText();
  });

  btnSwap?.addEventListener('click', () => {
    const temp = textOutput.value;
    textInput.value = temp;
    mode = mode === 'encode' ? 'decode' : 'encode';
    if (mode === 'encode') {
      btnEncode?.click();
    } else {
      btnDecode?.click();
    }
  });

  btnCopy?.addEventListener('click', () => {
    if (!textOutput.value) return;
    navigator.clipboard.writeText(textOutput.value);
    const orig = btnCopy.textContent;
    btnCopy.textContent = 'Copied!';
    setTimeout(() => { btnCopy.textContent = orig; }, 1500);
  });

  // IMAGE MODE LOGIC
  const imgDropzone = document.getElementById('image-dropzone');
  const imgFileInput = document.getElementById('image-file-input') as HTMLInputElement;
  const imgCard = document.getElementById('image-result-card');
  const imgThumb = document.getElementById('img-preview-thumb') as HTMLImageElement;
  const imgName = document.getElementById('img-meta-name');
  const imgOrig = document.getElementById('img-meta-orig');
  const imgB64 = document.getElementById('img-meta-b64');
  const imgDataUriOutput = document.getElementById('image-datauri-output') as HTMLTextAreaElement;

  let currentDataUri = '';
  let currentRawBase64 = '';

  imgDropzone?.addEventListener('click', () => imgFileInput?.click());

  imgFileInput?.addEventListener('change', () => {
    if (imgFileInput.files?.[0]) {
      handleImage(imgFileInput.files[0]);
    }
  });

  function handleImage(file: File) {
    const reader = new FileReader();
    reader.onload = () => {
      currentDataUri = reader.result as string;
      currentRawBase64 = currentDataUri.split(',')[1] || '';

      if (imgThumb) imgThumb.src = currentDataUri;
      if (imgName) imgName.textContent = file.name;
      if (imgOrig) imgOrig.textContent = (file.size / 1024).toFixed(1) + ' KB';
      if (imgB64) imgB64.textContent = (currentDataUri.length / 1024).toFixed(1) + ' KB';
      if (imgDataUriOutput) imgDataUriOutput.value = currentDataUri;

      imgCard?.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
  }

  document.getElementById('btn-copy-datauri')?.addEventListener('click', (e) => {
    navigator.clipboard.writeText(currentDataUri);
    showCopied(e.currentTarget as HTMLElement, 'Data URI Copied!');
  });

  document.getElementById('btn-copy-rawb64')?.addEventListener('click', (e) => {
    navigator.clipboard.writeText(currentRawBase64);
    showCopied(e.currentTarget as HTMLElement, 'Raw Base64 Copied!');
  });

  document.getElementById('btn-copy-htmltag')?.addEventListener('click', (e) => {
    navigator.clipboard.writeText(`<img src="${currentDataUri}" alt="Embedded Image" />`);
    showCopied(e.currentTarget as HTMLElement, 'HTML Tag Copied!');
  });

  document.getElementById('btn-copy-cssbg')?.addEventListener('click', (e) => {
    navigator.clipboard.writeText(`background-image: url("${currentDataUri}");`);
    showCopied(e.currentTarget as HTMLElement, 'CSS Rule Copied!');
  });

  function showCopied(el: HTMLElement, text: string) {
    const orig = el.textContent;
    el.textContent = text;
    setTimeout(() => { el.textContent = orig; }, 1500);
  }
</script>
