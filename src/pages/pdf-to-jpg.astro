---
import Layout from '../layouts/Layout.astro';
import ToolAuthoritySection from '../components/ToolAuthoritySection.astro';

const pageTitle = "PDF to JPG Converter – Convert PDF Pages to Images 100% Free & Private";
const pageDescription = "Convert PDF documents into high-resolution JPG or PNG images directly in your browser. 100% free, private client-side conversion with zero file uploads.";
const pageKeywords = "pdf to jpg, convert pdf to jpg, pdf to image converter, pdf to png, extract images from pdf, free pdf to jpg online, pdf to jpg high quality";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Free In-Browser PDF to JPG Converter",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": pageDescription,
      "url": "https://cleanwordcounter.com/pdf-to-jpg/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I convert a multi-page PDF into JPG images?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Upload your PDF file, choose your preferred format (JPG or PNG) and image quality (150 DPI or 300 DPI), and your browser will render each page into a downloadable image instantly."
          }
        },
        {
          "@type": "Question",
          "name": "Is it safe to convert private contracts and bank statements?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Our converter uses Mozilla's PDF.js engine running completely client-side in your browser's local memory. Your documents are never uploaded to any remote server."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalSlug="pdf-to-jpg"
  schema={schema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 pb-2 text-center">
    <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] px-3.5 py-1 text-[#0070f3] shadow-2xs mb-3">
      <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
      <span>Mozilla PDF.js Engine &bull; 100% In-Browser Privacy</span>
    </div>
    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
      PDF to <span class="vercel-gradient-develop">JPG Converter</span>
    </h1>
    <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
      Convert PDF document pages into crisp, high-resolution <strong class="font-mono text-[#0070f3]">JPG</strong> or <strong class="font-mono text-[#0070f3]">PNG</strong> images. Zero file uploads, zero server latency.
    </p>
  </div>

  <main class="mx-auto max-w-7xl px-4 sm:px-6 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Options Toolbar -->
      <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] p-4 sm:p-5 shadow-2xs mb-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4 w-full sm:w-auto">
          <div>
            <label class="block text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5">
              Output Format
            </label>
            <div class="flex items-center gap-2" id="pdf-format-toggles">
              <button type="button" data-fmt="jpeg" class="pdf-fmt-btn px-3 py-1.5 rounded-lg text-xs font-medium border border-[#ebebeb] dark:border-[#262626] bg-[#171717] dark:bg-white text-white dark:text-[#171717]">
                JPG / JPEG
              </button>
              <button type="button" data-fmt="png" class="pdf-fmt-btn px-3 py-1.5 rounded-lg text-xs font-medium border border-[#ebebeb] dark:border-[#262626] text-[#666666] dark:text-[#888888] hover:border-[#0070f3] hover:text-[#0070f3]">
                PNG (Lossless)
              </button>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-4 w-full sm:w-auto justify-end">
          <div>
            <label class="block text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5">
              Render DPI / Quality
            </label>
            <select id="pdf-dpi-select" class="rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] px-3 py-1.5 text-xs font-medium text-[#171717] dark:text-[#ededed] focus:border-[#0070f3] focus:outline-none">
              <option value="1.5">150 DPI (Fast &amp; Crisp)</option>
              <option value="2.0" selected>300 DPI (High Resolution Print)</option>
              <option value="3.0">450 DPI (Ultra Sharp)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Dropzone -->
      <div
        id="pdf-to-jpg-dropzone"
        class="relative cursor-pointer rounded-2xl border-2 border-dashed border-[#d1d5db] dark:border-[#333333] hover:border-[#0070f3] dark:hover:border-[#0070f3] bg-white dark:bg-[#0a0a0a] transition-all p-8 sm:p-12 text-center group"
      >
        <input type="file" id="pdf-to-jpg-file-input" accept="application/pdf" class="hidden" />
        
        <div class="flex flex-col items-center justify-center pointer-events-none">
          <div class="w-14 h-14 rounded-full bg-[#f4f4f5] dark:bg-[#1a1a1a] flex items-center justify-center text-[#0070f3] mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>

          <h3 class="text-base sm:text-lg font-semibold text-[#171717] dark:text-[#ededed]">
            Click or drag &amp; drop your PDF here to convert to JPG
          </h3>
          <p class="mt-1 text-xs text-[#666666] dark:text-[#888888]">
            Renders every page into high-resolution JPG or PNG images &bull; Works offline
          </p>

          <div class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-[#f4f4f5] dark:bg-[#171717] px-3 py-1 text-[11px] font-medium text-[#666666] dark:text-[#a1a1a1]">
            <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>100% In-Browser Privacy &bull; Zero Server Latency</span>
          </div>
        </div>
      </div>

      <!-- Processing State -->
      <div id="pdf-processing" class="hidden my-8 text-center py-10">
        <div class="inline-block animate-spin rounded-full h-9 w-9 border-2 border-[#ebebeb] dark:border-[#333] border-t-[#0070f3] mb-3"></div>
        <p class="text-sm font-medium text-[#171717] dark:text-[#ededed]" id="pdf-processing-status">
          Decoding PDF pages in GPU memory...
        </p>
        <p class="text-xs text-[#888888] font-mono mt-1" id="pdf-processing-page">Page 1 of ...</p>
      </div>

      <!-- Results Gallery -->
      <div id="pdf-results-view" class="hidden mt-8 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] shadow-2xs">
          <div>
            <h3 class="text-sm font-semibold text-[#171717] dark:text-[#ededed]" id="pdf-out-header">
              Rendered Pages (0)
            </h3>
            <p class="text-[11px] text-[#888888]" id="pdf-out-filename">
              document.pdf
            </p>
          </div>

          <div class="flex items-center gap-3">
            <button
              type="button"
              id="pdf-reset-btn"
              class="px-3.5 py-2 rounded-lg border border-[#ebebeb] dark:border-[#262626] text-xs font-medium text-[#666666] dark:text-[#888888] hover:bg-[#fafafa]"
            >
              Upload Another
            </button>
            <button
              type="button"
              id="pdf-download-all-btn"
              class="flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-xs font-semibold hover:bg-black dark:hover:bg-[#f0f0f0] shadow-sm"
            >
              <svg class="w-4 h-4 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Download All Pages</span>
            </button>
          </div>
        </div>

        <div id="pdf-pages-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4"></div>
      </div>
    </div>

    <!-- Authority Guide, Matrix, Portal Errors, FAQs, and Related Utilities -->
    <ToolAuthoritySection
      toolName="PDF to JPG Converter"
      category="image"
      currentToolId="pdf-to-jpg"
      guidelinesHeading="Understanding PDF to Image Rasterization & Portal Standards"
      guidelinesIntro="Many application gateways, recruitment forms, and identity verifiers require single image files (JPG or PNG) rather than PDF documents. Our client-side rasterizer decodes PDF vectors at standard 300 DPI print quality directly in browser GPU memory, extracting pages with crisp contrast and zero server uploads."
    />
  </main>
</Layout>

<script>
  let outputFormat = 'jpeg';
  let renderedPages: { pageNum: number; url: string; filename: string }[] = [];

  const dropzone = document.getElementById('pdf-to-jpg-dropzone')!;
  const fileInput = document.getElementById('pdf-to-jpg-file-input') as HTMLInputElement;
  const processingView = document.getElementById('pdf-processing')!;
  const processingPage = document.getElementById('pdf-processing-page')!;
  const resultsView = document.getElementById('pdf-results-view')!;
  const pagesGrid = document.getElementById('pdf-pages-grid')!;
  const outHeader = document.getElementById('pdf-out-header')!;
  const outFilename = document.getElementById('pdf-out-filename')!;
  const resetBtn = document.getElementById('pdf-reset-btn')!;
  const downloadAllBtn = document.getElementById('pdf-download-all-btn')!;
  const dpiSelect = document.getElementById('pdf-dpi-select') as HTMLSelectElement;
  const fmtButtons = document.querySelectorAll('.pdf-fmt-btn');

  fmtButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      outputFormat = btn.getAttribute('data-fmt')!;
      fmtButtons.forEach((b) => {
        b.classList.remove('bg-[#171717]', 'dark:bg-white', 'text-white', 'dark:text-[#171717]');
        b.classList.add('text-[#666666]', 'dark:text-[#888888]');
      });
      btn.classList.add('bg-[#171717]', 'dark:bg-white', 'text-white', 'dark:text-[#171717]');
      btn.classList.remove('text-[#666666]', 'dark:text-[#888888]');
    });
  });

  dropzone.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files[0]) processPdf(fileInput.files[0]);
  });

  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-[#0070f3]');
  });
  dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-[#0070f3]'));
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-[#0070f3]');
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
      processPdf(e.dataTransfer.files[0]);
    }
  });

  resetBtn.addEventListener('click', () => {
    renderedPages = [];
    pagesGrid.innerHTML = '';
    resultsView.classList.add('hidden');
    dropzone.classList.remove('hidden');
    fileInput.value = '';
  });

  downloadAllBtn.addEventListener('click', () => {
    renderedPages.forEach((p, idx) => {
      setTimeout(() => {
        const a = document.createElement('a');
        a.href = p.url;
        a.download = p.filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      }, idx * 250);
    });
  });

  async function processPdf(file: File) {
    if (!file.name.toLowerCase().endsWith('.pdf') && file.type !== 'application/pdf') {
      alert('Please upload a valid PDF document.');
      return;
    }

    dropzone.classList.add('hidden');
    resultsView.classList.add('hidden');
    processingView.classList.remove('hidden');
    renderedPages = [];
    pagesGrid.innerHTML = '';

    const baseName = file.name.replace(/\.pdf$/i, '') || 'document';
    outFilename.textContent = file.name;

    try {
      // Dynamic import of pdfjs-dist
      const pdfjsLib = await import('pdfjs-dist');
      pdfjsLib.GlobalWorkerOptions.workerSrc = '/pdf.worker.min.mjs';

      const arrayBuffer = await file.arrayBuffer();
      const loadingTask = pdfjsLib.getDocument({ data: arrayBuffer });
      const pdf = await loadingTask.promise;

      const numPages = pdf.numPages;
      const scale = parseFloat(dpiSelect.value) || 2.0;
      const mime = outputFormat === 'png' ? 'image/png' : 'image/jpeg';
      const ext = outputFormat === 'png' ? 'png' : 'jpg';

      for (let pageNum = 1; pageNum <= numPages; pageNum++) {
        processingPage.textContent = `Rendering page ${pageNum} of ${numPages}...`;

        const page = await pdf.getPage(pageNum);
        const viewport = page.getViewport({ scale });

        const canvas = document.createElement('canvas');
        canvas.width = viewport.width;
        canvas.height = viewport.height;
        const ctx = canvas.getContext('2d')!;

        // White background for transparent PDF elements
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        await page.render({ canvasContext: ctx, viewport }).promise;

        const blob = await new Promise<Blob>((res) => canvas.toBlob((b) => res(b!), mime, 0.92));
        const url = URL.createObjectURL(blob);
        const filename = `${baseName}-page-${pageNum}.${ext}`;

        renderedPages.push({ pageNum, url, filename });

        // Build thumbnail card
        const card = document.createElement('div');
        card.className = 'rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] p-3 shadow-2xs flex flex-col justify-between';
        card.innerHTML = `
          <div class="aspect-3/4 rounded-lg bg-[#fafafa] dark:bg-[#141414] overflow-hidden flex items-center justify-center mb-3 border border-[#ebebeb] dark:border-[#262626]">
            <img src="${url}" class="max-h-full max-w-full object-contain" alt="Page ${pageNum}" />
          </div>
          <div class="flex items-center justify-between pt-2 border-t border-[#ebebeb] dark:border-[#262626]">
            <div>
              <span class="block text-xs font-semibold text-[#171717] dark:text-[#ededed]">Page ${pageNum}</span>
              <span class="text-[10px] font-mono text-[#888888]">${viewport.width.toFixed(0)} × ${viewport.height.toFixed(0)} px</span>
            </div>
            <a href="${url}" download="${filename}" class="px-3 py-1.5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-xs font-semibold hover:bg-black dark:hover:bg-[#f0f0f0] flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Download</span>
            </a>
          </div>
        `;
        pagesGrid.appendChild(card);
      }

      outHeader.textContent = `Rendered ${renderedPages.length} Page${renderedPages.length === 1 ? '' : 's'}`;
      processingView.classList.add('hidden');
      resultsView.classList.remove('hidden');
    } catch (err: any) {
      alert(`Error rendering PDF: ${err.message}`);
      processingView.classList.add('hidden');
      dropzone.classList.remove('hidden');
    }
  }
</script>
