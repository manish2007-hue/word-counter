---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Resize Image in CM, MM, Inches & Pixels – Passport Photo Resizer";
const pageDescription = "Free online image resizer in cm, mm, inches and pixels. Preset sizes for passport photos (3.5x4.5cm), US Visa (2x2 in), SSC/UPSC, and social media with 300 DPI support. 100% private.";
const pageKeywords = "resize image in cm, resize photo 3.5 x 4.5 cm, passport photo resizer, resize image to 2x2 inches, resize image in mm, photo resizer 300 dpi, ssc photo signature resize";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Image Resizer in CM, MM, Inches & Pixels",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": pageDescription,
      "url": "https://cleanwordcounter.com/resize-image/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I resize a photo to 3.5 x 4.5 cm?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Select the 'Passport (3.5 x 4.5 cm)' preset or set Unit to CM with Width 3.5 and Height 4.5. At standard 300 DPI printing resolution, our tool automatically generates a sharp 413 x 531 px image."
          }
        },
        {
          "@type": "Question",
          "name": "How do I convert physical dimensions (cm/inches) to pixels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pixel dimensions depend on DPI (Dots Per Inch). At standard 300 DPI: Pixels = (Centimeters / 2.54) * 300. Our resizer handles all mathematics automatically."
          }
        }
      ]
    }
  ]
};

const presets = [
  { name: 'Passport (3.5 × 4.5 cm)', unit: 'cm', w: 3.5, h: 4.5, dpi: 300, desc: 'Official Indian & International Passport photo standard' },
  { name: 'US Visa (2 × 2 in)', unit: 'in', w: 2, h: 2, dpi: 300, desc: '600x600 px at 300 DPI for US DS-160 and visa portals' },
  { name: 'SSC / UPSC Photo', unit: 'px', w: 200, h: 230, dpi: 72, desc: '200x230 px standard for government examination registration' },
  { name: 'SSC / UPSC Sign', unit: 'px', w: 140, h: 60, dpi: 72, desc: '140x60 px signature dimensions for admit card submission' },
  { name: 'Instagram Square', unit: 'px', w: 1080, h: 1080, dpi: 72, desc: '1080x1080 px feed post aspect ratio 1:1' },
  { name: 'Story / Reel / Shorts', unit: 'px', w: 1080, h: 1920, dpi: 72, desc: '1080x1920 px vertical 9:16 format' }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalSlug="resize-image"
  schema={schema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 pb-2 text-center">
    <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] px-3.5 py-1 text-[#0070f3] shadow-2xs mb-3">
      <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
      <span>Physical Units &bull; CM &bull; MM &bull; Inches &bull; 300 DPI</span>
    </div>
    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
      Image Resizer &amp; <span class="vercel-gradient-develop">Passport Photo</span> Tool
    </h1>
    <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
      Resize images by exact physical dimensions (<strong class="font-mono text-[#0070f3]">cm</strong>, <strong class="font-mono text-[#0070f3]">mm</strong>, <strong class="font-mono text-[#0070f3]">inches</strong>, <strong class="font-mono text-[#0070f3]">px</strong>) with print-grade 300 DPI support. 100% private in-browser tool.
    </p>
  </div>

  <main class="mx-auto max-w-7xl px-4 sm:px-6 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Resizer Controls Header -->
      <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] p-4 sm:p-5 shadow-2xs mb-6">
        <!-- Quick Presets -->
        <div class="mb-4">
          <label class="block text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-2">
            Official Presets
          </label>
          <div class="flex flex-wrap items-center gap-2" id="preset-list">
            {presets.map((p) => (
              <button
                type="button"
                data-unit={p.unit}
                data-w={p.w}
                data-h={p.h}
                data-dpi={p.dpi}
                class="resize-preset-btn px-3 py-1.5 rounded-lg text-xs font-medium border border-[#ebebeb] dark:border-[#262626] text-[#666666] dark:text-[#888888] hover:border-[#0070f3] hover:text-[#0070f3] transition-colors"
              >
                {p.name}
              </button>
            ))}
          </div>
        </div>

        <!-- Custom Dimensions Form -->
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 pt-4 border-t border-[#ebebeb] dark:border-[#262626]">
          <div>
            <label class="block text-xs font-semibold text-[#666666] dark:text-[#888888] mb-1">Unit</label>
            <select id="unit-select" class="w-full rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] px-2.5 py-1.5 text-xs font-medium text-[#171717] dark:text-[#ededed] focus:border-[#0070f3] focus:outline-none">
              <option value="px">Pixels (px)</option>
              <option value="cm" selected>Centimeters (cm)</option>
              <option value="mm">Millimeters (mm)</option>
              <option value="in">Inches (in)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-[#666666] dark:text-[#888888] mb-1">Width</label>
            <input type="number" id="input-w" step="0.1" value="3.5" class="w-full rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] px-2.5 py-1.5 text-xs font-mono font-medium text-[#171717] dark:text-[#ededed] focus:border-[#0070f3] focus:outline-none" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-[#666666] dark:text-[#888888] mb-1">Height</label>
            <input type="number" id="input-h" step="0.1" value="4.5" class="w-full rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] px-2.5 py-1.5 text-xs font-mono font-medium text-[#171717] dark:text-[#ededed] focus:border-[#0070f3] focus:outline-none" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-[#666666] dark:text-[#888888] mb-1">Print DPI</label>
            <select id="dpi-select" class="w-full rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] px-2.5 py-1.5 text-xs font-medium text-[#171717] dark:text-[#ededed] focus:border-[#0070f3] focus:outline-none">
              <option value="300" selected>300 DPI (High Print)</option>
              <option value="150">150 DPI (Medium)</option>
              <option value="72">72 DPI (Web / Screen)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-[#666666] dark:text-[#888888] mb-1">Output Format</label>
            <select id="res-format-select" class="w-full rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] px-2.5 py-1.5 text-xs font-medium text-[#171717] dark:text-[#ededed] focus:border-[#0070f3] focus:outline-none">
              <option value="jpeg">JPG / JPEG</option>
              <option value="png">PNG</option>
              <option value="webp">WebP</option>
            </select>
          </div>
        </div>

        <div class="mt-3 flex items-center justify-between text-xs text-[#666666] dark:text-[#888888] pt-3 border-t border-[#ebebeb] dark:border-[#262626]">
          <label class="inline-flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="aspect-lock" class="rounded border-[#d1d5db] text-[#0070f3] focus:ring-[#0070f3]" />
            <span>Lock aspect ratio</span>
          </label>
          <div class="font-mono text-[11px] text-[#0070f3]" id="computed-px-display">
            Calculated: 413 × 531 px
          </div>
        </div>
      </div>

      <!-- Dropzone -->
      <div
        id="resize-dropzone"
        class="relative cursor-pointer rounded-2xl border-2 border-dashed border-[#d1d5db] dark:border-[#333333] hover:border-[#0070f3] dark:hover:border-[#0070f3] bg-white dark:bg-[#0a0a0a] transition-all p-8 sm:p-12 text-center group"
      >
        <input type="file" id="resize-file-input" accept="image/*" class="hidden" />
        
        <div class="flex flex-col items-center justify-center pointer-events-none">
          <div class="w-14 h-14 rounded-full bg-[#f4f4f5] dark:bg-[#1a1a1a] flex items-center justify-center text-[#0070f3] mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
            </svg>
          </div>

          <h3 class="text-base sm:text-lg font-semibold text-[#171717] dark:text-[#ededed]">
            Click to upload or drag &amp; drop photo to resize
          </h3>
          <p class="mt-1 text-xs text-[#666666] dark:text-[#888888]">
            Instant scaling in CM, MM, Inches or Pixels &bull; Or press <kbd class="px-1.5 py-0.5 rounded bg-[#f4f4f5] dark:bg-[#222] font-mono text-[10px] text-[#171717] dark:text-[#ededed]">Ctrl+V</kbd> to paste
          </p>
        </div>
      </div>

      <!-- Result View -->
      <div id="resize-result-view" class="hidden mt-8">
        <div class="rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] p-5 sm:p-7 shadow-2xs">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-6 border-b border-[#ebebeb] dark:border-[#262626]">
            <div>
              <span class="block text-[11px] uppercase tracking-wider font-semibold text-[#888888]">Resized Photo</span>
              <span id="resize-out-meta" class="text-base sm:text-lg font-bold font-mono text-[#171717] dark:text-[#ededed]">
                413 × 531 px &bull; 300 DPI
              </span>
            </div>

            <div class="flex items-center gap-3">
              <button
                type="button"
                id="resize-reset-btn"
                class="px-4 py-2.5 rounded-lg border border-[#ebebeb] dark:border-[#262626] text-xs font-medium text-[#666666] dark:text-[#888888] hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a]"
              >
                Upload Another
              </button>
              <a
                id="resize-download-link"
                download="resized-photo.jpg"
                href="#"
                class="flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-xs font-semibold hover:bg-black dark:hover:bg-[#f0f0f0] shadow-sm"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>Download Resized Image</span>
              </a>
            </div>
          </div>

          <div class="mt-6 flex flex-col items-center justify-center p-4 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212]">
            <img id="resize-preview-img" src="" alt="Resized Preview" class="max-h-96 max-w-full object-contain rounded-lg shadow-sm" />
          </div>
        </div>
      </div>
    </div>

    <!-- Reference Presets Guide -->
    <article class="mt-16 mx-auto max-w-4xl space-y-10">
      <section class="rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] p-6 sm:p-8">
        <h2 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] tracking-[-0.02em] mb-4">
          Standard Photo Dimensions Reference Guide
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-[#ebebeb] dark:border-[#262626] font-mono text-[#888888] uppercase">
              <tr>
                <th class="py-2.5 pr-4">Purpose / Document</th>
                <th class="py-2.5 px-4">Physical Size</th>
                <th class="py-2.5 px-4">Standard DPI</th>
                <th class="py-2.5 pl-4">Calculated Pixels</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#ebebeb] dark:divide-[#262626] text-[#4d4d4d] dark:text-[#a1a1a1]">
              <tr>
                <td class="py-3 pr-4 font-medium text-[#171717] dark:text-[#ededed]">Standard Passport Photo (India, Schengen, UK)</td>
                <td class="py-3 px-4 font-mono">3.5 × 4.5 cm (35 × 45 mm)</td>
                <td class="py-3 px-4 font-mono">300 DPI</td>
                <td class="py-3 pl-4 font-mono font-semibold text-[#0070f3]">413 × 531 px</td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-medium text-[#171717] dark:text-[#ededed]">US Visa / Passport (DS-160)</td>
                <td class="py-3 px-4 font-mono">2 × 2 inches (51 × 51 mm)</td>
                <td class="py-3 px-4 font-mono">300 DPI</td>
                <td class="py-3 pl-4 font-mono font-semibold text-[#0070f3]">600 × 600 px</td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-medium text-[#171717] dark:text-[#ededed]">PAN Card / Driving License</td>
                <td class="py-3 px-4 font-mono">2.5 × 3.5 cm (25 × 35 mm)</td>
                <td class="py-3 px-4 font-mono">300 DPI</td>
                <td class="py-3 pl-4 font-mono font-semibold text-[#0070f3]">295 × 413 px</td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-medium text-[#171717] dark:text-[#ededed]">UPSC / SSC Examination Photo</td>
                <td class="py-3 px-4 font-mono">Pixel specification</td>
                <td class="py-3 px-4 font-mono">72-150 DPI</td>
                <td class="py-3 pl-4 font-mono font-semibold text-[#0070f3]">200 × 230 px</td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-medium text-[#171717] dark:text-[#ededed]">UPSC / SSC Signature Upload</td>
                <td class="py-3 px-4 font-mono">Pixel specification</td>
                <td class="py-3 px-4 font-mono">72-150 DPI</td>
                <td class="py-3 pl-4 font-mono font-semibold text-[#0070f3]">140 × 60 px</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </article>
  </main>
</Layout>

<script>
  let currentFile: File | null = null;
  let naturalW = 0;
  let naturalH = 0;

  const dropzone = document.getElementById('resize-dropzone')!;
  const fileInput = document.getElementById('resize-file-input') as HTMLInputElement;
  const unitSelect = document.getElementById('unit-select') as HTMLSelectElement;
  const inputW = document.getElementById('input-w') as HTMLInputElement;
  const inputH = document.getElementById('input-h') as HTMLInputElement;
  const dpiSelect = document.getElementById('dpi-select') as HTMLSelectElement;
  const formatSelect = document.getElementById('res-format-select') as HTMLSelectElement;
  const aspectLock = document.getElementById('aspect-lock') as HTMLInputElement;
  const computedPxDisplay = document.getElementById('computed-px-display')!;
  const resultView = document.getElementById('resize-result-view')!;
  const previewImg = document.getElementById('resize-preview-img') as HTMLImageElement;
  const outMeta = document.getElementById('resize-out-meta')!;
  const downloadLink = document.getElementById('resize-download-link') as HTMLAnchorElement;
  const resetBtn = document.getElementById('resize-reset-btn')!;
  const presetBtns = document.querySelectorAll('.resize-preset-btn');

  function calculateTargetPixels(): { w: number; h: number } {
    const unit = unitSelect.value;
    const rawW = parseFloat(inputW.value) || 100;
    const rawH = parseFloat(inputH.value) || 100;
    const dpi = parseFloat(dpiSelect.value) || 300;

    let pxW = rawW;
    let pxH = rawH;

    if (unit === 'cm') {
      pxW = Math.round((rawW / 2.54) * dpi);
      pxH = Math.round((rawH / 2.54) * dpi);
    } else if (unit === 'mm') {
      pxW = Math.round((rawW / 25.4) * dpi);
      pxH = Math.round((rawH / 25.4) * dpi);
    } else if (unit === 'in') {
      pxW = Math.round(rawW * dpi);
      pxH = Math.round(rawH * dpi);
    } else {
      pxW = Math.round(rawW);
      pxH = Math.round(rawH);
    }

    return { w: Math.max(1, pxW), h: Math.max(1, pxH) };
  }

  function updatePixelDisplay() {
    const { w, h } = calculateTargetPixels();
    computedPxDisplay.textContent = `Calculated: ${w} × ${h} px (${dpiSelect.value} DPI)`;
  }

  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      unitSelect.value = btn.getAttribute('data-unit')!;
      inputW.value = btn.getAttribute('data-w')!;
      inputH.value = btn.getAttribute('data-h')!;
      dpiSelect.value = btn.getAttribute('data-dpi')!;
      updatePixelDisplay();
      if (currentFile) renderResized();
    });
  });

  unitSelect.addEventListener('change', () => {
    updatePixelDisplay();
    if (currentFile) renderResized();
  });

  inputW.addEventListener('input', () => {
    if (aspectLock.checked && naturalW && naturalH) {
      const curW = parseFloat(inputW.value);
      if (curW) {
        inputH.value = ((curW * naturalH) / naturalW).toFixed(2);
      }
    }
    updatePixelDisplay();
    if (currentFile) renderResized();
  });

  inputH.addEventListener('input', () => {
    if (aspectLock.checked && naturalW && naturalH) {
      const curH = parseFloat(inputH.value);
      if (curH) {
        inputW.value = ((curH * naturalW) / naturalH).toFixed(2);
      }
    }
    updatePixelDisplay();
    if (currentFile) renderResized();
  });

  dpiSelect.addEventListener('change', () => {
    updatePixelDisplay();
    if (currentFile) renderResized();
  });

  formatSelect.addEventListener('change', () => {
    if (currentFile) renderResized();
  });

  dropzone.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files[0]) {
      handleSelected(fileInput.files[0]);
    }
  });

  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-[#0070f3]');
  });

  dropzone.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-[#0070f3]');
  });

  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-[#0070f3]');
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
      handleSelected(e.dataTransfer.files[0]);
    }
  });

  window.addEventListener('paste', (e: ClipboardEvent) => {
    if (e.clipboardData && e.clipboardData.files && e.clipboardData.files.length > 0) {
      const item = e.clipboardData.files[0];
      if (item.type.startsWith('image/')) handleSelected(item);
    }
  });

  resetBtn.addEventListener('click', () => {
    currentFile = null;
    resultView.classList.add('hidden');
    dropzone.classList.remove('hidden');
  });

  async function handleSelected(file: File) {
    currentFile = file;
    const url = URL.createObjectURL(file);
    const img = new Image();
    await new Promise((res, rej) => {
      img.onload = res;
      img.onerror = rej;
      img.src = url;
    });
    naturalW = img.naturalWidth;
    naturalH = img.naturalHeight;
    renderResized();
  }

  async function renderResized() {
    if (!currentFile) return;

    const { w, h } = calculateTargetPixels();
    const mime = formatSelect.value === 'png' ? 'image/png' : formatSelect.value === 'webp' ? 'image/webp' : 'image/jpeg';
    const ext = formatSelect.value === 'png' ? 'png' : formatSelect.value === 'webp' ? 'webp' : 'jpg';

    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d')!;

    if (mime === 'image/jpeg') {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, w, h);
    }

    const url = URL.createObjectURL(currentFile);
    const img = new Image();
    await new Promise((res) => {
      img.onload = res;
      img.src = url;
    });

    // High quality bicubic-like downsampling
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(img, 0, 0, w, h);

    const blob = await new Promise<Blob>((res) => canvas.toBlob((b) => res(b!), mime, 0.95));
    const outUrl = URL.createObjectURL(blob);

    previewImg.src = outUrl;
    outMeta.textContent = `${w} × ${h} px &bull; ${unitSelect.value.toUpperCase()} &bull; ${dpiSelect.value} DPI`;

    const baseName = currentFile.name.substring(0, currentFile.name.lastIndexOf('.')) || 'image';
    downloadLink.download = `${baseName}-${w}x${h}.${ext}`;
    downloadLink.href = outUrl;

    dropzone.classList.add('hidden');
    resultView.classList.remove('hidden');
  }

  updatePixelDisplay();
</script>
