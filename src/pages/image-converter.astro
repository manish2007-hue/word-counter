---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Image Converter – Convert PNG to JPG, WebP to PNG, JPG to WebP Free";
const pageDescription = "Convert images instantly between PNG, JPG, and WebP in your browser. 100% free, private batch image format converter with quality control and zero file uploads.";
const pageKeywords = "image converter, png to jpg, webp to png, jpg to webp, convert png to jpeg, batch image converter online, image format changer";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Free In-Browser Image Converter",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": pageDescription,
      "url": "https://cleanwordcounter.com/image-converter/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How to convert WebP to PNG or JPG?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Select 'PNG' or 'JPG' as your target format, drag and drop your WebP images, and click Download. Your browser instantly decodes the WebP format and re-encodes it."
          }
        },
        {
          "@type": "Question",
          "name": "Is my data uploaded when converting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Never. All image rendering and encoding occurs locally within your device memory via HTML5 Canvas. No files ever leave your machine."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalSlug="image-converter"
  schema={schema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 pb-2 text-center">
    <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] px-3.5 py-1 text-[#0070f3] shadow-2xs mb-3">
      <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
      <span>Batch Format Converter &bull; 100% Private</span>
    </div>
    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
      Image Format <span class="vercel-gradient-develop">Converter</span>
    </h1>
    <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
      Convert between <strong class="font-mono text-[#0070f3]">PNG</strong>, <strong class="font-mono text-[#0070f3]">JPG</strong>, and <strong class="font-mono text-[#0070f3]">WebP</strong> instantly in your browser. Batch conversion with quality slider.
    </p>
  </div>

  <main class="mx-auto max-w-7xl px-4 sm:px-6 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Conversion Settings Bar -->
      <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] p-4 sm:p-5 shadow-2xs mb-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4 w-full sm:w-auto">
          <div>
            <label class="block text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1">
              Convert To
            </label>
            <div class="flex items-center gap-2" id="format-toggles">
              <button type="button" data-fmt="jpeg" class="fmt-btn px-3 py-1.5 rounded-lg text-xs font-medium border border-[#ebebeb] dark:border-[#262626] bg-[#171717] dark:bg-white text-white dark:text-[#171717]">
                JPG / JPEG
              </button>
              <button type="button" data-fmt="png" class="fmt-btn px-3 py-1.5 rounded-lg text-xs font-medium border border-[#ebebeb] dark:border-[#262626] text-[#666666] dark:text-[#888888] hover:border-[#0070f3] hover:text-[#0070f3]">
                PNG
              </button>
              <button type="button" data-fmt="webp" class="fmt-btn px-3 py-1.5 rounded-lg text-xs font-medium border border-[#ebebeb] dark:border-[#262626] text-[#666666] dark:text-[#888888] hover:border-[#0070f3] hover:text-[#0070f3]">
                WebP
              </button>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-4 w-full sm:w-auto justify-end">
          <div class="w-40" id="quality-container">
            <div class="flex justify-between text-xs mb-1">
              <span class="font-medium text-[#666666] dark:text-[#888888]">Quality</span>
              <span id="quality-val" class="font-mono text-[#0070f3] font-semibold">90%</span>
            </div>
            <input type="range" id="quality-slider" min="10" max="100" value="90" class="w-full accent-[#0070f3]" />
          </div>
        </div>
      </div>

      <!-- Dropzone -->
      <div
        id="conv-dropzone"
        class="relative cursor-pointer rounded-2xl border-2 border-dashed border-[#d1d5db] dark:border-[#333333] hover:border-[#0070f3] dark:hover:border-[#0070f3] bg-white dark:bg-[#0a0a0a] transition-all p-8 sm:p-12 text-center group"
      >
        <input type="file" id="conv-file-input" multiple accept="image/*" class="hidden" />
        
        <div class="flex flex-col items-center justify-center pointer-events-none">
          <div class="w-14 h-14 rounded-full bg-[#f4f4f5] dark:bg-[#1a1a1a] flex items-center justify-center text-[#0070f3] mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
          </div>

          <h3 class="text-base sm:text-lg font-semibold text-[#171717] dark:text-[#ededed]">
            Drag &amp; drop images or click to select multiple files
          </h3>
          <p class="mt-1 text-xs text-[#666666] dark:text-[#888888]">
            Batch convert JPG, PNG, WebP, AVIF, BMP &bull; In-browser rendering
          </p>
        </div>
      </div>

      <!-- Converted Items List -->
      <div id="conv-list-container" class="hidden mt-8 space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-semibold text-[#171717] dark:text-[#ededed]" id="conv-count-header">
            Converted Files (0)
          </h3>
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="conv-clear-btn"
              class="px-3 py-1.5 rounded-lg border border-[#ebebeb] dark:border-[#262626] text-xs font-medium text-[#666666] dark:text-[#888888] hover:bg-[#fafafa]"
            >
              Clear All
            </button>
            <button
              type="button"
              id="conv-download-all-btn"
              class="px-4 py-1.5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-xs font-semibold hover:bg-black dark:hover:bg-[#f0f0f0]"
            >
              Download All
            </button>
          </div>
        </div>

        <div id="conv-items" class="space-y-3"></div>
      </div>
    </div>
  </main>
</Layout>

<script>
  let targetFormat = 'jpeg';
  let quality = 0.9;
  const convertedFiles: { name: string; url: string; ext: string }[] = [];

  const dropzone = document.getElementById('conv-dropzone')!;
  const fileInput = document.getElementById('conv-file-input') as HTMLInputElement;
  const fmtButtons = document.querySelectorAll('.fmt-btn');
  const qualitySlider = document.getElementById('quality-slider') as HTMLInputElement;
  const qualityVal = document.getElementById('quality-val')!;
  const listContainer = document.getElementById('conv-list-container')!;
  const itemsContainer = document.getElementById('conv-items')!;
  const countHeader = document.getElementById('conv-count-header')!;
  const clearBtn = document.getElementById('conv-clear-btn')!;
  const downloadAllBtn = document.getElementById('conv-download-all-btn')!;

  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }

  fmtButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      targetFormat = btn.getAttribute('data-fmt')!;
      fmtButtons.forEach((b) => {
        b.classList.remove('bg-[#171717]', 'dark:bg-white', 'text-white', 'dark:text-[#171717]');
        b.classList.add('text-[#666666]', 'dark:text-[#888888]');
      });
      btn.classList.add('bg-[#171717]', 'dark:bg-white', 'text-white', 'dark:text-[#171717]');
      btn.classList.remove('text-[#666666]', 'dark:text-[#888888]');

      const qContainer = document.getElementById('quality-container')!;
      if (targetFormat === 'png') {
        qContainer.classList.add('opacity-40', 'pointer-events-none');
      } else {
        qContainer.classList.remove('opacity-40', 'pointer-events-none');
      }
    });
  });

  qualitySlider.addEventListener('input', () => {
    quality = Number(qualitySlider.value) / 100;
    qualityVal.textContent = `${qualitySlider.value}%`;
  });

  dropzone.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    if (fileInput.files) handleFiles(fileInput.files);
  });

  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-[#0070f3]');
  });
  dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-[#0070f3]'));
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-[#0070f3]');
    if (e.dataTransfer && e.dataTransfer.files) handleFiles(e.dataTransfer.files);
  });

  clearBtn.addEventListener('click', () => {
    convertedFiles.length = 0;
    itemsContainer.innerHTML = '';
    listContainer.classList.add('hidden');
    fileInput.value = '';
  });

  downloadAllBtn.addEventListener('click', () => {
    convertedFiles.forEach((f, idx) => {
      setTimeout(() => {
        const a = document.createElement('a');
        a.href = f.url;
        a.download = f.name;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      }, idx * 250);
    });
  });

  async function handleFiles(files: FileList) {
    listContainer.classList.remove('hidden');

    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      if (!file.type.startsWith('image/')) continue;
      await convertFile(file);
    }
  }

  async function convertFile(file: File) {
    const origUrl = URL.createObjectURL(file);
    const img = new Image();
    await new Promise((res) => {
      img.onload = res;
      img.src = origUrl;
    });

    const canvas = document.createElement('canvas');
    canvas.width = img.naturalWidth;
    canvas.height = img.naturalHeight;
    const ctx = canvas.getContext('2d')!;

    const mime = targetFormat === 'png' ? 'image/png' : targetFormat === 'webp' ? 'image/webp' : 'image/jpeg';
    const ext = targetFormat === 'png' ? 'png' : targetFormat === 'webp' ? 'webp' : 'jpg';

    if (mime === 'image/jpeg') {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
    ctx.drawImage(img, 0, 0);

    const blob = await new Promise<Blob>((res) => canvas.toBlob((b) => res(b!), mime, quality));
    const outUrl = URL.createObjectURL(blob);

    const base = file.name.substring(0, file.name.lastIndexOf('.')) || 'image';
    const finalName = `${base}.${ext}`;

    convertedFiles.push({ name: finalName, url: outUrl, ext });
    countHeader.textContent = `Converted Files (${convertedFiles.length})`;

    // Append card
    const row = document.createElement('div');
    row.className = 'flex items-center justify-between p-3.5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] shadow-2xs';
    row.innerHTML = `
      <div class="flex items-center gap-3">
        <img src="${outUrl}" class="w-12 h-12 object-cover rounded-lg border border-[#ebebeb] dark:border-[#262626]" />
        <div>
          <span class="block text-xs font-semibold text-[#171717] dark:text-[#ededed] truncate max-w-xs">${finalName}</span>
          <span class="text-[11px] font-mono text-[#888888]">${formatBytes(file.size)} &rarr; <strong class="text-[#0070f3]">${formatBytes(blob.size)}</strong></span>
        </div>
      </div>
      <a href="${outUrl}" download="${finalName}" class="px-4 py-1.5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-xs font-semibold hover:bg-black dark:hover:bg-[#f0f0f0] flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Download
      </a>
    `;
    itemsContainer.prepend(row);
  }
</script>
