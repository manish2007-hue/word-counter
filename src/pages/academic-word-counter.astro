---
import Layout from '../layouts/Layout.astro';
import WordCounter from '../components/WordCounter.astro';
import ToolAuthoritySection from '../components/ToolAuthoritySection.astro';

const pageTitle = "Academic Word Counter – Exclude APA & MLA Citations";
const pageDescription = "Calculate your true net essay word count. Automatically excludes APA, MLA, Harvard citations & end references from limits. 100% private college essay tool!";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do references and bibliographies count towards essay word limits?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "At nearly all universities and academic journals, references, bibliographies, and works cited lists are explicitly excluded from the required word limit. CleanWordCounter automatically removes this section when Academic Mode is enabled."
      }
    },
    {
      "@type": "Question",
      "name": "Do in-text citations count in university essays?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most university assessment guidelines (including APA, MLA, and Chicago styles) state that parenthetical author-year citations such as (Smith, 2024) or numbered brackets like [1-3] should not count toward student penalty limits. CleanWordCounter isolates these citations to give you your net body word count."
      }
    },
    {
      "@type": "Question",
      "name": "What is the standard penalty for exceeding word limits on academic papers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most universities enforce a 10% tolerance rule (+/- 10%). Exceeding the upper limit beyond 10% often results in a grade deduction (commonly 5 to 10 marks), or examiners simply stop reading past the word limit."
      }
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalSlug="academic-word-counter"
  schema={faqSchema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-8 pb-4 text-center">
    <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] px-3.5 py-1 text-[#0070f3] shadow-2xs mb-4">
      <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
      <span>Academic Citation Exclusion Engine</span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
      Academic Word Counter — <span class="vercel-gradient-develop">Exclude Citations</span>
    </h1>
    <p class="mt-3 text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
      The precision word counter built for research students that automatically isolates and subtracts bibliographies, references, and parenthetical citations from your paper's net word count.
    </p>
  </div>

  <WordCounter initialTab="academic" showHeroCopy={false} />

  <!-- Below the fold Educational Guide -->
  <section class="border-t border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#000000] py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 space-y-12">
      
      <div class="vercel-card p-6 sm:p-10">
        <div class="mono-eyebrow text-[#0070f3] mb-2">University Assessment Norms</div>
        <h2 class="text-2xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed] mb-4">
          What Counts in Academic Word Limits?
        </h2>
        <div class="overflow-x-auto rounded-[8px] border border-[#ebebeb] dark:border-[#222222]">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-[#fafafa] dark:bg-[#0e0e0e] text-[#8f8f8f] font-mono border-b border-[#ebebeb] dark:border-[#222222]">
              <tr>
                <th class="py-2.5 px-4 font-medium">ESSAY ELEMENT</th>
                <th class="py-2.5 px-4 font-medium text-center">TYPICALLY COUNTED?</th>
                <th class="py-2.5 px-4 font-medium">STANDARD REASONING</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#ebebeb] dark:divide-[#222222] text-[#4d4d4d] dark:text-[#a1a1a1]">
              <tr>
                <td class="py-2.5 px-4 font-semibold text-[#171717] dark:text-[#ededed]">Main Body Paragraphs</td>
                <td class="py-2.5 px-4 text-center font-bold text-[#0070f3]">YES</td>
                <td class="py-2.5 px-4">Core argumentative prose and analysis.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-semibold text-[#171717] dark:text-[#ededed]">In-Text Citations (e.g. Smith, 2024)</td>
                <td class="py-2.5 px-4 text-center font-bold text-[#ee0000]">EXCLUDED</td>
                <td class="py-2.5 px-4">Exempt in APA, MLA, and Harvard university guidelines.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-semibold text-[#171717] dark:text-[#ededed]">References & Works Cited</td>
                <td class="py-2.5 px-4 text-center font-bold text-[#ee0000]">EXCLUDED</td>
                <td class="py-2.5 px-4">End bibliographies are universally exempt from word counts.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-semibold text-[#171717] dark:text-[#ededed]">Direct Block Quotes</td>
                <td class="py-2.5 px-4 text-center font-bold text-[#0070f3]">YES</td>
                <td class="py-2.5 px-4">Counted towards your word limit in all standard grading rubrics.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-semibold text-[#171717] dark:text-[#ededed]">Title Page & Abstract</td>
                <td class="py-2.5 px-4 text-center font-bold text-[#ee0000]">EXCLUDED</td>
                <td class="py-2.5 px-4">Preliminary front matter is not part of the essay body.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </section>

  <!-- Authority Guide, Matrix, Portal Errors, FAQs, and Related Utilities -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-16">
    <ToolAuthoritySection
      toolName="Academic Essay Word Counter"
      category="writing"
      currentToolId="academic-word-counter"
      guidelinesHeading="Understanding Academic Essay Word Count Tolerances & Citation Rules"
      guidelinesIntro="Colleges, universities, and academic journals enforce strict ±10% word count tolerances. In-text citations (such as APA parenthetical references, MLA author-page markers, or Harvard format) artificially inflate your word count. Our academic counter filters citations to compute your true net essay body length."
    />
  </div>
</Layout>
