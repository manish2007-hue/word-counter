---
import Layout from '../../layouts/Layout.astro';
import WordCounter from '../../components/WordCounter.astro';
import ToolsDashboard from '../../components/ToolsDashboard.astro';
import { languages, type SupportedLang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { getLocalizedFAQs } from '../../i18n/faqs';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((l) => l !== 'en')
    .map((lang) => ({
      params: { lang },
    }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLang) || 'es';
const t = useTranslations(currentLang);

const pageTitle = t('meta.title');
const pageDescription = t('meta.description');
const pageKeywords = t('meta.keywords');

const faqs = getLocalizedFAQs(currentLang);

const baseOrigin = 'https://cleanwordcounter.com';
const currentCanonical = `${baseOrigin}/${currentLang}/`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

const localizedStructuredData = {
  "@context": "https://schema.org",
  "@type": ["WebApplication", "SoftwareApplication"],
  "name": "CleanWordCounter",
  "headline": pageTitle,
  "inLanguage": currentLang,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": pageDescription,
  "url": currentCanonical
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  lang={currentLang}
  canonicalSlug=""
  schema={localizedStructuredData}
>
  <!-- Schema.org FAQPage JSON-LD for International Search Engine Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema, null, 2)} />

  <!-- Interactive Localized Word Counter (Above the fold) -->
  <WordCounter showHeroCopy={true} />

  <!-- Interactive All-Tools Hub -->
  <section class="border-t border-[#ebebeb] dark:border-[#222222] bg-[#fdfdfd] dark:bg-[#070708] py-12 transition-colors duration-200">
    <ToolsDashboard
      headline={t('nav.tools')}
      subheadline={t('trust.title')}
      showHero={true}
    />
  </section>

  <!-- BELOW THE FOLD: SEO & AUTHORITY SECTIONS IN TARGET LANGUAGE -->
  <section class="border-t border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#1c1c1c] py-16 sm:py-20 transition-colors duration-200">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 space-y-12 sm:space-y-16">
      
      <!-- Section 1: Editorial Overview -->
      <div class="vercel-card p-6 sm:p-10 space-y-6">
        <div class="mono-eyebrow text-[#0070f3]">{t('seo.editorialTitle')}</div>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
          {t('seo.overviewHeading')}
        </h2>
        <div class="rounded-[8px] border border-[#0070f3]/25 bg-[#0070f3]/5 dark:bg-[#0070f3]/10 p-5 text-sm sm:text-base leading-relaxed text-[#171717] dark:text-[#ededed]">
          <p>{t('meta.description')}</p>
        </div>
        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          {t('seo.overviewBody')}
        </p>
      </div>

      <!-- Section 2: Localized FAQ Accordion -->
      <div class="vercel-card p-6 sm:p-10 space-y-8">
        <div>
          <div class="mono-eyebrow text-[#0070f3] mb-1">FAQ &amp; Guide</div>
          <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
            {t('seo.faqHeading')}
          </h2>
          <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] mt-1">
            {t('seo.faqSub')}
          </p>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <details class="group rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e] p-4 transition-colors open:bg-white dark:open:bg-[#141414]">
              <summary class="flex cursor-pointer items-center justify-between text-sm sm:text-base font-semibold text-[#171717] dark:text-[#ededed]">
                <span class="flex items-center gap-2">
                  <span class="font-mono text-xs text-[#0070f3]">Q{index + 1}.</span>
                  <span>{faq.question}</span>
                </span>
                <span class="ml-2 font-mono text-[#888888] transition-transform duration-200 group-open:rotate-180">▾</span>
              </summary>
              <div class="mt-3 pt-3 border-t border-[#ebebeb] dark:border-[#222222] text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
