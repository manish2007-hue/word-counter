---
import Layout from '../layouts/Layout.astro';
import WordCounter from '../components/WordCounter.astro';

const pageTitle = "Readability Score Checker — Flesch-Kincaid & Grade Level Calculator";
const pageDescription = "Free online readability checker. Calculate Flesch Reading Ease, Flesch-Kincaid Grade Level, Gunning Fog Index, and Coleman-Liau scores in real-time. 100% private.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a good Flesch Reading Ease score?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Flesch Reading Ease score between 60 and 70 is considered ideal for general consumer audiences and online blogs, translating to an 8th or 9th-grade reading level. Scores between 70 and 80 are fairly easy (7th grade), while scores below 50 reflect university-level or complex technical material."
      }
    },
    {
      "@type": "Question",
      "name": "How does Flesch-Kincaid Grade Level differ from Flesch Reading Ease?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "While both use the same core metrics (words per sentence and syllables per word), Flesch Reading Ease outputs a 0 to 100 scale where higher scores mean easier reading. Flesch-Kincaid Grade Level outputs a US school grade number (e.g. 8.2 = 8th grade), where lower numbers represent easier reading."
      }
    },
    {
      "@type": "Question",
      "name": "How can I improve my readability score?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To improve your score: 1) Shorten long sentences by breaking compound clauses into two sentences, 2) Swap multi-syllable Latinate jargon for concise everyday words (e.g. use 'help' instead of 'facilitate'), and 3) Write in active voice rather than passive voice."
      }
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalSlug="readability-checker"
  schema={faqSchema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-8 pb-4 text-center">
    <div class="inline-flex items-center gap-1.5 rounded-full border border-[#d2d2d7] dark:border-[#3a3a3c] bg-white dark:bg-[#1c1c1e] px-3.5 py-1 text-xs font-semibold text-[#0066cc] dark:text-[#2997ff] mb-4">
      📐 Multi-Formula Readability Analyzer
    </div>
    <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7]">
      Readability Score <span class="text-[#0066cc] dark:text-[#2997ff]">Checker</span>
    </h1>
    <p class="mt-3 text-sm sm:text-base text-[#86868b] max-w-2xl mx-auto leading-relaxed">
      Instantly evaluate text complexity across 4 industry-standard formulas: Flesch Reading Ease, Flesch-Kincaid, Gunning Fog, and Coleman-Liau.
    </p>
  </div>

  <WordCounter initialTab="readability" showHeroCopy={false} />

  <!-- Below the fold Educational Guide -->
  <section class="border-t border-[#e5e5e7] dark:border-[#2c2c2e] bg-[#f5f5f7] dark:bg-[#161617] py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 space-y-12">
      
      <div class="rounded-3xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white dark:bg-[#1c1c1e] p-6 sm:p-10 shadow-2xs">
        <h2 class="text-2xl font-bold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7] mb-6">
          Understanding the Readability Scoring Formulas
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
          
          <div class="rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e] p-5 bg-[#f5f5f7] dark:bg-[#161617]">
            <h3 class="font-bold text-[#1d1d1f] dark:text-[#f5f5f7] text-[15px]">Flesch Reading Ease (FRE)</h3>
            <p class="mt-1 text-[#515154] dark:text-[#86868b] leading-relaxed">
              Developed by Rudolf Flesch in 1948, this formula evaluates sentence length and syllable count on a 0–100 scale. Standard online content thrives in the 60–70 range (plain English).
            </p>
            <div class="mt-3 font-mono text-[11px] bg-white dark:bg-[#2c2c2e] p-2.5 rounded-xl border border-[#e5e5e7] dark:border-[#3a3a3c]">
              Score = 206.835 - 1.015(words/sent) - 84.6(syllables/word)
            </div>
          </div>

          <div class="rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e] p-5 bg-[#f5f5f7] dark:bg-[#161617]">
            <h3 class="font-bold text-[#1d1d1f] dark:text-[#f5f5f7] text-[15px]">Flesch-Kincaid Grade Level</h3>
            <p class="mt-1 text-[#515154] dark:text-[#86868b] leading-relaxed">
              Developed for the US Navy, this converts the Flesch score into a direct US school grade level (e.g. 7.5 means a 7th to 8th grader can easily comprehend the text).
            </p>
            <div class="mt-3 font-mono text-[11px] bg-white dark:bg-[#2c2c2e] p-2.5 rounded-xl border border-[#e5e5e7] dark:border-[#3a3a3c]">
              Grade = 0.39(words/sent) + 11.8(syllables/word) - 15.59
            </div>
          </div>

          <div class="rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e] p-5 bg-[#f5f5f7] dark:bg-[#161617]">
            <h3 class="font-bold text-[#1d1d1f] dark:text-[#f5f5f7] text-[15px]">Gunning Fog Index</h3>
            <p class="mt-1 text-[#515154] dark:text-[#86868b] leading-relaxed">
              Designed by Robert Gunning in 1952 for publications and journalism, Fog specifically penalizes "complex words" having three or more syllables.
            </p>
            <div class="mt-3 font-mono text-[11px] bg-white dark:bg-[#2c2c2e] p-2.5 rounded-xl border border-[#e5e5e7] dark:border-[#3a3a3c]">
              Fog = 0.4 * [ (words/sent) + 100 * (complex words / words) ]
            </div>
          </div>

          <div class="rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e] p-5 bg-[#f5f5f7] dark:bg-[#161617]">
            <h3 class="font-bold text-[#1d1d1f] dark:text-[#f5f5f7] text-[15px]">Coleman-Liau Index (CLI)</h3>
            <p class="mt-1 text-[#515154] dark:text-[#86868b] leading-relaxed">
              Unlike syllable-based formulas, Coleman-Liau relies on letter counts per 100 words, making it exceptionally reliable for automated computerized parsing.
            </p>
            <div class="mt-3 font-mono text-[11px] bg-white dark:bg-[#2c2c2e] p-2.5 rounded-xl border border-[#e5e5e7] dark:border-[#3a3a3c]">
              CLI = 0.0588(letters/100w) - 0.296(sents/100w) - 15.8
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>
</Layout>
