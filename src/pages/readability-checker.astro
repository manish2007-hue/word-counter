---
import Layout from '../layouts/Layout.astro';
import WordCounter from '../components/WordCounter.astro';

const pageTitle = "Readability Score Checker — Flesch-Kincaid & Grade Level Calculator";
const pageDescription = "Free online readability checker. Calculate Flesch Reading Ease, Flesch-Kincaid Grade Level, Gunning Fog Index, and Coleman-Liau scores in real-time. 100% private.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a good Flesch Reading Ease score?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Flesch Reading Ease score between 60 and 70 is considered ideal for general consumer audiences and online blogs, translating to an 8th or 9th-grade reading level. Scores between 70 and 80 are fairly easy (7th grade), while scores below 50 reflect university-level or complex technical material."
      }
    },
    {
      "@type": "Question",
      "name": "How does Flesch-Kincaid Grade Level differ from Flesch Reading Ease?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "While both use the same core metrics (words per sentence and syllables per word), Flesch Reading Ease outputs a 0 to 100 scale where higher scores mean easier reading. Flesch-Kincaid Grade Level outputs a US school grade number (e.g. 8.2 = 8th grade), where lower numbers represent easier reading."
      }
    },
    {
      "@type": "Question",
      "name": "How can I improve my readability score?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To improve your score: 1) Shorten long sentences by breaking compound clauses into two sentences, 2) Swap multi-syllable Latinate jargon for concise everyday words, and 3) Write in active voice rather than passive voice."
      }
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalSlug="readability-checker"
  schema={faqSchema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-8 pb-4 text-center">
    <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] px-3.5 py-1 text-[#0070f3] shadow-2xs mb-4">
      <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
      <span>Multi-Formula Readability Engine</span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
      Readability Score <span class="vercel-gradient-develop">Checker</span>
    </h1>
    <p class="mt-3 text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
      Evaluate text clarity and comprehension levels across 4 industry-standard algorithms: Flesch Reading Ease, Flesch-Kincaid Grade, Gunning Fog, and Coleman-Liau.
    </p>
  </div>

  <WordCounter initialTab="readability" showHeroCopy={false} />

  <!-- Below the fold Educational Guide -->
  <section class="border-t border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#000000] py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 space-y-12">
      
      <div class="vercel-card p-6 sm:p-10">
        <div class="mono-eyebrow text-[#0070f3] mb-2">Algorithm Matrix</div>
        <h2 class="text-2xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed] mb-6">
          Understanding the 4 Readability Formulas
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
          
          <div class="rounded-[8px] border border-[#ebebeb] dark:border-[#222222] p-5 bg-[#fafafa] dark:bg-[#0e0e0e]">
            <h3 class="font-semibold text-[#171717] dark:text-[#ededed] text-base mb-1">Flesch Reading Ease</h3>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              Calculates ease on a 0–100 scale based on sentence length and syllable count. Scores of 60–70 represent plain English accessible to general readers.
            </p>
          </div>

          <div class="rounded-[8px] border border-[#ebebeb] dark:border-[#222222] p-5 bg-[#fafafa] dark:bg-[#0e0e0e]">
            <h3 class="font-semibold text-[#171717] dark:text-[#ededed] text-base mb-1">Flesch-Kincaid Grade Level</h3>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              Translates reading ease into equivalent US school grade levels. An 8.0 indicates an eighth-grade comprehension benchmark.
            </p>
          </div>

          <div class="rounded-[8px] border border-[#ebebeb] dark:border-[#222222] p-5 bg-[#fafafa] dark:bg-[#0e0e0e]">
            <h3 class="font-semibold text-[#171717] dark:text-[#ededed] text-base mb-1">Gunning Fog Index</h3>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              Estimates the years of formal education required to understand text upon first reading, focusing heavily on complex multi-syllable words.
            </p>
          </div>

          <div class="rounded-[8px] border border-[#ebebeb] dark:border-[#222222] p-5 bg-[#fafafa] dark:bg-[#0e0e0e]">
            <h3 class="font-semibold text-[#171717] dark:text-[#ededed] text-base mb-1">Coleman-Liau Index</h3>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              Relies on characters per 100 words rather than syllables, providing high algorithmic accuracy across programmatic and technical documentation.
            </p>
          </div>

        </div>
      </div>

    </div>
  </section>
</Layout>
