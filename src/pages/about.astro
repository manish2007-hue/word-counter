---
import Layout from '../layouts/Layout.astro';

const pageTitle = "About WordCountr — Building the Modern Writing Companion";
const pageDescription = "Learn why we built WordCountr: to replace cluttered, invasive online word counters with a blazing fast, 100% private, client-side writing utility.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalSlug="about"
>
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <div class="vercel-card p-6 sm:p-12">
      
      <div class="mono-eyebrow text-[#0070f3] mb-3">
        Our Architecture & Mission
      </div>

      <h1 class="text-3xl sm:text-4xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed] mb-6">
        About WordCountr
      </h1>

      <div class="text-xs sm:text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1a1] space-y-5">
        <p>
          Online word counters should be quiet, lightning-fast utilities that respect your focus and your confidentiality. Instead, legacy tools on the web have become billboards plastered with video ads, intrusive tracking scripts, and clunky interfaces that haven't evolved in years. Even worse: many tools transmit your private drafts to remote servers.
        </p>

        <h3 class="text-base sm:text-lg font-semibold text-[#171717] dark:text-[#ededed] tracking-tight">Why We Built WordCountr</h3>
        <p>
          WordCountr was built to deliver developer-grade precision and uncompromised privacy:
        </p>

        <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm">
          <li><strong>100% Client-Side Privacy:</strong> Keystrokes and documents are evaluated locally inside your browser runtime. Zero remote data transmission.</li>
          <li><strong>Clean, Ad-Free Workspace:</strong> Zero ads around the editor viewport. Zero layout shifts. Instant instantaneous calculation.</li>
          <li><strong>True Offline Capability:</strong> Fully functional Progressive Web App (PWA) that operates seamlessly without internet connection.</li>
          <li><strong>In-Browser File Parsing:</strong> Drag and drop .docx, .pdf, or .txt documents directly into memory without third-party converters.</li>
          <li><strong>Academic Mode:</strong> The first tool that automatically detects and excludes references and in-text citations for university essay compliance.</li>
        </ul>

        <div class="mt-8 pt-6 border-t border-[#ebebeb] dark:border-[#222222]">
          <h4 class="font-semibold text-sm text-[#171717] dark:text-[#ededed] mb-1">Built for Serious Writers Everywhere</h4>
          <p class="text-xs text-[#8f8f8f]">
            Whether you are a novelist counting chapters, a student finishing a 650-word admissions essay, or an engineer crafting technical specifications, WordCountr is your precision instrument.
          </p>
        </div>
      </div>

    </div>
  </div>
</Layout>
