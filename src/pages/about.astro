---
import Layout from '../layouts/Layout.astro';

const pageTitle = "About CleanWordCounter — Building the Modern Writing Instrument";
const pageDescription = "Learn the story behind CleanWordCounter: why we engineered a privacy-first, ad-free, 100% client-side text analytics workspace to replace bloated legacy counters.";
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalSlug="about"
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-14 sm:py-20">
    
    <!-- Top Pill & Title -->
    <div class="mb-10">
      <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#0070f3]/25 bg-[#0070f3]/10 px-3 py-1 text-[#0070f3] mb-4">
        <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
        <span>Developer-Grade Writing Analytics</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
        About CleanWordCounter
      </h1>

      <p class="mt-3 text-sm sm:text-base text-[#8f8f8f] leading-relaxed">
        Engineered for authors, researchers, journalists, and students who demand sub-millisecond precision, absolute privacy, and a distraction-free writing viewport.
      </p>
    </div>

    <!-- Editorial Story Card -->
    <div class="vercel-card p-6 sm:p-10 space-y-8 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
      
      <div>
        <h2 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-3 tracking-tight">
          The Problem with Legacy Word Counters
        </h2>
        <p class="mb-3">
          For over two decades, online word counters have remained virtually unchanged. Visit any top search result for a word counter and you are greeted with a barrage of intrusive banner ads, flashing video takeovers, cookie popups, and deceptive "Download" buttons. Worse still, many of these legacy services route your private keystrokes and unpublished essays to centralized cloud servers where your prose is logged, profiled, or ingested into third-party AI training pipelines.
        </p>
        <p>
          We believed writers deserved vastly better. Writing tools should be like surgical instruments: quiet, reliable, instantaneous, and completely respectful of your data sovereignty.
        </p>
      </div>

      <div class="border-t border-[#ebebeb] dark:border-[#222222] pt-8">
        <h2 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-4 tracking-tight">
          Our Three Guiding Engineering Principles
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="p-4 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <div class="font-mono text-xs text-[#0070f3] mb-1 font-semibold">PRINCIPLE 01</div>
            <h3 class="text-sm font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">100% Client-Side</h3>
            <p class="text-xs text-[#666666] dark:text-[#8f8f8f] leading-relaxed">
              Every tokenization algorithm, readability grade calculation, and document parser runs locally in your device's browser runtime. Zero cloud transmission.
            </p>
          </div>

          <div class="p-4 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <div class="font-mono text-xs text-[#0070f3] mb-1 font-semibold">PRINCIPLE 02</div>
            <h3 class="text-sm font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">Zero Ads, Zero Clutter</h3>
            <p class="text-xs text-[#666666] dark:text-[#8f8f8f] leading-relaxed">
              No sponsored banners. No layout shifts while typing. A stark, elegant canvas styled with the Vercel Geist design system for maximum focus.
            </p>
          </div>

          <div class="p-4 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <div class="font-mono text-xs text-[#0070f3] mb-1 font-semibold">PRINCIPLE 03</div>
            <h3 class="text-sm font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">Offline by Design</h3>
            <p class="text-xs text-[#666666] dark:text-[#8f8f8f] leading-relaxed">
              Engineered as a Progressive Web App (PWA). Load the page once, disconnect your Wi-Fi or board a flight, and count words without hesitation.
            </p>
          </div>
        </div>
      </div>

      <div class="border-t border-[#ebebeb] dark:border-[#222222] pt-8">
        <h2 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-3 tracking-tight">
          Modern Technology Stack
        </h2>
        <p class="mb-4">
          CleanWordCounter is constructed with cutting-edge open-source web technologies:
        </p>

        <ul class="space-y-2 text-xs sm:text-sm font-mono text-[#666666] dark:text-[#8f8f8f]">
          <li class="flex items-start gap-2">
            <span class="text-[#0070f3] font-bold">›</span>
            <span><strong class="text-[#171717] dark:text-[#ededed]">Astro 5:</strong> Delivers zero-JS static HTML overhead for lightning-fast sub-second initial page loads.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#0070f3] font-bold">›</span>
            <span><strong class="text-[#171717] dark:text-[#ededed]">Intl.Segmenter:</strong> Native browser Unicode tokenization for flawless CJK (Chinese, Japanese, Korean) word boundary segmentation.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#0070f3] font-bold">›</span>
            <span><strong class="text-[#171717] dark:text-[#ededed]">PDF.js &amp; Mammoth.js:</strong> Client-side WebAssembly and JS binary parsers for in-memory PDF and DOCX extraction.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#0070f3] font-bold">›</span>
            <span><strong class="text-[#171717] dark:text-[#ededed]">Tailwind CSS 4:</strong> Vercel Geist design tokens with stark monochrome contrast and fluid dark/light theming.</span>
          </li>
        </ul>
      </div>

      <div class="border-t border-[#ebebeb] dark:border-[#222222] pt-8">
        <h2 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-2 tracking-tight">
          Open Collaboration &amp; Community Feedback
        </h2>
        <p>
          CleanWordCounter is actively developed and open to ideas from the global writing community. Whether you have recommendations for new academic citation patterns, international language dictionaries, or UX enhancements, visit our <a href={`${base}/contact`} class="text-[#0070f3] hover:underline">Contact Page</a> to share your thoughts.
        </p>
      </div>

    </div>

    <!-- Return to Workspace Button -->
    <div class="mt-8 text-center sm:text-left">
      <a href={`${base}/`} class="vercel-btn-primary inline-flex">
        <span>← Launch Word Counter Workspace</span>
      </a>
    </div>

  </div>
</Layout>
