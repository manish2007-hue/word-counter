---
import Layout from '../layouts/Layout.astro';
import WordCounter from '../components/WordCounter.astro';
import { PLATFORM_LIMITS } from '../lib/socialLimits';

const pageTitle = "Social Media Character Counter — Twitter, LinkedIn & Instagram Limits";
const pageDescription = "Free online social media character counter. Instantly check character and word limits for Twitter/X (280), LinkedIn (3,000), Instagram (2,200), SEO Meta descriptions (155), and YouTube titles.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the Twitter/X character limit in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The standard post limit on X (formerly Twitter) is 280 characters for standard accounts. Premium verified subscribers can post up to 25,000 characters."
      }
    },
    {
      "@type": "Question",
      "name": "What is the optimal character count for LinkedIn posts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "While LinkedIn allows up to 3,000 characters per post, the mobile feed cuts text off with a '...see more' button after approximately 140 to 160 characters. Keeping your primary hook inside the first 140 characters drives the highest click-through rate."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Google SEO Meta Description character limit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Google displays up to 155–160 characters (approx. 960 pixels) on desktop and 115–120 characters on mobile. Keeping your meta description between 120 and 155 characters ensures it will not be truncated with an ellipsis on SERP."
      }
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalSlug="social-media-counter"
  schema={faqSchema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-8 pb-4 text-center">
    <div class="inline-flex items-center gap-1.5 rounded-full border border-[#d2d2d7] dark:border-[#3a3a3c] bg-white dark:bg-[#1c1c1e] px-3.5 py-1 text-xs font-semibold text-[#0066cc] dark:text-[#2997ff] mb-4">
      📱 Multi-Platform Character Compliance
    </div>
    <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7]">
      Social Media <span class="text-[#0066cc] dark:text-[#2997ff]">Character Counter</span>
    </h1>
    <p class="mt-3 text-sm sm:text-base text-[#86868b] max-w-2xl mx-auto leading-relaxed">
      Craft captions, tweets, and headlines with live character limit meters. Avoid cutoffs on Twitter/X, LinkedIn, Instagram, and Google Search.
    </p>
  </div>

  <WordCounter initialTab="social" showHeroCopy={false} />

  <!-- Below the fold SEO guide -->
  <section class="border-t border-[#e5e5e7] dark:border-[#2c2c2e] bg-[#f5f5f7] dark:bg-[#161617] py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 space-y-12">
      
      <div class="rounded-3xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white dark:bg-[#1c1c1e] p-6 sm:p-10 shadow-2xs">
        <h2 class="text-2xl font-bold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7] mb-4">
          2026 Character Limit Quick Reference Cheat Sheet
        </h2>
        <div class="overflow-x-auto rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e]">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-[#f5f5f7] dark:bg-[#2c2c2e] text-[#1d1d1f] dark:text-[#f5f5f7]">
              <tr>
                <th class="py-3 px-4 font-semibold">Platform</th>
                <th class="py-3 px-4 font-semibold">Hard Limit</th>
                <th class="py-3 px-4 font-semibold">Feed Cutoff (Preview)</th>
                <th class="py-3 px-4 font-semibold">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#f0f0f2] dark:divide-[#242426] text-[#515154] dark:text-[#86868b]">
              {PLATFORM_LIMITS.map((p) => (
                <tr>
                  <td class="py-3 px-4 font-medium text-[#1d1d1f] dark:text-[#f5f5f7] flex items-center gap-2">
                    <span class="font-mono text-xs">{p.icon}</span>
                    <span>{p.name}</span>
                  </td>
                  <td class="py-3 px-4 font-mono-numbers font-semibold text-[#0066cc] dark:text-[#2997ff]">
                    {p.maxChars.toLocaleString()} chars
                  </td>
                  <td class="py-3 px-4 text-xs">
                    {p.tip}
                  </td>
                  <td class="py-3 px-4 text-xs text-emerald-600 dark:text-emerald-400 font-medium">
                    Verified 2026
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="rounded-3xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white dark:bg-[#1c1c1e] p-6 sm:p-10 shadow-2xs space-y-4">
        <h2 class="text-2xl font-bold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7]">
          Why Character Precision Drives Social Engagement
        </h2>
        <p class="text-xs sm:text-sm text-[#515154] dark:text-[#86868b] leading-relaxed">
          Every social media algorithm relies on user engagement within the first 60 seconds of a post being published. If your caption gets abruptly truncated with a messy hyphen or cuts off mid-sentence before the reader understands the value of the post, your click-through rate collapses. Using WordCountr's live limit checker ensures your call to action, emojis, and hashtags land within the high-visibility zone.
        </p>
      </div>

    </div>
  </section>
</Layout>
