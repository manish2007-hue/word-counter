---
import Layout from '../layouts/Layout.astro';
import WordCounter from '../components/WordCounter.astro';
import ToolAuthoritySection from '../components/ToolAuthoritySection.astro';

const pageTitle = "Social Media Character Counter – X, LinkedIn & Instagram";
const pageDescription = "Real-time character counters for Twitter/X (280), LinkedIn (3000), Instagram & SEO. Preview cutoffs and avoid truncated posts before publishing. 100% free!";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the Twitter/X character limit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The standard Twitter/X character limit for unverified accounts is 280 characters. URLs take up 23 characters regardless of length. Posts between 200 and 250 characters consistently earn higher engagement."
      }
    },
    {
      "@type": "Question",
      "name": "What is the LinkedIn post character limit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LinkedIn allows up to 3,000 characters per regular feed post. However, the critical cutoff hook happens at approximately 140 to 210 characters, after which users must click '...see more'."
      }
    },
    {
      "@type": "Question",
      "name": "What is the ideal length for SEO meta titles and descriptions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For optimal Google search results, keep page meta titles under 60 characters (around 580 pixels) and meta descriptions between 150 and 160 characters (around 960 pixels) to avoid mobile and desktop truncation."
      }
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalSlug="social-media-counter"
  schema={faqSchema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-8 pb-4 text-center">
    <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] px-3.5 py-1 text-[#0070f3] shadow-2xs mb-4">
      <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
      <span>Multi-Platform Character Compliance</span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
      Social Media <span class="vercel-gradient-develop">Character Counter</span>
    </h1>
    <p class="mt-3 text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
      Craft captions, tweets, and metadata with live constraint meters. Prevent truncation on X, LinkedIn, Instagram, and search engines.
    </p>
  </div>

  <WordCounter initialTab="social" showHeroCopy={false} />

  <!-- Below the fold SEO guide -->
  <section class="border-t border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#000000] py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 space-y-12">
      
      <div class="vercel-card p-6 sm:p-10">
        <div class="mono-eyebrow text-[#0070f3] mb-2">Publishing Reference</div>
        <h2 class="text-2xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed] mb-4">
          Platform Character Constraints
        </h2>
        <div class="overflow-x-auto rounded-[8px] border border-[#ebebeb] dark:border-[#222222]">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-[#fafafa] dark:bg-[#0e0e0e] text-[#8f8f8f] font-mono border-b border-[#ebebeb] dark:border-[#222222]">
              <tr>
                <th class="py-2.5 px-4 font-medium">PLATFORM</th>
                <th class="py-2.5 px-4 font-medium">MAX LIMIT</th>
                <th class="py-2.5 px-4 font-medium">CUTOFF / VISIBILITY HOOK</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#ebebeb] dark:divide-[#222222] text-[#4d4d4d] dark:text-[#a1a1a1] font-mono">
              <tr>
                <td class="py-2.5 px-4 font-semibold text-[#171717] dark:text-[#ededed] font-sans">Twitter / X Post</td>
                <td class="py-2.5 px-4">280 chars</td>
                <td class="py-2.5 px-4 font-sans text-xs">Optimal engagement at 200–250 characters.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-semibold text-[#171717] dark:text-[#ededed] font-sans">LinkedIn Post</td>
                <td class="py-2.5 px-4">3,000 chars</td>
                <td class="py-2.5 px-4 font-sans text-xs">Truncated behind "...see more" after ~140–210 chars.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-semibold text-[#171717] dark:text-[#ededed] font-sans">Instagram Caption</td>
                <td class="py-2.5 px-4">2,200 chars</td>
                <td class="py-2.5 px-4 font-sans text-xs">First 125 characters display before "more" prompt.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-semibold text-[#171717] dark:text-[#ededed] font-sans">Google Meta Title</td>
                <td class="py-2.5 px-4">60 chars</td>
                <td class="py-2.5 px-4 font-sans text-xs">Truncated with ellipsis in SERPs past 600px (~60 chars).</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-semibold text-[#171717] dark:text-[#ededed] font-sans">Google Meta Description</td>
                <td class="py-2.5 px-4">155 chars</td>
                <td class="py-2.5 px-4 font-sans text-xs">Snippet truncated past 960px (~155–160 chars).</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </section>

  <!-- Authority Guide, Matrix, Portal Errors, FAQs, and Related Utilities -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-16">
    <ToolAuthoritySection
      toolName="Social Media Character Counter"
      category="social"
      currentToolId="social-media-counter"
      guidelinesHeading="Understanding Social Media Character Limits & Truncation Cutoffs"
      guidelinesIntro="Social media platforms enforce hard character caps (e.g. 280 on X/Twitter, 3,000 on LinkedIn, 2,200 on Instagram, 500 on Threads). More importantly, feed algorithms truncate captions behind '...see more' after only 125 to 140 characters. Our multi-platform counter ensures your hook stays visible before the fold."
    />
  </div>
</Layout>
