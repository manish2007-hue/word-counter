---
import Layout from '../layouts/Layout.astro';
import WordCounter from '../components/WordCounter.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import WordsToPages from '../components/WordsToPages.astro';
import ToolsDashboard from '../components/ToolsDashboard.astro';

const pageTitle = "Free Word Counter – 100% Private, Instant & No Ads";
const pageDescription = "Count words, characters, sentences & reading time in real time with zero ads. 100% private in-browser text tool for writers & students. Try it free!";
const pageKeywords = "word counter, free word counter, word count checker, online word counter, private word counter, word counter no ads, essay word counter, count characters, reading time calculator";

// Comprehensive FAQ Dataset for Word Counter Websites
const mostFaqs = [
  {
    category: "General Word & Character Counting",
    question: "What is an online word counter and how does it work?",
    answer: "An online word counter is a digital text analytics utility that calculates the exact number of words, characters (with and without spaces), sentences, paragraphs, and reading time in a block of text. It works using natural language tokenization algorithms that parse text across whitespace boundaries and punctuation markers in real time as you type or paste."
  },
  {
    category: "General Word & Character Counting",
    question: "What is the difference between word count and character count?",
    answer: "Word count measures the number of distinct words separated by spaces or punctuation (for example, 'online word counter' is 3 words). Character count measures every individual letter, number, symbol, and space. The same phrase contains 19 characters with spaces, or 17 characters without spaces."
  },
  {
    category: "General Word & Character Counting",
    question: "Does a word counter count spaces, numbers, and punctuation marks?",
    answer: "Yes. Groupings of numbers (like '2025' or '100') count as individual words. Punctuation attached to words (like hyphens in 'state-of-the-art' or apostrophes in 'don\\'t') is treated as part of the word, while standalone symbols are not counted as words. Character counts provide two separate values: total characters including spaces, and characters excluding spaces."
  },
  {
    category: "General Word & Character Counting",
    question: "How many words is a page? (Words to Pages conversion)",
    answer: "In standard academic and professional typography (12 pt Times New Roman or Arial font with 1-inch margins), a single-spaced page contains approximately 500 words, while a double-spaced page contains approximately 250 words. Therefore, 1,000 words equals roughly 2 single-spaced pages or 4 double-spaced pages."
  },
  {
    category: "Document & Processor Guides",
    question: "How do I check the word count on Google Docs?",
    answer: "To check word count in Google Docs, press Ctrl + Shift + C on Windows and Chromebooks, or Command + Shift + C on Mac. You can also click Tools > Word count in the top menu. To keep a live count visible in the bottom-left corner while typing, check the box for 'Display word count while typing'."
  },
  {
    category: "Document & Processor Guides",
    question: "How do I check the word count in Microsoft Word?",
    answer: "In Microsoft Word, the live word count is displayed continuously in the bottom-left corner of the status bar. Clicking this indicator opens the Word Count dialog showing words, characters, paragraphs, and lines. You can also view it by opening the Review tab and clicking Word Count, or pressing Ctrl + Shift + G."
  },
  {
    category: "Document & Processor Guides",
    question: "Can I count words in a PDF or Word (.docx) document without copying and pasting?",
    answer: "Yes! You can drag and drop any .pdf, .docx, .txt, or .md file directly into the CleanWordCounter editor viewport. The built-in WebAssembly parser extracts the clean text stream in browser memory without sending confidential documents to external conversion servers."
  },
  {
    category: "Writing & Publishing Metrics",
    question: "How are estimated reading time and speaking time calculated?",
    answer: "Reading time is estimated using the global benchmark silent reading speed of 225 words per minute (WPM) for adults. Speaking time is calculated at 130 words per minute, the standard delivery tempo for presentations, keynote speeches, podcasts, and video voiceovers."
  },
  {
    category: "Writing & Publishing Metrics",
    question: "What is keyword density and why is it important for SEO?",
    answer: "Keyword density is the percentage of times a specific keyword or phrase appears relative to the total word count: (Keyword Count / Total Words) * 100. In search engine optimization (SEO), tracking keyword density ensures target keywords are naturally represented (typically 1% to 2.5%) without triggering search penalties for keyword stuffing."
  },
  {
    category: "Writing & Publishing Metrics",
    question: "What readability scores should I aim for? (Flesch-Kincaid & Grade Levels)",
    answer: "Readability formulas evaluate how easily readers understand your copy based on sentence length and syllable count. For general websites, blogs, and public communications, aiming for Grade 7 to 9 (a Flesch Reading Ease score of 60 to 70) ensures broad accessibility, higher dwell time, and clear comprehension."
  },
  {
    category: "Writing & Publishing Metrics",
    question: "What are the character limits for Twitter (X), LinkedIn, Instagram, and TikTok?",
    answer: "Standard platform character ceilings include: X / Twitter posts: 280 characters; LinkedIn posts: 3,000 characters (with an above-the-fold cutoff around 140 characters); Instagram captions: 2,200 characters (first 125 characters preview); Google SEO titles: 60 characters; and Google meta descriptions: 160 characters."
  },
  {
    category: "Tool Features & Privacy",
    question: "Is CleanWordCounter safe, private, and secure for confidential documents?",
    answer: "Yes, 100%. CleanWordCounter runs entirely on client-side JavaScript inside your web browser. Unlike cloud-based counters, your text, manuscripts, legal contracts, and uploaded documents are never transmitted over the internet, never saved on remote servers, and never tracked."
  },
  {
    category: "Tool Features & Privacy",
    question: "Can I use this word counter offline on mobile or desktop?",
    answer: "Yes. CleanWordCounter is an installable Progressive Web App (PWA). You can install it on your iPhone, Android, Mac, or Windows PC by clicking 'Install' or 'Add to Home Screen'. Once installed, all word counting, readability scoring, and file parsing features work completely offline."
  },
  {
    category: "Tool Features & Privacy",
    question: "How does Academic Essay Mode exclude citations and references?",
    answer: "University guidelines (APA 7th, MLA 9th, Chicago, Harvard) require students to exclude parenthetical citations (e.g., (Smith, 2024) or [1-3]) and end-of-paper References or Works Cited sections from net word limits. CleanWordCounter automatically detects and deducts these elements, displaying both Gross and Net Essay word counts."
  }
];

// Standalone Schema.org FAQPage JSON-LD
const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": mostFaqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

// Composite Graph for Head (WebApplication + HowTo + FAQPage)
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "SoftwareApplication"],
      "@id": "https://cleanwordcounter.com/#app",
      "name": "CleanWordCounter",
      "headline": "Free Online Word Counter Tool & Precision Word Count Checker",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "3420"
      },
      "description": pageDescription,
      "url": "https://cleanwordcounter.com/"
    },
    {
      "@type": "HowTo",
      "name": "How to Check Word Count on Google Docs",
      "description": "Learn how to see word count on Google Docs using keyboard shortcuts, the tools menu, or the real-time floating word counter.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Use the Keyboard Shortcut",
          "text": "Press Ctrl + Shift + C on Windows and Chromebooks, or Command + Shift + C on Apple macOS to instantly open the document word count dialog.",
          "position": 1
        },
        {
          "@type": "HowToStep",
          "name": "Use the Tools Menu",
          "text": "Click Tools in the top navigation bar of Google Docs, then select Word count from the dropdown menu.",
          "position": 2
        },
        {
          "@type": "HowToStep",
          "name": "Display Live Word Count While Typing",
          "text": "Check the box labeled 'Display word count while typing' at the bottom of the Word count pop-up to anchor a permanent live word counter on your screen.",
          "position": 3
        }
      ]
    },
    faqPageSchema
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  schema={structuredData}
>
  <!-- Dedicated Standalone Schema.org FAQPage JSON-LD for Search Crawlers -->
  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema, null, 2)} />

  <!-- Interactive Tool Workspace (Above the fold) -->
  <WordCounter showHeroCopy={true} />

  <!-- Interactive All-Tools Hub & Category Switcher -->
  <section class="border-t border-[#ebebeb] dark:border-[#222222] bg-[#fdfdfd] dark:bg-[#070708] py-12 transition-colors duration-200">
    <ToolsDashboard
      headline="Explore All In-Browser Tools"
      subheadline="Switch between writing, cleaning, generator, developer, and social media utilities. 100% private with instant execution."
      showHero={true}
    />
  </section>

  <!-- BELOW THE FOLD: VERCEL GEIST SEO SECTIONS & TECHNICAL MATRICES -->
  <section class="border-t border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#1c1c1c] py-16 sm:py-20 transition-colors duration-200">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 space-y-12 sm:space-y-16">
      
      <!-- Section 1: Editorial Overview -->
      <div class="vercel-card p-6 sm:p-10 space-y-6">
        <div class="mono-eyebrow text-[#0070f3]">Editorial Guide &amp; Technical Analysis</div>
        
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
          The Definitive Free Word Counter &amp; Precision Writing Analytics Tool
        </h2>

        <div class="rounded-[8px] border border-[#0070f3]/25 bg-[#0070f3]/5 dark:bg-[#0070f3]/10 p-5 text-sm sm:text-base leading-relaxed text-[#171717] dark:text-[#ededed]">
          <p>
            CleanWordCounter is a fast, 100% private <strong>free word counter</strong> engineered to give you instant, accurate word count and text analytics without intrusive ads or tracking. Count words, characters, sentences, reading time, and pages in real time right in your browser.
          </p>
        </div>

        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Unlike legacy counters bogged down with intrusive banner advertisements, video popups, and laggy interfaces, this <strong>online word counter</strong> executes 100% within your client browser. As a versatile <strong>word counter tool</strong> and real-time <strong>word count checker</strong>, it provides immediate metrics for total words, characters with spaces, characters without spaces, sentences, paragraphs, reading speed, and speech duration. Because it requires zero setup or server handshakes, this <strong>word counter free</strong> utility operates at zero latency and works entirely offline as a Progressive Web App (PWA).
        </p>
      </div>

      <!-- Section 2: How to Check Word Count on Google Docs -->
      <div class="vercel-card p-6 sm:p-10 space-y-6">
        <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">Step-by-Step Guide</div>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
          How to Check Word Count on Google Docs (and When to Use CleanWordCounter)
        </h2>

        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Millions of writers create drafts inside cloud processors and frequently search for <strong>how to check word count on google docs</strong>. While writing inside Google Docs, monitoring your volume is straightforward once you know the built-in shortcuts and settings. Here is how to access your <strong>word count on google docs</strong> across desktop and web platforms:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="p-4 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <div class="text-xs font-mono text-[#0070f3] mb-1">METHOD 1: SHORTCUT</div>
            <h3 class="text-sm font-semibold text-[#171717] dark:text-[#ededed] mb-2">Keyboard Shortcut</h3>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              Press <kbd class="px-1.5 py-0.5 rounded bg-black/10 dark:bg-white/10 font-mono text-[11px]">Ctrl + Shift + C</kbd> on Windows or ChromeOS, or <kbd class="px-1.5 py-0.5 rounded bg-black/10 dark:bg-white/10 font-mono text-[11px]">Cmd + Shift + C</kbd> on Apple macOS to instantly bring up the document metrics dialog.
            </p>
          </div>

          <div class="p-4 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <div class="text-xs font-mono text-[#0070f3] mb-1">METHOD 2: MENU</div>
            <h3 class="text-sm font-semibold text-[#171717] dark:text-[#ededed] mb-2">Tools Menu</h3>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              Navigate to the top menu bar, click <strong>Tools</strong>, and select <strong>Word count</strong>. A pop-up modal will immediately calculate the pages, words, characters, and non-space characters for your document or highlighted text.
            </p>
          </div>

          <div class="p-4 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <div class="text-xs font-mono text-[#0070f3] mb-1">METHOD 3: PINNING</div>
            <h3 class="text-sm font-semibold text-[#171717] dark:text-[#ededed] mb-2">Live Floating Counter</h3>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              If you want to know <strong>how to see word count on google docs</strong> dynamically while typing, open the Word Count pop-up and check the box labeled <em>"Display word count while typing"</em>. This anchors a real-time counter box in the bottom-left corner of your document.
            </p>
          </div>
        </div>

        <div class="p-4 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
          <h3 class="text-sm font-semibold text-[#171717] dark:text-[#ededed] mb-2">Why Writers Supplement Google Docs with CleanWordCounter</h3>
          <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
            While the built-in <strong>word counter google docs</strong> feature covers basic length, professional publishing demands far deeper text intelligence. Google Docs cannot compute Flesch-Kincaid readability grade levels, cannot analyze keyword density or n-grams for search engine optimization, cannot evaluate social media character limits, and cannot automatically filter academic parenthetical citations from your substantive argument. CleanWordCounter bridges these critical workflow gaps while delivering absolute browser privacy.
          </p>
        </div>
      </div>

      <!-- Section 3: Academic Essay Mode -->
      <div class="vercel-card p-6 sm:p-10 space-y-6">
        <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">Academic Publishing</div>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
          Essay Word Counter: Automatic Citation &amp; Reference Exclusion
        </h2>

        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Academic institutions, college admissions boards, and peer-reviewed journals enforce strict <strong>word count</strong> parameters. Common Application college essays impose a strict 650-word ceiling, while university term papers and dissertations dictate rigid targets (e.g., 3,000 words ±10%). Crucially, major academic style guides (such as APA 7th Edition, MLA 9th Edition, Harvard, and Chicago) mandate that in-text parenthetical citations (e.g., <em>(Smith, 2024)</em> or numeric markers like <em>[1-4]</em>) and end Bibliographies or Works Cited lists must be excluded from the official essay length.
        </p>

        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Traditional text counters force students to manually highlight sections or perform tedious arithmetic. CleanWordCounter functions as an intelligent <strong>essay word counter</strong> with automated citation filtering. By parsing your manuscript in browser memory, our algorithm identifies trailing reference headers and parenthetical citations, providing both Gross Word Count and Net Essay Word Count simultaneously. This ensures your academic writing complies exactly with official university guidelines.
        </p>
      </div>

      <!-- Section 4: PDF Word Counter -->
      <div class="vercel-card p-6 sm:p-10 space-y-6">
        <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">Document Processing</div>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
          PDF Word Counter: Client-Side Document Analysis
        </h2>

        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Determining the length of formatted PDF publications, manuscripts, and whitepapers is notoriously difficult. Copy-pasting text out of Adobe Acrobat or preview viewers often introduces broken line wraps, hyphenated line breaks, and duplicate headers. CleanWordCounter includes a built-in <strong>pdf word counter</strong> and Microsoft Word (.docx) document parser that operates locally in browser memory.
        </p>

        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Simply drag and drop your PDF or DOCX file directly into the editor viewport. Our embedded WebAssembly parser extracts the clean text stream in fractions of a second without sending your confidential client briefs, legal contracts, or unreleased book manuscripts to third-party cloud conversion servers. Whether on desktop or mobile, you get an uncompromising <strong>word counter online</strong> experience that preserves 100% of your data sovereignty.
        </p>
      </div>

      <!-- Section 5: The Precision Word Counter Calculator -->
      <div class="vercel-card p-6 sm:p-10 space-y-6">
        <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">Linguistic Engineering</div>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
          The Precision Word Counter Calculator: How Metrics Are Derived
        </h2>

        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          CleanWordCounter is not just a simplistic space-counter; it functions as a comprehensive <strong>word counter calculator</strong> engineered according to recognized international linguistic specifications:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
          <div class="p-4 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <h3 class="font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">Intl.Segmenter Tokenization</h3>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              Splitting text by raw whitespace fails on Asian scripts (Chinese, Japanese, Korean) which do not utilize spaces. We implement native <code>Intl.Segmenter</code> word segmentation for global language accuracy.
            </p>
          </div>

          <div class="p-4 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <h3 class="font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">Reading &amp; Speaking Speeds</h3>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              Estimated reading time is modeled at 225 words per minute (the scientific standard for adult silent reading). Estimated speaking time is calibrated to 130 WPM for speechwriting and video scripting.
            </p>
          </div>

          <div class="p-4 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <h3 class="font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">Multi-Formula Readability</h3>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              Calculates Flesch Reading Ease (0-100), Flesch-Kincaid Grade Level, Gunning Fog Index, Coleman-Liau Index, and Automated Readability Index (ARI) using accurate polysyllabic counters.
            </p>
          </div>

          <div class="p-4 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <h3 class="font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">N-Gram Keyword Density</h3>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              Extracts 1-word, 2-word, and 3-word n-grams with stop-word suppression. Click any keyword in the list to highlight its occurrences in real time within your text editor.
            </p>
          </div>
        </div>
      </div>

      <!-- Section 6: Social Media & SERP Strategy -->
      <div class="vercel-card p-6 sm:p-10 space-y-6">
        <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">Social Media &amp; SERP Strategy</div>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
          Mastering Publishing Limits: Character Counters Across 10 Channels
        </h2>

        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Every major social network and search engine operates under precise character constraints. Writing past these thresholds results in truncated sentences, missing call-to-actions, and compromised conversion rates. CleanWordCounter live-tracks your copy against 10 vital publishing destinations:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 text-xs">
          <div class="p-3.5 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <div class="font-semibold text-[#171717] dark:text-[#ededed]">X / Twitter Post</div>
            <div class="text-[#8f8f8f] font-mono mt-1">280 character ceiling</div>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] mt-1 text-[11px]">Posts between 200–250 chars achieve peak engagement and retweets.</p>
          </div>

          <div class="p-3.5 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <div class="font-semibold text-[#171717] dark:text-[#ededed]">LinkedIn Post</div>
            <div class="text-[#8f8f8f] font-mono mt-1">3,000 char maximum</div>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] mt-1 text-[11px]">Keep your introductory hook under 140 chars before the "...see more" cutoff.</p>
          </div>

          <div class="p-3.5 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <div class="font-semibold text-[#171717] dark:text-[#ededed]">Instagram Caption</div>
            <div class="text-[#8f8f8f] font-mono mt-1">2,200 char limit</div>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] mt-1 text-[11px]">Preview displays 125 chars; front-load essential brand messaging.</p>
          </div>

          <div class="p-3.5 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <div class="font-semibold text-[#171717] dark:text-[#ededed]">Google SEO Title</div>
            <div class="text-[#8f8f8f] font-mono mt-1">60 characters ideal</div>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] mt-1 text-[11px]">Prevents SERP truncation and ellipsis on mobile and desktop searches.</p>
          </div>

          <div class="p-3.5 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <div class="font-semibold text-[#171717] dark:text-[#ededed]">Google Meta Description</div>
            <div class="text-[#8f8f8f] font-mono mt-1">160 characters target</div>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] mt-1 text-[11px]">Optimal length to maximize organic click-through rate (CTR) in search results.</p>
          </div>

          <div class="p-3.5 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
            <div class="font-semibold text-[#171717] dark:text-[#ededed]">YouTube Video Title</div>
            <div class="text-[#8f8f8f] font-mono mt-1">100 char limit (70 sweet spot)</div>
            <p class="text-[#4d4d4d] dark:text-[#a1a1a1] mt-1 text-[11px]">Ensure key search queries are visible on mobile YouTube feeds.</p>
          </div>
        </div>
      </div>

      <!-- Comparison Table -->
      <ComparisonTable />

      <!-- Words to Pages Reference Guide -->
      <WordsToPages />

      <!-- Architectural Advantages Grid -->
      <div>
        <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070] mb-2 text-center sm:text-left">Engineering Principles</div>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed] mb-6 text-center sm:text-left">
          Built for Precision and Privacy
        </h2>

