---
import Layout from '../layouts/Layout.astro';
import ToolAuthoritySection from '../components/ToolAuthoritySection.astro';

const pageTitle = "Words to Pages Calculator – Custom Spacing & Fonts";
const pageDescription = "Calculate exact typed pages from word count. Customize fonts (Times, Arial, Calibri), font sizes, and single or double spacing in real time. 100% free!";
const pageKeywords = "words to pages calculator, words to typed pages, word count to pages converter, double spaced word count, font spacing page calculator";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Interactive Words to Pages Calculator",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": pageDescription,
      "url": "https://cleanwordcounter.com/words-to-pages/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How many pages is 1,000 words double-spaced?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1,000 words double-spaced with standard 12pt font (Times New Roman or Arial) and 1-inch margins equals approximately 4 pages."
          }
        },
        {
          "@type": "Question",
          "name": "How many pages is 500 words single-spaced?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "500 words single-spaced equals exactly 1 full typed page in standard 12pt font."
          }
        },
        {
          "@type": "Question",
          "name": "Does font choice affect how many pages a word count takes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Courier New (monospaced) takes up roughly 40% more pages than Arial or Times New Roman. Calibri is slightly denser than Georgia or Times New Roman."
          }
        },
        {
          "@type": "Question",
          "name": "What is the standard font and spacing for university essays?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most college APA, MLA, and Chicago format guidelines mandate 12-point Times New Roman font, double line spacing (2.0), and 1-inch margins on all sides."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalSlug="words-to-pages"
  schema={schema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 pb-4 text-center">
    <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] px-3.5 py-1 text-[#0070f3] shadow-2xs mb-3">
      <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
      <span>Typography-Calibrated Calculator</span>
    </div>
    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
      Words to Pages <span class="vercel-gradient-develop">Calculator</span>
    </h1>
    <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
      Accurately calculate typed pages based on your exact word count, font family, font size, margins, and line spacing.
    </p>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 mb-12">
    <!-- Main Interactive Calculator Workspace -->
    <div class="vercel-card overflow-hidden mb-8">
      
      <!-- Top Mode Switcher (Number of Words vs Paste Your Text) -->
      <div class="p-3 sm:p-4 border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e] flex items-center justify-between">
        <div class="inline-flex rounded-[6px] border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#141414] p-0.5 text-xs font-medium">
          <button
            id="mode-slider-btn"
            type="button"
            class="px-3 py-1 rounded-[4px] bg-[#171717] dark:bg-white text-white dark:text-black font-semibold transition cursor-pointer"
          >
            Word Count Slider
          </button>
          <button
            id="mode-paste-btn"
            type="button"
            class="px-3 py-1 rounded-[4px] text-[#8f8f8f] hover:text-[#171717] dark:hover:text-white transition cursor-pointer"
          >
            Paste My Draft
          </button>
        </div>

        <div class="text-xs font-mono text-[#8f8f8f] hidden sm:block">
          Calibrated to Standard 8.5" × 11" US Letter / A4
        </div>
      </div>

      <div class="p-6 sm:p-8 bg-white dark:bg-[#0a0a0a] space-y-6">
        
        <!-- Mode 1: Slider & Number Input -->
        <div id="section-slider-mode" class="space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <label for="word-number-input" class="text-xs font-mono uppercase tracking-wider text-[#8f8f8f] font-semibold">
              Target Word Count
            </label>
            <div class="flex items-center gap-2">
              <input
                type="number"
                id="word-number-input"
                value="1000"
                min="10"
                max="100000"
                class="w-32 rounded-[6px] border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414] px-3 py-1.5 font-mono text-base font-bold text-[#171717] dark:text-white text-right focus:outline-hidden focus:border-[#0070f3]"
              />
              <span class="font-mono text-xs text-[#8f8f8f]">words</span>
            </div>
          </div>

          <input
            type="range"
            id="word-range-slider"
            min="100"
            max="10000"
            step="50"
            value="1000"
            class="w-full h-2 bg-[#ebebeb] dark:bg-[#262626] rounded-lg appearance-none cursor-pointer accent-[#0070f3]"
          />
          <div class="flex justify-between text-[10px] font-mono text-[#8f8f8f]">
            <span>100 words</span>
            <span>2,500 words</span>
            <span>5,000 words</span>
            <span>7,500 words</span>
            <span>10,000 words</span>
          </div>
        </div>

        <!-- Mode 2: Paste Your Text (Initially Hidden) -->
        <div id="section-paste-mode" class="hidden space-y-2">
          <label for="paste-text-input" class="text-xs font-mono uppercase tracking-wider text-[#8f8f8f] font-semibold">
            Paste Document Text
          </label>
          <textarea
            id="paste-text-input"
            rows="5"
            placeholder="Paste your essay, manuscript, or chapter here to count words and calculate pages..."
            class="w-full rounded-[8px] border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414] p-3.5 font-mono text-xs text-[#171717] dark:text-[#ededed] focus:outline-hidden focus:border-[#0070f3]"
          ></textarea>
        </div>

        <!-- Typography Selectors Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 pt-4 border-t border-[#ebebeb] dark:border-[#222222]">
          
          <!-- Font Family -->
          <div>
            <label for="font-family-select" class="block text-xs font-mono text-[#8f8f8f] mb-1 font-semibold">
              Font Family
            </label>
            <select
              id="font-family-select"
              class="w-full rounded-[6px] border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414] px-3 py-2 text-xs font-medium text-[#171717] dark:text-[#ededed] focus:outline-hidden focus:border-[#0070f3] cursor-pointer"
            >
              <option value="times" selected>Times New Roman (Academic)</option>
              <option value="arial">Arial (Modern Sans)</option>
              <option value="calibri">Calibri (Microsoft Word)</option>
              <option value="georgia">Georgia (Editorial Serif)</option>
              <option value="courier">Courier New (Monospaced)</option>
            </select>
          </div>

          <!-- Font Size -->
          <div>
            <label for="font-size-select" class="block text-xs font-mono text-[#8f8f8f] mb-1 font-semibold">
              Font Size
            </label>
            <select
              id="font-size-select"
              class="w-full rounded-[6px] border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414] px-3 py-2 text-xs font-medium text-[#171717] dark:text-[#ededed] focus:outline-hidden focus:border-[#0070f3] cursor-pointer"
            >
              <option value="10">10 pt (Compact)</option>
              <option value="11">11 pt (Modern Word)</option>
              <option value="12" selected>12 pt (College Standard)</option>
              <option value="14">14 pt (Large Print)</option>
            </select>
          </div>

          <!-- Line Spacing -->
          <div>
            <label for="line-spacing-select" class="block text-xs font-mono text-[#8f8f8f] mb-1 font-semibold">
              Line Spacing
            </label>
            <select
              id="line-spacing-select"
              class="w-full rounded-[6px] border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414] px-3 py-2 text-xs font-medium text-[#171717] dark:text-[#ededed] focus:outline-hidden focus:border-[#0070f3] cursor-pointer"
            >
              <option value="1.0">Single Spacing (1.0)</option>
              <option value="1.15">1.15 Spacing (Word Default)</option>
              <option value="1.5">1.5 Line Spacing</option>
              <option value="2.0" selected>Double Spacing (2.0 APA/MLA)</option>
            </select>
          </div>

          <!-- Margin Size -->
          <div>
            <label for="margin-select" class="block text-xs font-mono text-[#8f8f8f] mb-1 font-semibold">
              Margins
            </label>
            <select
              id="margin-select"
              class="w-full rounded-[6px] border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414] px-3 py-2 text-xs font-medium text-[#171717] dark:text-[#ededed] focus:outline-hidden focus:border-[#0070f3] cursor-pointer"
            >
              <option value="1.0" selected>Standard (1.0 inch)</option>
              <option value="0.5">Narrow (0.5 inch)</option>
              <option value="1.5">Wide (1.5 inches)</option>
            </select>
          </div>

        </div>

      </div>

      <!-- Real-Time Output Dashboard -->
      <div class="border-t border-[#ebebeb] dark:border-[#222222] p-6 bg-[#fafafa] dark:bg-[#0e0e0e]">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          
          <!-- Primary Estimated Pages Card -->
          <div class="rounded-[10px] border border-[#0070f3]/30 bg-[#0070f3]/5 dark:bg-[#0070f3]/10 p-5 text-center">
            <div class="mono-eyebrow text-[#0070f3]">Estimated Pages</div>
            <div class="font-mono text-4xl sm:text-5xl font-extrabold text-[#0070f3] mt-2" id="out-pages">
              4.0
            </div>
            <div class="text-xs text-[#0070f3]/80 mt-1 font-mono" id="out-pages-detail">
              ~250 words / page
            </div>
          </div>

          <!-- Opposite Spacing Comparison -->
          <div class="rounded-[10px] border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#141414] p-5 text-center">
            <div class="mono-eyebrow text-[#8f8f8f]" id="out-alt-label">Single-Spaced Equivalent</div>
            <div class="font-mono text-3xl font-bold text-[#171717] dark:text-white mt-2" id="out-alt-pages">
              2.0 pages
            </div>
            <div class="text-xs text-[#8f8f8f] mt-1 font-mono">
              ~500 words / page
            </div>
          </div>

          <!-- Reading Duration -->
          <div class="rounded-[10px] border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#141414] p-5 text-center">
            <div class="mono-eyebrow text-[#8f8f8f]">Silent Reading Time</div>
            <div class="font-mono text-3xl font-bold text-[#171717] dark:text-white mt-2" id="out-reading-time">
              4.4 min
            </div>
            <div class="text-xs text-[#8f8f8f] mt-1 font-mono">
              at 225 wpm
            </div>
          </div>

          <!-- Speech Speaking Duration -->
          <div class="rounded-[10px] border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#141414] p-5 text-center">
            <div class="mono-eyebrow text-[#8f8f8f]">Speaking Presentation</div>
            <div class="font-mono text-3xl font-bold text-[#171717] dark:text-white mt-2" id="out-speaking-time">
              7.7 min
            </div>
            <div class="text-xs text-[#8f8f8f] mt-1 font-mono">
              at 130 wpm
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Quick Reference Conversion Matrix Table -->
    <div class="vercel-card overflow-hidden mb-12">
      <div class="p-4 border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e]">
        <h3 class="text-sm font-semibold text-[#171717] dark:text-white">
          Standard Words to Pages Conversion Reference (12pt Font)
        </h3>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono">
          <thead class="border-b border-[#ebebeb] dark:border-[#222222] bg-black/5 dark:bg-white/5 text-[#8f8f8f]">
            <tr>
              <th class="p-3">Word Count</th>
              <th class="p-3">Single-Spaced (1.0)</th>
              <th class="p-3 text-[#0070f3]">Double-Spaced (2.0)</th>
              <th class="p-3">Reading Duration</th>
              <th class="p-3">Speaking Duration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#ebebeb] dark:divide-[#222222] text-[#4d4d4d] dark:text-[#a1a1a1]">
            <tr class="hover:bg-black/5 dark:hover:bg-white/5">
              <td class="p-3 font-bold text-[#171717] dark:text-white">250 words</td>
              <td class="p-3">0.5 page</td>
              <td class="p-3 text-[#0070f3] font-semibold">1 page</td>
              <td class="p-3">1.1 min</td>
              <td class="p-3">1.9 min</td>
            </tr>
            <tr class="hover:bg-black/5 dark:hover:bg-white/5">
              <td class="p-3 font-bold text-[#171717] dark:text-white">500 words</td>
              <td class="p-3">1 page</td>
              <td class="p-3 text-[#0070f3] font-semibold">2 pages</td>
              <td class="p-3">2.2 min</td>
              <td class="p-3">3.8 min</td>
            </tr>
            <tr class="hover:bg-black/5 dark:hover:bg-white/5">
              <td class="p-3 font-bold text-[#171717] dark:text-white">750 words</td>
              <td class="p-3">1.5 pages</td>
              <td class="p-3 text-[#0070f3] font-semibold">3 pages</td>
              <td class="p-3">3.3 min</td>
              <td class="p-3">5.8 min</td>
            </tr>
            <tr class="hover:bg-black/5 dark:hover:bg-white/5 bg-[#0070f3]/5">
              <td class="p-3 font-bold text-[#0070f3]">1,000 words</td>
              <td class="p-3">2 pages</td>
              <td class="p-3 text-[#0070f3] font-bold">4 pages</td>
              <td class="p-3">4.4 min</td>
              <td class="p-3">7.7 min</td>
            </tr>
            <tr class="hover:bg-black/5 dark:hover:bg-white/5">
              <td class="p-3 font-bold text-[#171717] dark:text-white">1,500 words</td>
              <td class="p-3">3 pages</td>
              <td class="p-3 text-[#0070f3] font-semibold">6 pages</td>
              <td class="p-3">6.7 min</td>
              <td class="p-3">11.5 min</td>
            </tr>
            <tr class="hover:bg-black/5 dark:hover:bg-white/5">
              <td class="p-3 font-bold text-[#171717] dark:text-white">2,000 words</td>
              <td class="p-3">4 pages</td>
              <td class="p-3 text-[#0070f3] font-semibold">8 pages</td>
              <td class="p-3">8.9 min</td>
              <td class="p-3">15.4 min</td>
            </tr>
            <tr class="hover:bg-black/5 dark:hover:bg-white/5">
              <td class="p-3 font-bold text-[#171717] dark:text-white">2,500 words</td>
              <td class="p-3">5 pages</td>
              <td class="p-3 text-[#0070f3] font-semibold">10 pages</td>
              <td class="p-3">11.1 min</td>
              <td class="p-3">19.2 min</td>
            </tr>
            <tr class="hover:bg-black/5 dark:hover:bg-white/5">
              <td class="p-3 font-bold text-[#171717] dark:text-white">5,000 words</td>
              <td class="p-3">10 pages</td>
              <td class="p-3 text-[#0070f3] font-semibold">20 pages</td>
              <td class="p-3">22.2 min</td>
              <td class="p-3">38.5 min</td>
            </tr>
            <tr class="hover:bg-black/5 dark:hover:bg-white/5">
              <td class="p-3 font-bold text-[#171717] dark:text-white">10,000 words</td>
              <td class="p-3">20 pages</td>
              <td class="p-3 text-[#0070f3] font-semibold">40 pages</td>
              <td class="p-3">44.4 min</td>
              <td class="p-3">76.9 min</td>
            </tr>
          </tbody>
        </table>
      <!-- Dedicated Word Count Guides Hub -->
      <div class="mt-8 border-t border-[#ebebeb] dark:border-[#222222] pt-6">
        <div class="mono-eyebrow text-[#0070f3] mb-3">Targeted Word Count Calculators &amp; Specs</div>
        <p class="text-xs text-[#8f8f8f] mb-4">
          Select your target essay or paper length for an instant breakdown of margins, fonts, speaking duration, and paragraph structures:
        </p>
        <div class="flex flex-wrap gap-2">
          {[100, 200, 250, 300, 400, 500, 600, 750, 800, 1000, 1200, 1500, 1750, 2000, 2500, 3000, 3500, 4000, 5000, 7500, 10000].map((num) => (
            <a
              href={`/words-to-pages/${num}-words`}
              class="px-2.5 py-1.5 rounded-[6px] border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414] text-xs font-mono text-[#171717] dark:text-[#ededed] hover:border-[#0070f3] hover:text-[#0070f3] transition"
            >
              {num.toLocaleString()} words →
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Authority Guide, Matrix, Portal Errors, FAQs, and Related Utilities -->
    <ToolAuthoritySection
      toolName="Words to Pages Calculator"
      category="writing"
      currentToolId="words-to-pages"
      guidelinesHeading="Understanding Typographic Page Density & Academic Spacing Rules"
      guidelinesIntro="A standard single-spaced page in 12pt Times New Roman contains approximately 500 words, whereas a double-spaced page (the required format for APA, MLA, and Chicago college papers) yields roughly 250 words per page. Margin widths (1-inch standard vs 0.5-inch compact) and font choice (monospaced Courier vs proportional Calibri) alter total page counts by up to 40%."
    />
  </div>

  <script>
    const wordInput = document.getElementById('word-number-input') as HTMLInputElement;
    const wordSlider = document.getElementById('word-range-slider') as HTMLInputElement;
    const pasteInput = document.getElementById('paste-text-input') as HTMLTextAreaElement;
    const fontSelect = document.getElementById('font-family-select') as HTMLSelectElement;
    const sizeSelect = document.getElementById('font-size-select') as HTMLSelectElement;
    const spacingSelect = document.getElementById('line-spacing-select') as HTMLSelectElement;
    const marginSelect = document.getElementById('margin-select') as HTMLSelectElement;

    const outPages = document.getElementById('out-pages')!;
    const outPagesDetail = document.getElementById('out-pages-detail')!;
    const outAltPages = document.getElementById('out-alt-pages')!;
    const outAltLabel = document.getElementById('out-alt-label')!;
    const outReadingTime = document.getElementById('out-reading-time')!;
    const outSpeakingTime = document.getElementById('out-speaking-time')!;

    const sliderModeBtn = document.getElementById('mode-slider-btn')!;
    const pasteModeBtn = document.getElementById('mode-paste-btn')!;
    const sliderSection = document.getElementById('section-slider-mode')!;
    const pasteSection = document.getElementById('section-paste-mode')!;

    let currentMode = 'slider'; // 'slider' | 'paste'

    // Font density multipliers (relative to Times New Roman 12pt = 1.0)
    const fontFactors: Record<string, number> = {
      times: 1.0,
      arial: 0.90,     // Arial is wider
      calibri: 1.04,   // Calibri is tighter
      georgia: 0.92,   // Georgia is wider
      courier: 0.60    // Courier is monospaced wide
    };

    // Size factors
    const sizeFactors: Record<string, number> = {
      '10': 1.30,
      '11': 1.15,
      '12': 1.00,
      '14': 0.75
    };

    // Margin factors
    const marginFactors: Record<string, number> = {
      '0.5': 1.25, // narrow margins fit more
      '1.0': 1.00, // standard
      '1.5': 0.78  // wide margins fit less
    };

    function calculate() {
      let words = 1000;
      if (currentMode === 'slider') {
        words = parseInt(wordInput.value, 10) || 0;
      } else {
        const text = pasteInput.value.trim();
        words = text ? (text.match(/\S+/g) || []).length : 0;
      }

      const fontKey = fontSelect.value;
      const sizeKey = sizeSelect.value;
      const spacingVal = parseFloat(spacingSelect.value) || 2.0;
      const marginKey = marginSelect.value;

      // Base: 500 words per single-spaced page (spacing = 1.0)
      const baseWordsPerPage = 500;
      const effectiveFactor = (fontFactors[fontKey] || 1.0) * (sizeFactors[sizeKey] || 1.0) * (marginFactors[marginKey] || 1.0);
      
      // Effective words on one page at current spacing
      const wordsPerPage = (baseWordsPerPage * effectiveFactor) / spacingVal;
      const pages = words > 0 ? (words / wordsPerPage) : 0;

      outPages.textContent = pages < 10 ? pages.toFixed(1) : Math.round(pages).toString();
      outPagesDetail.textContent = `~${Math.round(wordsPerPage)} words / page`;

      // Alt spacing calculation
      const isDouble = spacingVal >= 1.75;
      const altSpacing = isDouble ? 1.0 : 2.0;
      const altWordsPerPage = (baseWordsPerPage * effectiveFactor) / altSpacing;
      const altPages = words > 0 ? (words / altWordsPerPage) : 0;
      outAltLabel.textContent = isDouble ? 'Single-Spaced (1.0) Equivalent' : 'Double-Spaced (2.0) Equivalent';
      outAltPages.textContent = `${altPages < 10 ? altPages.toFixed(1) : Math.round(altPages)} pages`;

      // Reading (225 wpm) and Speaking (130 wpm)
      const readMin = words / 225;
      const speakMin = words / 130;
      outReadingTime.textContent = readMin < 1 ? `${Math.round(readMin * 60)} sec` : `${readMin.toFixed(1)} min`;
      outSpeakingTime.textContent = speakMin < 1 ? `${Math.round(speakMin * 60)} sec` : `${speakMin.toFixed(1)} min`;
    }

    // Mode Toggle
    sliderModeBtn.addEventListener('click', () => {
      currentMode = 'slider';
      sliderModeBtn.className = 'px-3 py-1 rounded-[4px] bg-[#171717] dark:bg-white text-white dark:text-black font-semibold transition cursor-pointer';
      pasteModeBtn.className = 'px-3 py-1 rounded-[4px] text-[#8f8f8f] hover:text-[#171717] dark:hover:text-white transition cursor-pointer';
      sliderSection.classList.remove('hidden');
      pasteSection.classList.add('hidden');
      calculate();
    });

    pasteModeBtn.addEventListener('click', () => {
      currentMode = 'paste';
      pasteModeBtn.className = 'px-3 py-1 rounded-[4px] bg-[#171717] dark:bg-white text-white dark:text-black font-semibold transition cursor-pointer';
      sliderModeBtn.className = 'px-3 py-1 rounded-[4px] text-[#8f8f8f] hover:text-[#171717] dark:hover:text-white transition cursor-pointer';
      pasteSection.classList.remove('hidden');
      sliderSection.classList.add('hidden');
      calculate();
    });

    wordInput.addEventListener('input', () => {
      wordSlider.value = wordInput.value;
      calculate();
    });

    wordSlider.addEventListener('input', () => {
      wordInput.value = wordSlider.value;
      calculate();
    });

    pasteInput.addEventListener('input', calculate);
    fontSelect.addEventListener('change', calculate);
    sizeSelect.addEventListener('change', calculate);
    spacingSelect.addEventListener('change', calculate);
    marginSelect.addEventListener('change', calculate);

    calculate();
  </script>
</Layout>
