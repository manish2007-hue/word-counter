---
import Layout from '../../layouts/Layout.astro';
import WordCounter from '../../components/WordCounter.astro';
import ToolAuthoritySection from '../../components/ToolAuthoritySection.astro';

const pageTitle = "X (Twitter) Character Counter – Live 280 Tweet Checker";
const pageDescription = "Count characters for X (Twitter) with real-time 280-character limit feedback, overflow alerts, and thread preview. Fast, accurate, free & 100% private!";
const pageKeywords = "twitter character counter, x character counter, 280 character counter, tweet length checker, check tweet character count";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "X / Twitter Character Counter",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": pageDescription
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the character limit for a standard X (Twitter) post?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For standard accounts, the character ceiling is 280 characters. Premium / X Verified subscribers have an extended ceiling of 25,000 characters."
          }
        },
        {
          "@type": "Question",
          "name": "Do URLs count as 280 characters on Twitter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Twitter uses t.co link wrapping. Every URL counts as 23 characters regardless of its actual character length."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalSlug="character-counter/twitter-x"
  schema={schema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 pb-2 text-center">
    <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] px-3.5 py-1 text-[#171717] dark:text-[#ededed] shadow-2xs mb-3">
      <span class="h-1.5 w-1.5 rounded-full bg-[#171717] dark:bg-white"></span>
      <span>280-Character Microblogging Precision</span>
    </div>
    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
      X / Twitter <span class="vercel-gradient-develop">Character Counter</span>
    </h1>
    <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
      Live 280-character count with real-time overflow highlighting and social feed card simulation.
    </p>
  </div>

  <WordCounter initialTab="social" initialTarget={280} showHeroCopy={false} />

  <!-- Authority Guide, Matrix, Portal Errors, FAQs, and Related Utilities -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-16">
    <ToolAuthoritySection
      toolName="X / Twitter Character Counter"
      category="social"
      currentToolId="social-media-counter"
      guidelinesHeading="Understanding Twitter 280 Limits & t.co Link Wrapping"
      guidelinesIntro="Standard X (Twitter) posts enforce a strict 280-character maximum. All web links automatically consume 23 characters via Twitter's t.co URL shortener regardless of their raw length. Tracking characters in real time avoids awkward truncation or mid-sentence edits."
    />
  </div>
</Layout>
