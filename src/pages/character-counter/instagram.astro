---
import Layout from '../../layouts/Layout.astro';
import WordCounter from '../../components/WordCounter.astro';

const pageTitle = "Instagram Character Counter – 2,200 Caption & 30 Hashtag Limit";
const pageDescription = "Free Instagram character counter. Track the 2,200 character caption limit, 125-character above-the-fold cutoff, and 30 hashtag maximum in real time.";
const pageKeywords = "instagram character counter, instagram caption limit, ig character counter, instagram bio character limit, check instagram caption length";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Instagram Caption & Bio Character Counter",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": pageDescription
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the character limit for Instagram captions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Instagram allows up to 2,200 characters per caption. However, only the first 125 characters appear before the '...more' link in mobile feeds."
          }
        },
        {
          "@type": "Question",
          "name": "How many hashtags can you use on Instagram?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Instagram allows a maximum of 30 hashtags per post or reel. Instagram creators recommend between 3 to 5 targeted hashtags for optimal reach."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalSlug="character-counter/instagram"
  schema={schema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 pb-2 text-center">
    <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] px-3.5 py-1 text-[#0070f3] shadow-2xs mb-3">
      <span class="h-1.5 w-1.5 rounded-full bg-pink-500"></span>
      <span>2,200 Caption &bull; 125 Cutoff &bull; 30 Hashtags</span>
    </div>
    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
      Instagram <span class="vercel-gradient-develop">Character Counter</span>
    </h1>
    <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
      Track caption length against the <strong class="text-[#0070f3] font-mono">2,200 character ceiling</strong> and ensure your hook fits within the critical <strong class="text-[#0070f3] font-mono">125-character</strong> preview.
    </p>
  </div>

  <WordCounter initialTab="social" initialTarget={2200} showHeroCopy={false} />
</Layout>
