---
import Layout from '../layouts/Layout.astro';
import WordCounter from '../components/WordCounter.astro';
import ToolAuthoritySection from '../components/ToolAuthoritySection.astro';

const pageTitle = "Count Words in PDF & DOCX – 100% Private & No Uploads";
const pageDescription = "Count words in PDF & Word (.docx) files without uploading to a server. 100% in-browser processing guarantees total privacy for NDAs, legal & academic docs!";
const pageKeywords = "pdf word counter, docx word counter, count words in pdf without uploading, private word counter, client side docx word counter, legal document word counter";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "CleanWordCounter Private Document Counter",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": pageDescription
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Are my PDF or DOCX files uploaded to external servers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. CleanWordCounter uses in-memory WebAssembly and client-side JavaScript parsers. Your files are decoded directly in your device's RAM and never leave your web browser."
          }
        },
        {
          "@type": "Question",
          "name": "Is CleanWordCounter compliant with NDAs, HIPAA, and confidentiality agreements?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Because there is zero data transmission over the network, using CleanWordCounter preserves full confidentiality for legal contracts, medical transcripts, manuscripts, and proprietary code."
          }
        },
        {
          "@type": "Question",
          "name": "Which file formats can I count words in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can drag and drop or upload PDF (.pdf), Microsoft Word (.docx), Plain Text (.txt), Markdown (.md), and Rich Text (.rtf) files."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalSlug="docx-pdf-word-counter-private"
  schema={schema}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 pb-2 text-center">
    <div class="mono-eyebrow inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] px-3.5 py-1 text-[#0070f3] shadow-2xs mb-3">
      <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
      <span>100% Client-Side In-Memory Parser</span>
    </div>
    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
      Count Words in PDF &amp; DOCX <span class="vercel-gradient-develop">Without Uploading</span>
    </h1>
    <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
      Drag &amp; drop any document to count words, characters, and reading time instantly in browser memory. Zero server transmission.
    </p>
  </div>

  <WordCounter showHeroCopy={false} />

  <!-- Educational & Privacy Architecture Section -->
  <section class="border-t border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#1c1c1c] py-14">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 space-y-8">
      <div class="vercel-card p-6 sm:p-8 space-y-4">
        <div class="mono-eyebrow text-[#0070f3]">Security Architecture</div>
        <h2 class="text-xl sm:text-2xl font-semibold text-[#171717] dark:text-[#ededed]">
          Why Traditional PDF Word Counters Pose Confidentiality Risks
        </h2>
        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Most online word counters require you to upload your PDF or Word documents to their backend cloud servers for OCR or text extraction. If you work in legal defense, medical translation, financial auditing, or corporate journalism, uploading unpublished drafts or client records violates non-disclosure agreements (NDAs) and privacy regulations like GDPR and HIPAA.
        </p>
        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          CleanWordCounter executes client-side parsers (Mozilla pdfjs-dist and in-memory Mammoth DOCX pipelines) directly inside your web browser’s JavaScript sandbox. You can even disconnect your Wi-Fi and the tool will continue counting words flawlessly.
        </p>
      </div>
    </div>
  </section>

  <ToolAuthoritySection
    toolName="Private PDF & DOCX Word Counter"
    category="writing"
    currentToolId="docx-pdf-word-counter-private"
    compatibilityList={["Adobe PDF (.pdf)", "Microsoft Word (.docx)", "Plain Text (.txt)", "Markdown (.md)", "Rich Text (.rtf)", "Google Docs Exports", "HIPAA Compliant", "NDA Safe"]}
    guidelinesHeading="Zero-Knowledge Client-Side Document Analysis"
    guidelinesIntro="Confidential manuscripts, legal contracts, and medical briefs require strict data privacy. Our parser runs entirely in your device's memory without cloud transmission."
    steps={[
      { step: "01", title: "Drop or Select Document", desc: "Drag any PDF or DOCX file directly into the editor viewport or click the upload icon." },
      { step: "02", title: "In-Memory Parsing", desc: "Browser-native WebAssembly and PDF.js parse text streams locally without uploading a single byte." },
      { step: "03", title: "Instant Metric Breakdown", desc: "View total words, character count with/without spaces, estimated pages, and reading duration." }
    ]}
    specsHeading="Document Format & Parser Specifications"
    specsRows={[
      ["Adobe PDF (.pdf)", "pdfjs-dist in-memory text extraction", "No file size limit (RAM dependent)"],
      ["Microsoft Word (.docx)", "XML zip stream decompression", "Formatted text, tables, and lists"],
      ["Plain Text / Markdown (.txt, .md)", "Direct UTF-8 stream reader", "Code snippets and raw markup"],
      ["Privacy & Network Sandbox", "Zero outbound HTTP/WebSocket requests", "100% Offline compatible"]
    ]}
    commonErrors={[
      {
        title: "Scanned Image PDF (Zero Selectable Text)",
        cause: "PDF contains pure raster bitmap scans rather than selectable vector text.",
        fix: "Run local OCR on the document prior to text counting."
      },
      {
        title: "Password-Protected PDF or Encrypted DOCX",
        cause: "Document has user encryption keys blocking client-side reading.",
        fix: "Remove the encryption password before parsing in browser."
      },
      {
        title: "Complex Multi-Column Header/Footer Duplication",
        cause: "Repeated page headers and footers counted on every page.",
        fix: "Inspect extracted text in the editor and trim unwanted recurring margins."
      }
    ]}
    faqs={[
      {
        q: "Are my PDF or DOCX files uploaded to external servers?",
        a: "No. CleanWordCounter uses in-memory WebAssembly and client-side JavaScript parsers. Your files are decoded directly in your device's RAM and never leave your web browser."
      },
      {
        q: "Is CleanWordCounter compliant with NDAs, HIPAA, and confidentiality agreements?",
        a: "Yes. Because there is zero data transmission over the network, using CleanWordCounter preserves full confidentiality for legal contracts, medical transcripts, manuscripts, and proprietary code."
      },
      {
        q: "Which file formats can I count words in?",
        a: "You can drag and drop or upload PDF (.pdf), Microsoft Word (.docx), Plain Text (.txt), Markdown (.md), and Rich Text (.rtf) files."
      },
      {
        q: "Does this tool work completely offline?",
        a: "Yes! Once this web page loads, you can turn off Wi-Fi or disconnect from the internet and parse documents entirely offline."
      }
    ]}
    disclaimerText="All file parsing executes client-side using JavaScript/WebAssembly. Scanned image documents without an embedded text layer require OCR prior to analysis."
  />
</Layout>
