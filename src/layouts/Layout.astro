    <!-- Global Client Logic: Theme, Mobile Menu, PWA, Toast -->
    <script>
      // 1. Theme Management
      const themeBtn = document.getElementById('theme-toggle-btn');
      const sunIcon = document.getElementById('theme-sun-icon');
      const moonIcon = document.getElementById('theme-moon-icon');

      function updateThemeIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          sunIcon?.classList.remove('hidden');
          sunIcon?.classList.add('block');
          moonIcon?.classList.remove('block');
          moonIcon?.classList.add('hidden');
        } else {
          sunIcon?.classList.remove('block');
          sunIcon?.classList.add('hidden');
          moonIcon?.classList.remove('hidden');
          moonIcon?.classList.add('block');
        }
      }

      // Initialize icon state on load
      updateThemeIcons();

      themeBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('cleanwordcounter-theme', isDark ? 'dark' : 'light');
        updateThemeIcons();
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { isDark } }));
      });

      // 2. Mobile Menu Drawer
      const mobileMenuBtn = document.getElementById('mobile-menu-toggle-btn');
      const mobileDrawer = document.getElementById('mobile-nav-drawer');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      mobileMenuBtn?.addEventListener('click', () => {
        const isExpanded = !mobileDrawer?.classList.contains('hidden');
        if (isExpanded) {
          mobileDrawer?.classList.add('hidden');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        } else {
          mobileDrawer?.classList.remove('hidden');
          hamburgerIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        }
      });

      // 2.1 Tools Dropdown Click/Touch Handler
      const toolsBtn = document.getElementById('tools-menu-btn');
      const toolsDropdown = document.getElementById('tools-dropdown-menu');

      toolsBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toolsDropdown?.classList.toggle('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!toolsDropdown?.contains(e.target as Node) && e.target !== toolsBtn) {
          toolsDropdown?.classList.add('hidden');
        }
      });

      // 2.2 Tab Navigation Event Interceptor (SPA smooth scroll on home page)
      document.querySelectorAll('[data-nav-tab]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const tab = (link as HTMLElement).dataset.navTab;
          const analysisSection = document.getElementById('analysis-section');
          if (analysisSection && typeof (window as any).switchAnalysisTab === 'function') {
            e.preventDefault();
            (window as any).switchAnalysisTab(tab);
            analysisSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            // Close mobile drawer and tools dropdown if open
            mobileDrawer?.classList.add('hidden');
            toolsDropdown?.classList.add('hidden');
            hamburgerIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
          }
        });
      });

      // 3. Global Toast Helper
      (window as any).showToast = function(message: string) {
        const toast = document.getElementById('global-toast');
        const toastMsg = document.getElementById('toast-message');
        if (!toast || !toastMsg) return;
        toastMsg.textContent = message;
        toast.classList.remove('hidden', 'animate-toast-out');
        toast.classList.add('animate-toast-in');

        setTimeout(() => {
          toast.classList.remove('animate-toast-in');
          toast.classList.add('animate-toast-out');
          setTimeout(() => toast.classList.add('hidden'), 180);
        }, 2200);
      };

      // 3.0 Command Palette (Cmd+K / Ctrl+K)
      const cmdKModal = document.getElementById('cmd-k-modal');
      const cmdKInput = document.getElementById('cmd-k-input') as HTMLInputElement | null;
      const cmdKTrigger = document.getElementById('cmd-k-trigger');
      const cmdKItems = document.querySelectorAll<HTMLElement>('[data-cmd-item]');
      const cmdKEmpty = document.getElementById('cmd-k-empty');
      let focusedIndex = -1;

      function openCommandPalette() {
        if (!cmdKModal || !cmdKInput) return;
        cmdKModal.classList.remove('hidden');
        cmdKInput.value = '';
        filterCmdItems('');
        cmdKInput.focus();
      }

      function closeCommandPalette() {
        if (!cmdKModal) return;
        cmdKModal.classList.add('hidden');
        focusedIndex = -1;
      }

      function filterCmdItems(query: string) {
        const q = query.trim().toLowerCase();
        let visibleCount = 0;
        const visibleItems: HTMLElement[] = [];

        cmdKItems.forEach((item) => {
          const name = item.dataset.name || '';
          const tags = item.dataset.tags || '';
          const desc = item.dataset.desc || '';
          const matches = !q || name.includes(q) || tags.includes(q) || desc.includes(q);
          if (matches) {
            item.classList.remove('hidden');
            visibleItems.push(item);
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
          item.classList.remove('bg-[#0070f3]/15');
        });

        if (cmdKEmpty) {
          if (visibleCount === 0) cmdKEmpty.classList.remove('hidden');
          else cmdKEmpty.classList.add('hidden');
        }

        focusedIndex = visibleItems.length > 0 ? 0 : -1;
        if (focusedIndex >= 0 && visibleItems[0]) {
          visibleItems[0].classList.add('bg-[#0070f3]/15');
        }
      }

      cmdKTrigger?.addEventListener('click', () => openCommandPalette());
      cmdKModal?.addEventListener('click', (e) => {
        if (e.target === cmdKModal) closeCommandPalette();
      });

      cmdKInput?.addEventListener('input', () => filterCmdItems(cmdKInput.value));

      cmdKInput?.addEventListener('keydown', (e) => {
        const visible = Array.from(cmdKItems).filter((el) => !el.classList.contains('hidden'));
        if (visible.length === 0) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (focusedIndex >= 0 && visible[focusedIndex]) {
            visible[focusedIndex].classList.remove('bg-[#0070f3]/15');
          }
          focusedIndex = (focusedIndex + 1) % visible.length;
          visible[focusedIndex]?.classList.add('bg-[#0070f3]/15');
          visible[focusedIndex]?.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (focusedIndex >= 0 && visible[focusedIndex]) {
            visible[focusedIndex].classList.remove('bg-[#0070f3]/15');
          }
          focusedIndex = (focusedIndex - 1 + visible.length) % visible.length;
          visible[focusedIndex]?.classList.add('bg-[#0070f3]/15');
          visible[focusedIndex]?.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (focusedIndex >= 0 && visible[focusedIndex]) {
            visible[focusedIndex].click();
          }
        }
      });

      // 3.1 Keyboard Shortcuts & Modal Controller
      const shortcutsModal = document.getElementById('shortcuts-modal');
      const shortcutsBtn = document.getElementById('shortcuts-toggle-btn');
      const shortcutsCloseBtn = document.getElementById('btn-close-shortcuts-modal');

      function toggleShortcutsModal(forceState?: boolean) {
        if (!shortcutsModal) return;
        const isHidden = shortcutsModal.classList.contains('hidden');
        const shouldShow = typeof forceState === 'boolean' ? forceState : isHidden;
        if (shouldShow) {
          shortcutsModal.classList.remove('hidden');
        } else {
          shortcutsModal.classList.add('hidden');
        }
      }

      shortcutsBtn?.addEventListener('click', () => toggleShortcutsModal());
      shortcutsCloseBtn?.addEventListener('click', () => toggleShortcutsModal(false));
      shortcutsModal?.addEventListener('click', (e) => {
        if (e.target === shortcutsModal) toggleShortcutsModal(false);
      });

      window.addEventListener('keydown', (e) => {
        const activeEl = document.activeElement;
        const isEditing = activeEl && (
          activeEl.tagName === 'INPUT' ||
          activeEl.tagName === 'TEXTAREA' ||
          (activeEl as HTMLElement).isContentEditable
        );

        // Command Palette: Ctrl+K or Cmd+K
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (cmdKModal && !cmdKModal.classList.contains('hidden')) {
            closeCommandPalette();
          } else {
            openCommandPalette();
          }
          return;
        }

        // Escape always closes any open modal/popover
        if (e.key === 'Escape') {
          if (cmdKModal && !cmdKModal.classList.contains('hidden')) {
            closeCommandPalette();
            return;
          }
          if (shortcutsModal && !shortcutsModal.classList.contains('hidden')) {
            toggleShortcutsModal(false);
            return;
          }
          document.getElementById('popover-reading-speed')?.classList.add('hidden');
          document.getElementById('popover-speaking-speed')?.classList.add('hidden');
          document.getElementById('export-dropdown')?.classList.add('hidden');
          document.getElementById('target-modal')?.classList.add('hidden');
          return;
        }

        // Toggle shortcuts modal: ? (when not typing) or Ctrl+/ / Cmd+/ (anywhere)
        if ((e.key === '?' && !isEditing) || (e.key === '/' && (e.ctrlKey || e.metaKey))) {
          e.preventDefault();
          toggleShortcutsModal();
          return;
        }

        // Alt + D: Toggle theme
        if (e.altKey && e.key.toLowerCase() === 'd') {
          e.preventDefault();
          themeBtn?.click();
          return;
        }

        // Alt + 1..6: Switch analysis tabs
        const tabMap: Record<string, string> = {
          '1': 'keywords',
          '2': 'readability',
          '3': 'social',
          '4': 'academic',
          '5': 'style',
          '6': 'tokens'
        };
        if (e.altKey && tabMap[e.key]) {
          e.preventDefault();
          const tabName = tabMap[e.key];
          if (typeof (window as any).switchAnalysisTab === 'function') {
            (window as any).switchAnalysisTab(tabName);
            const analysisSec = document.getElementById('analysis-section');
            if (analysisSec) {
              analysisSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
          return;
        }

        // Alt + T: New draft tab
        if (e.altKey && e.key.toLowerCase() === 't') {
          e.preventDefault();
          if (typeof (window as any).addNewDocTab === 'function') {
            (window as any).addNewDocTab();
          } else {
            const btnAddDoc = document.getElementById('btn-add-doc');
            btnAddDoc?.click();
          }
          return;
        }

        // Alt + W: Close active draft tab
        if (e.altKey && e.key.toLowerCase() === 'w') {
          e.preventDefault();
          if (typeof (window as any).closeActiveDocTab === 'function') {
            (window as any).closeActiveDocTab();
          }
          return;
        }

        // Alt + C: Clear editor text
        if (e.altKey && e.key.toLowerCase() === 'c') {
          e.preventDefault();
          const btnClear = document.getElementById('btn-clear-text');
          btnClear?.click();
          return;
        }

        // Alt + S: Copy stats
        if (e.altKey && e.key.toLowerCase() === 's') {
          e.preventDefault();
          const btnCopyStats = document.getElementById('btn-copy-stats');
          btnCopyStats?.click();
          return;
        }

        // Alt + E: Toggle export menu
        if (e.altKey && e.key.toLowerCase() === 'e') {
          e.preventDefault();
          const exportBtn = document.getElementById('export-menu-btn');
          exportBtn?.click();
          return;
        }
      });

      // 4. PWA Service Worker Registration with automatic update check
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').then((registration) => {
            registration.update();
          }).catch((err) => {
            console.log('SW registration note:', err);
          });
        });
      }

      // 5. PWA Install Prompt (Available for install prompt events)
      let deferredPrompt: any = null;
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
      });
    </script>
  </body>
</html>
