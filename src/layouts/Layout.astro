---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalSlug?: string;
  ogImage?: string;
  ogType?: string;
  schema?: Record<string, any>;
}

const {
  title = "Word Counter – Free Online Word Counter Tool & Word Count Checker",
  description = "Free online word counter tool and word count checker. Count words, characters, sentences, PDF word count, essay citations, and Google Docs limits in real time.",
  keywords = "word counter, word counter online, word counter free, word counter tool, free word counter, online word counter, essay word counter, word counter google docs, pdf word counter, word counter calculator, word count, word count checker, how to check word count on google docs, word count on google docs, how to see word count on google docs",
  canonicalSlug = '',
  ogImage,
  ogType = 'website',
  schema,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHome = canonicalSlug === '';
const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://cleanwordcounter.com';
const siteUrl = base ? `${siteOrigin}${base}` : siteOrigin;
const cleanSlug = canonicalSlug ? canonicalSlug.replace(/^\/+|\/+$/g, '') : '';
const canonicalUrl = cleanSlug ? `${siteUrl}/${cleanSlug}/` : `${siteUrl}/`;
const ogImageUrl = ogImage || `${siteUrl}/og-image.png`;

const isTool = [
  'clean-text',
  'remove-line-breaks',
  'case-converter',
  'diff-checker',
  'text-diff-checker',
  'words-to-pages',
  'words-to-pages-converter',
  'ai-token-counter',
  'llm-token-counter',
  'readability-checker',
  'flesch-kincaid-readability-calculator',
  'social-media-counter',
  'academic-word-counter',
  'academic-word-counter-without-citations',
  'keyword-density-checker',
  'docx-pdf-word-counter-private',
  'words-to-speaking-time'
].some(slug => canonicalSlug === slug || canonicalSlug.startsWith('character-counter'));

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": ["WebApplication", "SoftwareApplication"],
  "name": "CleanWordCounter",
  "headline": "Free Online Word Counter Tool & Precision Word Count Checker",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "3420"
  },
  "description": description,
  "url": canonicalUrl
};

const finalSchema = schema || defaultSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7HRF4LDK6M"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-7HRF4LDK6M');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/favicon.svg`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <meta name="theme-color" content="#171717" />
    <meta name="author" content="CleanWordCounter" />
    <meta name="application-name" content="CleanWordCounter" />
    <meta name="apple-mobile-web-app-title" content="CleanWordCounter" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Primary Title & Meta Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph Protocols -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="CleanWordCounter" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Google Fonts: Geist Sans & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Schema Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />

    <!-- Theme Initializer (Strict Anti-Flicker Execution) -->
    <script is:inline>
      (function() {
        try {
          const savedTheme = localStorage.getItem('cleanwordcounter-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-[#fafafa] dark:bg-[#000000] text-[#171717] dark:text-[#ededed] antialiased selection:bg-[#0070f3] selection:text-white transition-colors duration-200">
    
    <!-- Top Vercel Geist Sticky Navigation -->
    <header class="sticky top-0 z-50 border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa]/85 dark:bg-[#000000]/85 backdrop-blur-md transition-colors duration-200">
      <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-3 sm:px-6">
        
        <!-- Left Brand Logo -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <a href={`${base}/`} class="group flex items-center gap-2" aria-label="CleanWordCounter Home">
            <Logo size={24} class="transition-transform group-hover:scale-110 active:scale-95" />
            <div class="flex items-center gap-1.5 sm:gap-2">
              <span class="text-[15px] font-semibold tracking-tight text-[#171717] dark:text-[#ededed]">Clean<span class="text-[#0070f3]">WordCounter</span></span>
              <span class="hidden xl:inline-block rounded-[4px] border border-[#ebebeb] dark:border-[#262626] bg-[#f2f2f2] dark:bg-[#141414] px-1.5 py-0.5 font-mono text-[10px] font-medium text-[#8f8f8f] dark:text-[#707070]">
                v1.0
              </span>
            </div>
          </a>
        </div>

        <!-- Center Desktop Nav: Word Counter + Tools ▾ (all tools under it) | About Contact Privacy Terms -->
        <nav aria-label="Main Navigation" class="hidden lg:flex items-center gap-1 xl:gap-2 text-xs xl:text-[13px] font-medium text-[#52525b] dark:text-[#a1a1aa]">
          
          <!-- Primary Tool: Word Counter -->
          <a
            href={`${base}/`}
            class={`whitespace-nowrap px-3 py-1.5 rounded-[6px] transition-colors ${
              canonicalSlug === ''
                ? 'text-[#111111] dark:text-white bg-[#ececee] dark:bg-[#202022] font-semibold shadow-2xs'
                : 'hover:text-[#111111] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5'
            }`}
          >
            Word Counter
          </a>

          <!-- Tools Dropdown Tab: All 10 tools neatly categorized under it -->
          <div class="relative group" id="nav-tools-menu">
            <button
              id="tools-menu-btn"
              type="button"
              class={`flex items-center gap-1.5 px-3 py-1.5 rounded-[6px] transition-colors cursor-pointer ${
                isTool
                  ? 'text-[#111111] dark:text-white bg-[#ececee] dark:bg-[#202022] font-semibold shadow-2xs'
                  : 'hover:text-[#111111] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5'
              }`}
              aria-haspopup="true"
            >
              <span>Tools</span>
              <span class="rounded-full bg-[#0070f3]/10 text-[#0070f3] px-1.5 py-0.2 font-mono text-[10px] font-semibold">10</span>
              <svg class="h-3 w-3 text-[#8f8f8f] transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Dropdown Popover: 2-column Grid with all tools under Tools tab -->
            <div
              id="tools-dropdown-menu"
              class="hidden group-hover:block absolute left-0 top-full pt-2 z-50 w-[540px]"
            >
              <div class="rounded-[12px] border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] p-3 shadow-2xl">
                
                <div class="grid grid-cols-2 gap-2">
                  
                  <!-- Left Column: Text Sanitizing & Editing Tools -->
                  <div class="space-y-1">
                    <div class="px-2 py-1 text-[10px] font-mono uppercase tracking-wider text-[#8f8f8f] font-semibold">
                      Text Sanitizing &amp; Editing
                    </div>

                    <!-- Clean Text Tool -->
                    <a
                      href={`${base}/clean-text`}
                      class="flex items-start gap-2.5 rounded-[8px] p-2 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition"
                    >
                      <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-[6px] bg-[#0070f3]/10 text-[#0070f3]">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                      </div>
                      <div>
                        <div class="text-xs font-semibold text-[#171717] dark:text-[#ededed]">Clean Text &amp; Line Breaks</div>
                        <div class="text-[11px] text-[#8f8f8f] leading-snug">Strip line breaks, double spaces &amp; duplicate lines</div>
                      </div>
                    </a>

                    <!-- Case Converter -->
                    <a
                      href={`${base}/case-converter`}
                      class="flex items-start gap-2.5 rounded-[8px] p-2 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition"
                    >
                      <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-[6px] bg-indigo-500/10 text-indigo-500">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 5v14m4-7h8m-4-7v14" />
                        </svg>
                      </div>
                      <div>
                        <div class="text-xs font-semibold text-[#171717] dark:text-[#ededed]">Case Converter</div>
                        <div class="text-[11px] text-[#8f8f8f] leading-snug">UPPERCASE, lowercase, Title Case &amp; camelCase</div>
                      </div>
                    </a>

                    <!-- Private Text Diff Checker -->
                    <a
                      href={`${base}/diff-checker`}
                      class="flex items-start gap-2.5 rounded-[8px] p-2 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition"
                    >
                      <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-[6px] bg-emerald-500/10 text-emerald-500">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                        </svg>
                      </div>
                      <div>
                        <div class="text-xs font-semibold text-[#171717] dark:text-[#ededed]">Private Text Diff Checker</div>
                        <div class="text-[11px] text-[#8f8f8f] leading-snug">100% confidential document &amp; code comparison</div>
                      </div>
                    </a>

                    <!-- Private PDF & DOCX -->
                    <a
                      href={`${base}/docx-pdf-word-counter-private`}
                      class="flex items-start gap-2.5 rounded-[8px] p-2 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition"
                    >
                      <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-[6px] bg-amber-500/10 text-amber-500">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                      </div>
                      <div>
                        <div class="text-xs font-semibold text-[#171717] dark:text-[#ededed]">Confidential PDF &amp; DOCX</div>
                        <div class="text-[11px] text-[#8f8f8f] leading-snug">In-memory local file text extraction</div>
                      </div>
                    </a>

                    <!-- Keyword Density -->
                    <a
                      href={isHome ? "#analysis-section" : `${base}/keyword-density-checker`}
                      data-nav-tab="keywords"
                      class="flex items-start gap-2.5 rounded-[8px] p-2 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition"
                    >
                      <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-[6px] bg-[#0070f3]/10 text-[#0070f3]">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                        </svg>
                      </div>
                      <div>
                        <div class="text-xs font-semibold text-[#171717] dark:text-[#ededed]">Keyword Density</div>
                        <div class="text-[11px] text-[#8f8f8f] leading-snug">N-gram phrase frequency &amp; SEO density</div>
                      </div>
                    </a>
                  </div>

                  <!-- Right Column: Analytics & Calculators -->
                  <div class="space-y-1">
                    <div class="px-2 py-1 text-[10px] font-mono uppercase tracking-wider text-[#8f8f8f] font-semibold">
                      Analytics &amp; Calculators
                    </div>

                    <!-- AI Token Counter -->
                    <a
                      href={`${base}/ai-token-counter`}
                      class="flex items-start gap-2.5 rounded-[8px] p-2 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition"
                    >
                      <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-[6px] bg-[#0070f3]/10 text-[#0070f3]">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                        </svg>
                      </div>
                      <div>
                        <div class="text-xs font-semibold text-[#171717] dark:text-[#ededed]">AI Token Counter (2020–2026)</div>
                        <div class="text-[11px] text-[#8f8f8f] leading-snug">45+ LLM models, BPE tokenizer &amp; API pricing</div>
                      </div>
                    </a>

                    <!-- Interactive Words to Pages -->
                    <a
                      href={`${base}/words-to-pages`}
                      class="flex items-start gap-2.5 rounded-[8px] p-2 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition"
                    >
                      <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-[6px] bg-blue-500/10 text-blue-500">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                      </div>
                      <div>
                        <div class="text-xs font-semibold text-[#171717] dark:text-[#ededed]">Words to Pages Calculator</div>
                        <div class="text-[11px] text-[#8f8f8f] leading-snug">Interactive page estimator with custom fonts</div>
                      </div>
                    </a>

                    <!-- Readability Formulas -->
                    <a
                      href={isHome ? "#analysis-section" : `${base}/readability-checker`}
                      data-nav-tab="readability"
                      class="flex items-start gap-2.5 rounded-[8px] p-2 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition"
                    >
                      <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-[6px] bg-emerald-500/10 text-emerald-500">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                      </div>
                      <div>
                        <div class="text-xs font-semibold text-[#171717] dark:text-[#ededed]">Readability Formulas</div>
                        <div class="text-[11px] text-[#8f8f8f] leading-snug">Flesch-Kincaid &amp; school reading grade</div>
                      </div>
                    </a>

                    <!-- Social Media Limits -->
                    <a
                      href={isHome ? "#analysis-section" : `${base}/social-media-counter`}
                      data-nav-tab="social"
                      class="flex items-start gap-2.5 rounded-[8px] p-2 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition"
                    >
                      <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-[6px] bg-[#0070f3]/10 text-[#0070f3]">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                        </svg>
                      </div>
                      <div>
                        <div class="text-xs font-semibold text-[#171717] dark:text-[#ededed]">Social Media Limits</div>
                        <div class="text-[11px] text-[#8f8f8f] leading-snug">10 channel limits &amp; SERP feed previews</div>
                      </div>
                    </a>

                    <!-- Academic Mode -->
                    <a
                      href={isHome ? "#analysis-section" : `${base}/academic-word-counter`}
                      data-nav-tab="academic"
                      class="flex items-start gap-2.5 rounded-[8px] p-2 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition"
                    >
                      <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-[6px] bg-purple-500/10 text-purple-500">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                        </svg>
                      </div>
                      <div>
                        <div class="text-xs font-semibold text-[#171717] dark:text-[#ededed]">Academic Essay Mode</div>
                        <div class="text-[11px] text-[#8f8f8f] leading-snug">Exclude APA/MLA citations &amp; references</div>
                      </div>
                    </a>
                  </div>

                </div>

              </div>
            </div>
          </div>

          <!-- Vertical Divider Bar (|) -->
          <span class="h-4 w-px bg-[#e4e4e7] dark:bg-[#27272a] mx-1 shrink-0" aria-hidden="true"></span>

          <!-- Direct Company & SEO Policy Pages: ALWAYS VISIBLE, NEVER CUT OFF -->
          <a
            href={`${base}/about`}
            class={`whitespace-nowrap px-2.5 py-1.5 rounded-[6px] transition-colors ${
              canonicalSlug === 'about'
                ? 'text-[#111111] dark:text-white bg-[#ececee] dark:bg-[#202022] font-semibold shadow-2xs'
                : 'text-[#71717a] dark:text-[#a1a1aa] hover:text-[#111111] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5'
            }`}
          >
            About
          </a>

          <a
            href={`${base}/contact`}
            class={`whitespace-nowrap px-2.5 py-1.5 rounded-[6px] transition-colors ${
              canonicalSlug === 'contact'
                ? 'text-[#111111] dark:text-white bg-[#ececee] dark:bg-[#202022] font-semibold shadow-2xs'
                : 'text-[#71717a] dark:text-[#a1a1aa] hover:text-[#111111] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5'
            }`}
          >
            Contact
          </a>

          <a
            href={`${base}/privacy`}
            class={`whitespace-nowrap px-2.5 py-1.5 rounded-[6px] transition-colors ${
              canonicalSlug === 'privacy' || canonicalSlug === 'privacy-policy'
                ? 'text-[#111111] dark:text-white bg-[#ececee] dark:bg-[#202022] font-semibold shadow-2xs'
                : 'text-[#71717a] dark:text-[#a1a1aa] hover:text-[#111111] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5'
            }`}
          >
            Privacy
          </a>

          <a
            href={`${base}/terms`}
            class={`whitespace-nowrap px-2.5 py-1.5 rounded-[6px] transition-colors ${
              canonicalSlug === 'terms'
                ? 'text-[#111111] dark:text-white bg-[#ececee] dark:bg-[#202022] font-semibold shadow-2xs'
                : 'text-[#71717a] dark:text-[#a1a1aa] hover:text-[#111111] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5'
            }`}
          >
            Terms
          </a>

        </nav>

        <!-- Right Side: Trust Pill & Theme Toggle Controls -->
        <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
          
          <!-- Trust Privacy Pill (Vercel Mono Spec-sheet Badge) -->
          <div class="hidden 2xl:flex items-center gap-1.5 rounded-[6px] border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] px-2.5 py-1 font-mono text-[11px] font-medium text-[#4d4d4d] dark:text-[#a1a1a1]" title="100% Client-Side. Your text never leaves your device.">
