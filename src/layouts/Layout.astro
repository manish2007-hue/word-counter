---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalSlug?: string;
  schema?: Record<string, any>;
}

const {
  title,
  description,
  canonicalSlug = '',
  schema,
} = Astro.props;

const siteUrl = 'https://wordcountr.app';
const canonicalUrl = canonicalSlug ? `${siteUrl}/${canonicalSlug}` : siteUrl;

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "WordCountr",
  "headline": "Free Online Word Counter & Writing Aid",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Web, iOS, macOS, Windows, Android",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "3420"
  },
  "description": description,
  "url": canonicalUrl
};

const finalSchema = schema || defaultSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0066cc" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph & Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="WordCountr" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts: Inter & JetBrains Mono as premium cross-platform fallbacks for SF Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Schema Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />

    <!-- Theme Initializer (Strict Anti-Flicker Execution) -->
    <script is:inline>
      (function() {
        try {
          const savedTheme = localStorage.getItem('wordcountr-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-[#f5f5f7] dark:bg-[#000000] text-[#1d1d1f] dark:text-[#f5f5f7] antialiased selection:bg-[#0066cc] selection:text-white dark:selection:bg-[#2997ff] dark:selection:text-black transition-colors duration-200">
    
    <!-- Top Global Frosted Navigation -->
    <header class="sticky top-0 z-50 border-b border-[#e5e5e7] dark:border-[#2c2c2e] bg-white/80 dark:bg-[#161617]/80 backdrop-blur-xl transition-colors duration-200">
      <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6">
        
        <!-- Left Brand Logo -->
        <div class="flex items-center gap-3">
          <a href="/" class="group flex items-center gap-2.5">
            <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-[#0066cc] text-white font-semibold shadow-xs transition group-hover:scale-105 active:scale-95">
              <span class="font-mono text-base font-bold">W</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-[17px] font-semibold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7]">Word<span class="text-[#0066cc] dark:text-[#2997ff]">Countr</span></span>
              <span class="hidden sm:inline-block rounded-full bg-[#0066cc]/10 dark:bg-[#2997ff]/15 px-2 py-0.5 text-[11px] font-medium text-[#0066cc] dark:text-[#2997ff]">
                Pro
              </span>
            </div>
          </a>
        </div>

        <!-- Center Desktop Nav Links (Apple Segmented Style) -->
        <nav class="hidden lg:flex items-center gap-1 text-[13px] font-medium text-[#515154] dark:text-[#a1a1a6]">
          <a href="/" class={`px-3 py-1.5 rounded-full transition-colors ${canonicalSlug === '' ? 'text-[#0066cc] dark:text-[#2997ff] bg-black/5 dark:bg-white/10 font-semibold' : 'hover:text-[#1d1d1f] dark:hover:text-white'}`}>
            Word Counter
          </a>
          <a href="/social-media-counter" class={`px-3 py-1.5 rounded-full transition-colors ${canonicalSlug === 'social-media-counter' ? 'text-[#0066cc] dark:text-[#2997ff] bg-black/5 dark:bg-white/10 font-semibold' : 'hover:text-[#1d1d1f] dark:hover:text-white'}`}>
            Social Limits
          </a>
          <a href="/readability-checker" class={`px-3 py-1.5 rounded-full transition-colors ${canonicalSlug === 'readability-checker' ? 'text-[#0066cc] dark:text-[#2997ff] bg-black/5 dark:bg-white/10 font-semibold' : 'hover:text-[#1d1d1f] dark:hover:text-white'}`}>
            Readability
          </a>
          <a href="/keyword-density-checker" class={`px-3 py-1.5 rounded-full transition-colors ${canonicalSlug === 'keyword-density-checker' ? 'text-[#0066cc] dark:text-[#2997ff] bg-black/5 dark:bg-white/10 font-semibold' : 'hover:text-[#1d1d1f] dark:hover:text-white'}`}>
            Keyword Density
          </a>
          <a href="/academic-word-counter" class={`px-3 py-1.5 rounded-full transition-colors ${canonicalSlug === 'academic-word-counter' ? 'text-[#0066cc] dark:text-[#2997ff] bg-black/5 dark:bg-white/10 font-semibold' : 'hover:text-[#1d1d1f] dark:hover:text-white'}`}>
            Academic Mode
          </a>
        </nav>

        <!-- Right Side Utility Controls: Privacy Pill, Install PWA, Theme Toggle, Mobile Menu -->
        <div class="flex items-center gap-2">
          
          <!-- Trust Privacy Pill -->
          <div class="hidden sm:flex items-center gap-1.5 rounded-full bg-emerald-500/10 dark:bg-emerald-500/15 px-3 py-1 text-[12px] font-medium text-emerald-700 dark:text-emerald-400 border border-emerald-500/20" title="100% Client-Side. Your text never leaves your device.">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>100% Private</span>
          </div>

          <!-- PWA Install Button -->
          <button id="pwa-install-btn" type="button" class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-[#d2d2d7] dark:border-[#3a3a3c] bg-white dark:bg-[#2c2c2e] px-3 py-1 text-[12px] font-medium text-[#1d1d1f] dark:text-[#f5f5f7] shadow-xs hover:bg-[#f5f5f7] dark:hover:bg-[#38383a] transition apple-button">
            <svg class="h-3.5 w-3.5 text-[#0066cc] dark:text-[#2997ff]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            <span>Install</span>
          </button>

          <!-- Theme Toggle Button (Desktop & Mobile) -->
          <button
            id="theme-toggle-btn"
            type="button"
            aria-label="Toggle Dark/Light Mode"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-[#d2d2d7] dark:border-[#3a3a3c] bg-white dark:bg-[#2c2c2e] text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#f5f5f7] dark:hover:bg-[#38383a] transition apple-button"
          >
            <!-- Sun icon (shown in dark mode) -->
            <svg id="theme-sun-icon" class="h-4 w-4 hidden text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg id="theme-moon-icon" class="h-4 w-4 block text-[#1d1d1f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <!-- Mobile Hamburger Menu Button -->
          <button
            id="mobile-menu-toggle-btn"
            type="button"
            aria-label="Open Navigation Menu"
            class="lg:hidden flex h-9 w-9 items-center justify-center rounded-full border border-[#d2d2d7] dark:border-[#3a3a3c] bg-white dark:bg-[#2c2c2e] text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#f5f5f7] dark:hover:bg-[#38383a] transition apple-button"
          >
            <svg id="hamburger-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="close-icon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>

        </div>
      </div>

      <!-- Mobile Dropdown Navigation Drawer -->
      <div id="mobile-nav-drawer" class="hidden lg:hidden border-t border-[#e5e5e7] dark:border-[#2c2c2e] bg-white/95 dark:bg-[#161617]/95 backdrop-blur-2xl px-4 py-4 transition-all duration-200">
        <div class="flex flex-col space-y-2 text-[15px] font-medium">
          <a href="/" class={`px-3 py-2.5 rounded-xl transition ${canonicalSlug === '' ? 'bg-[#0066cc]/10 dark:bg-[#2997ff]/15 text-[#0066cc] dark:text-[#2997ff] font-semibold' : 'text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-black/5 dark:hover:bg-white/5'}`}>
            Word Counter
          </a>
          <a href="/social-media-counter" class={`px-3 py-2.5 rounded-xl transition ${canonicalSlug === 'social-media-counter' ? 'bg-[#0066cc]/10 dark:bg-[#2997ff]/15 text-[#0066cc] dark:text-[#2997ff] font-semibold' : 'text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-black/5 dark:hover:bg-white/5'}`}>
            Social Media Limits
          </a>
          <a href="/readability-checker" class={`px-3 py-2.5 rounded-xl transition ${canonicalSlug === 'readability-checker' ? 'bg-[#0066cc]/10 dark:bg-[#2997ff]/15 text-[#0066cc] dark:text-[#2997ff] font-semibold' : 'text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-black/5 dark:hover:bg-white/5'}`}>
            Readability & Grade Levels
          </a>
          <a href="/keyword-density-checker" class={`px-3 py-2.5 rounded-xl transition ${canonicalSlug === 'keyword-density-checker' ? 'bg-[#0066cc]/10 dark:bg-[#2997ff]/15 text-[#0066cc] dark:text-[#2997ff] font-semibold' : 'text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-black/5 dark:hover:bg-white/5'}`}>
            Keyword Density Analyzer
          </a>
          <a href="/academic-word-counter" class={`px-3 py-2.5 rounded-xl transition ${canonicalSlug === 'academic-word-counter' ? 'bg-[#0066cc]/10 dark:bg-[#2997ff]/15 text-[#0066cc] dark:text-[#2997ff] font-semibold' : 'text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-black/5 dark:hover:bg-white/5'}`}>
            Academic Mode (Citation Filter)
          </a>
          <a href="/privacy" class="px-3 py-2.5 rounded-xl text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/20 font-medium">
            🔒 Privacy Policy (100% Client-Side)
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Global Floating Toast Notification -->
    <div id="global-toast" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 rounded-full border border-[#d2d2d7] dark:border-[#3a3a3c] bg-white/90 dark:bg-[#1c1c1e]/90 backdrop-blur-xl px-5 py-2.5 text-xs font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] shadow-xl transition-all duration-200">
      <span id="toast-message">✓ Copied to clipboard</span>
    </div>

    <!-- Apple-Style Minimal Parchment Footer -->
    <footer class="border-t border-[#e5e5e7] dark:border-[#2c2c2e] bg-[#f5f5f7] dark:bg-[#161617] py-14 text-[13px] text-[#86868b] transition-colors duration-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 mb-10">
          
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <div class="flex h-6 w-6 items-center justify-center rounded-lg bg-[#0066cc] text-white font-bold text-xs">W</div>
              <span class="text-sm font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]">Word<span class="text-[#0066cc] dark:text-[#2997ff]">Countr</span></span>
            </div>
            <p class="text-xs leading-relaxed text-[#515154] dark:text-[#86868b]">
              The privacy-first writing tool engineered for clarity. Word count, reading time, keyword density, and readability grades computed 100% locally on your device.
            </p>
            <div class="flex items-center gap-1.5 text-xs text-emerald-600 dark:text-emerald-400 font-medium">
              <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
              <span>Zero server logging · 100% browser execution</span>
            </div>
          </div>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-[#1d1d1f] dark:text-[#f5f5f7] mb-3">Precision Tools</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition">Online Word Counter</a></li>
              <li><a href="/social-media-counter" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition">Social Character Limits (X, LinkedIn)</a></li>
              <li><a href="/readability-checker" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition">Readability & Flesch Grade Levels</a></li>
              <li><a href="/keyword-density-checker" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition">Keyword Density & N-Gram Analyzer</a></li>
              <li><a href="/academic-word-counter" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition">Academic Essay Mode (Citation Filter)</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-[#1d1d1f] dark:text-[#f5f5f7] mb-3">Platform Specs</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/social-media-counter" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition">Twitter/X Post (280 chars)</a></li>
              <li><a href="/social-media-counter" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition">LinkedIn Post (3,000 chars)</a></li>
              <li><a href="/social-media-counter" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition">Instagram Caption (2,200 chars)</a></li>
              <li><a href="/social-media-counter" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition">Google SEO Meta Title (60 chars)</a></li>
              <li><a href="/social-media-counter" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition">Google SEO Description (155 chars)</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-[#1d1d1f] dark:text-[#f5f5f7] mb-3">Guarantees</h4>
            <ul class="space-y-2 text-xs text-[#515154] dark:text-[#86868b]">
              <li class="flex items-center gap-1.5">
                <span class="text-[#0066cc] dark:text-[#2997ff]">✓</span> Zero ads in tool viewport
              </li>
              <li class="flex items-center gap-1.5">
                <span class="text-[#0066cc] dark:text-[#2997ff]">✓</span> Full offline functionality (PWA)
              </li>
              <li class="flex items-center gap-1.5">
                <span class="text-[#0066cc] dark:text-[#2997ff]">✓</span> Client-side DOCX & PDF parsing
              </li>
              <li class="flex items-center gap-1.5">
                <span class="text-[#0066cc] dark:text-[#2997ff]">✓</span> Local draft auto-save
              </li>
              <li class="pt-2">
                <a href="/privacy" class="text-[#0066cc] dark:text-[#2997ff] hover:underline font-medium">Read Privacy Guarantee →</a>
              </li>
            </ul>
          </div>

        </div>

        <div class="border-t border-[#e5e5e7] dark:border-[#2c2c2e] pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-[#86868b]">
          <p>© {new Date().getFullYear()} WordCountr. Designed with simplicity, precision, and privacy.</p>
          <div class="flex items-center gap-4 mt-3 sm:mt-0">
            <a href="/privacy" class="hover:text-[#1d1d1f] dark:hover:text-white transition">Privacy Policy</a>
            <span>·</span>
            <a href="/terms" class="hover:text-[#1d1d1f] dark:hover:text-white transition">Terms</a>
            <span>·</span>
            <a href="/about" class="hover:text-[#1d1d1f] dark:hover:text-white transition">About</a>
            <span>·</span>
            <a href="/contact" class="hover:text-[#1d1d1f] dark:hover:text-white transition">Contact</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global Client Logic: Theme, Mobile Menu, PWA, Toast -->
    <script>
      // 1. Theme Management
      const themeBtn = document.getElementById('theme-toggle-btn');
      const sunIcon = document.getElementById('theme-sun-icon');
      const moonIcon = document.getElementById('theme-moon-icon');

      function updateThemeIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          sunIcon?.classList.remove('hidden');
          sunIcon?.classList.add('block');
          moonIcon?.classList.remove('block');
          moonIcon?.classList.add('hidden');
        } else {
          sunIcon?.classList.remove('block');
          sunIcon?.classList.add('hidden');
          moonIcon?.classList.remove('hidden');
          moonIcon?.classList.add('block');
        }
      }

      // Initialize icon state on load
      updateThemeIcons();

      themeBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('wordcountr-theme', isDark ? 'dark' : 'light');
        updateThemeIcons();
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { isDark } }));
      });

      // 2. Mobile Menu Drawer
      const mobileMenuBtn = document.getElementById('mobile-menu-toggle-btn');
      const mobileDrawer = document.getElementById('mobile-nav-drawer');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      mobileMenuBtn?.addEventListener('click', () => {
        const isExpanded = !mobileDrawer?.classList.contains('hidden');
        if (isExpanded) {
          mobileDrawer?.classList.add('hidden');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        } else {
          mobileDrawer?.classList.remove('hidden');
          hamburgerIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        }
      });

      // 3. Global Toast Helper
      (window as any).showToast = function(message: string) {
        const toast = document.getElementById('global-toast');
        const toastMsg = document.getElementById('toast-message');
        if (!toast || !toastMsg) return;
        toastMsg.textContent = message;
        toast.classList.remove('hidden', 'animate-toast-out');
        toast.classList.add('animate-toast-in');

        setTimeout(() => {
          toast.classList.remove('animate-toast-in');
          toast.classList.add('animate-toast-out');
          setTimeout(() => toast.classList.add('hidden'), 200);
        }, 2200);
      };

      // 4. PWA Service Worker Registration
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.log('SW registration note:', err);
          });
        });
      }

      // 5. PWA Install Prompt
      let deferredPrompt: any = null;
      const installBtn = document.getElementById('pwa-install-btn');

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        if (installBtn) {
          installBtn.classList.remove('hidden');
        }
      });

      installBtn?.addEventListener('click', async () => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          installBtn.classList.add('hidden');
        }
        deferredPrompt = null;
      });
    </script>
  </body>
</html>
