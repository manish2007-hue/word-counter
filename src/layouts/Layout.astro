---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { TOOLS_LIST } from '../lib/toolsData';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalSlug?: string;
  ogImage?: string;
  ogType?: string;
  schema?: Record<string, any>;
}

const {
  title = "Free Word Counter – 100% Private, Instant & No Ads",
  description = "Count words, characters, sentences & reading time in real time with zero ads. 100% private in-browser text tool for writers & students. Try it free!",
  keywords = "word counter, free word counter, word count checker, online word counter, private word counter, word counter no ads, essay word counter",
  canonicalSlug = '',
  ogImage,
  ogType = 'website',
  schema,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHome = canonicalSlug === '';
const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://cleanwordcounter.com';
const siteUrl = base ? `${siteOrigin}${base}` : siteOrigin;
const cleanSlug = canonicalSlug ? canonicalSlug.replace(/^\/+|\/+$/g, '') : '';
const canonicalUrl = cleanSlug ? `${siteUrl}/${cleanSlug}/` : `${siteUrl}/`;
const ogImageUrl = ogImage || `${siteUrl}/og-image.png`;

const isTool = [
  'tools',
  'clean-text',
  'remove-line-breaks',
  'case-converter',
  'diff-checker',
  'text-diff-checker',
  'words-to-pages',
  'words-to-pages-converter',
  'ai-token-counter',
  'llm-token-counter',
  'readability-checker',
  'flesch-kincaid-readability-calculator',
  'social-media-counter',
  'academic-word-counter',
  'academic-word-counter-without-citations',
  'keyword-density-checker',
  'docx-pdf-word-counter-private',
  'words-to-speaking-time',
  'website-word-counter',
  'lorem-ipsum-generator',
  'text-repeater',
  'fancy-text-generator',
  'hashtag-generator',
  'json-formatter'
].some(slug => canonicalSlug === slug || canonicalSlug.startsWith('character-counter'));

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": ["WebApplication", "SoftwareApplication"],
  "name": "CleanWordCounter",
  "headline": "Free Online Word Counter Tool & Precision Word Count Checker",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "3420"
  },
  "description": description,
  "url": canonicalUrl
};

const finalSchema = schema || defaultSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7HRF4LDK6M"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-7HRF4LDK6M');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <!-- Favicon & Search Engine App Icons (Googlebot & Browser Standards) -->
    <link rel="icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${base}/favicon-48x48.png`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}/favicon-96x96.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/favicon-192x192.png`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="shortcut icon" href={`${base}/favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <meta name="theme-color" content="#171717" />
    <meta name="author" content="CleanWordCounter" />
    <meta name="application-name" content="CleanWordCounter" />
    <meta name="apple-mobile-web-app-title" content="CleanWordCounter" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Primary Title & Meta Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph Protocols -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="CleanWordCounter" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Google Fonts: Geist Sans & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Schema Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />

    <!-- Theme Initializer (Strict Anti-Flicker Execution) -->
    <script is:inline>
      (function() {
        try {
          const savedTheme = localStorage.getItem('cleanwordcounter-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-[#fafafa] dark:bg-[#000000] text-[#171717] dark:text-[#ededed] antialiased selection:bg-[#171717] selection:text-white dark:selection:bg-white dark:selection:text-black transition-colors duration-150">
    
    <!-- Top Vercel Sticky Navigation -->
    <header class="sticky top-0 z-50 border-b border-[#ebebeb] dark:border-[#262626] bg-white/90 dark:bg-[#000000]/90 backdrop-blur-md transition-colors duration-150">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-3 sm:px-6">
        
        <!-- Left Brand Logo -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <a href={`${base}/`} class="group flex items-center gap-2" aria-label="CleanWordCounter Home">
            <Logo size={24} class="transition-transform group-hover:scale-105 active:scale-95" />
            <div class="flex items-center gap-1.5 sm:gap-2">
              <span class="text-[15px] font-semibold tracking-tight text-[#171717] dark:text-[#ededed]">Clean<span class="text-[#0070f3]">WordCounter</span></span>
              <span class="hidden xl:inline-block rounded-[4px] border border-[#ebebeb] dark:border-[#262626] bg-[#f5f5f5] dark:bg-[#141414] px-1.5 py-0.5 font-mono text-[10px] font-medium text-[#888888] dark:text-[#707070]">
                v1.0
              </span>
            </div>
          </a>
        </div>

        <!-- Center Desktop Nav: Word Counter + Tools ▾ (all tools under it) | About Contact Privacy Terms -->
        <nav aria-label="Main Navigation" class="hidden lg:flex items-center gap-1 xl:gap-2 text-xs xl:text-[13px] font-medium text-[#4d4d4d] dark:text-[#a1a1a1]">
          
          <!-- Primary Tool: Word Counter -->
          <a
            href={`${base}/`}
            class={`whitespace-nowrap px-3 py-1.5 rounded-[6px] transition-colors ${
              canonicalSlug === ''
                ? 'text-[#171717] dark:text-white bg-[#f0f0f0] dark:bg-[#1c1c1c] font-semibold'
                : 'hover:text-[#171717] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5'
            }`}
          >
            Word Counter
          </a>

          <!-- Tools Dropdown Tab: All 25 tools neatly categorized under it -->
          <div class="relative group" id="nav-tools-menu">
            <a
              href={`${base}/tools`}
              id="tools-menu-btn"
              class={`flex items-center gap-1.5 px-3 py-1.5 rounded-[6px] transition-colors cursor-pointer ${
                isTool
                  ? 'text-[#171717] dark:text-white bg-[#f0f0f0] dark:bg-[#1c1c1c] font-semibold'
                  : 'hover:text-[#171717] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5'
              }`}
              aria-haspopup="true"
            >
              <span>Tools</span>
              <span class="rounded-full bg-black/5 dark:bg-white/10 text-[#171717] dark:text-white px-1.5 py-0.2 font-mono text-[10px] font-semibold">29</span>
              <svg class="h-3 w-3 text-[#888888] transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>

            <!-- Dropdown Popover: 4-column Grid with all 25 tools under Tools tab -->
            <div
              id="tools-dropdown-menu"
              class="hidden group-hover:block absolute left-0 top-full pt-2 z-50 w-[920px]"
            >
              <div class="rounded-[12px] border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] p-3.5 shadow-2xl">
                
                <div class="grid grid-cols-4 gap-3">
                  
                  <!-- Column 1: Writing & Analysis -->
                  <div class="space-y-1">
                    <div class="px-2 py-1 text-[10px] font-mono uppercase tracking-wider text-[#0070f3] font-semibold">
                      Writing &amp; Analysis
                    </div>

                    <a href={`${base}/`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
                      <span>Word Counter</span>
                    </a>
                    <a href={`${base}/academic-word-counter`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-purple-500"></span>
                      <span>Academic Essay Mode</span>
                    </a>
                    <a href={`${base}/words-to-pages`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
                      <span>Words to Pages</span>
                    </a>
                    <a href={`${base}/words-to-speaking-time`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                      <span>Words to Speaking Time</span>
                    </a>
                    <a href={`${base}/readability-checker`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                      <span>Readability Checker</span>
                    </a>
                    <a href={`${base}/docx-pdf-word-counter-private`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                      <span>Private PDF &amp; DOCX</span>
                    </a>
                  </div>

                  <!-- Column 2: Cleaning & Formatting -->
                  <div class="space-y-1">
                    <div class="px-2 py-1 text-[10px] font-mono uppercase tracking-wider text-purple-500 font-semibold">
                      Cleaning &amp; Formatting
                    </div>

                    <a href={`${base}/clean-text`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
                      <span>Clean Text &amp; Spaces</span>
                    </a>
                    <a href={`${base}/remove-line-breaks`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
                      <span>Remove Line Breaks</span>
                    </a>
                    <a href={`${base}/case-converter`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
                      <span>Case Converter</span>
                    </a>
                    <a href={`${base}/diff-checker`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                      <span>Private Diff Checker</span>
                    </a>
                    <a href={`${base}/keyword-density-checker`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
                      <span>Keyword Density</span>
                    </a>
                    <a href={`${base}/website-word-counter`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
                      <span>Website Word Counter</span>
                    </a>
                  </div>

                  <!-- Column 3: Generators & Developer -->
                  <div class="space-y-1">
                    <div class="px-2 py-1 text-[10px] font-mono uppercase tracking-wider text-emerald-500 font-semibold">
                      Generators &amp; Code
                    </div>

                    <a href={`${base}/lorem-ipsum-generator`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                      <span>Lorem Ipsum Generator</span>
                      <span class="text-[9px] font-mono text-emerald-600 bg-emerald-500/10 px-1 rounded ml-auto">NEW</span>
                    </a>
                    <a href={`${base}/text-repeater`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                      <span>Text Repeater</span>
                      <span class="text-[9px] font-mono text-emerald-600 bg-emerald-500/10 px-1 rounded ml-auto">NEW</span>
                    </a>
                    <a href={`${base}/fancy-text-generator`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                      <span>Fancy Text Generator</span>
                      <span class="text-[9px] font-mono text-emerald-600 bg-emerald-500/10 px-1 rounded ml-auto">NEW</span>
                    </a>
                    <a href={`${base}/qr-code-generator`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                      <span>QR Code Generator</span>
                      <span class="text-[9px] font-mono text-emerald-600 bg-emerald-500/10 px-1 rounded ml-auto">NEW</span>
                    </a>
                    <a href={`${base}/json-formatter`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-cyan-500"></span>
                      <span>JSON Formatter &amp; Lint</span>
                      <span class="text-[9px] font-mono text-cyan-600 bg-cyan-500/10 px-1 rounded ml-auto">NEW</span>
                    </a>
                    <a href={`${base}/base64-converter`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-cyan-500"></span>
                      <span>Base64 Converter</span>
                      <span class="text-[9px] font-mono text-cyan-600 bg-cyan-500/10 px-1 rounded ml-auto">NEW</span>
                    </a>
                    <a href={`${base}/hashtag-generator`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                      <span>Hashtag Generator</span>
                      <span class="text-[9px] font-mono text-amber-600 bg-amber-500/10 px-1 rounded ml-auto">NEW</span>
                    </a>
                    <a href={`${base}/ai-token-counter`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-cyan-500"></span>
                      <span>AI LLM Token Counter</span>
                    </a>
                  </div>

                  <!-- Column 4: Image & PDF Tools (Pi7 Suite) -->
                  <div class="space-y-1">
                    <div class="px-2 py-1 text-[10px] font-mono uppercase tracking-wider text-sky-500 font-semibold flex items-center justify-between">
                      <span>Image &amp; PDF Tools</span>
                      <span class="text-[9px] bg-sky-500/10 text-sky-600 dark:text-sky-400 px-1 rounded">PI7 SUITE</span>
                    </div>

                    <a href={`${base}/compress-image`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span>
                      <span>Target Compressor</span>
                    </a>
                    <a href={`${base}/resize-image`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span>
                      <span>Passport &amp; Resizer</span>
                    </a>
                    <a href={`${base}/merge-pdf`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span>
                      <span>Merge PDF Files</span>
                      <span class="text-[9px] font-mono text-emerald-600 bg-emerald-500/10 px-1 rounded ml-auto">NEW</span>
                    </a>
                    <a href={`${base}/split-pdf`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span>
                      <span>Split PDF Pages</span>
                      <span class="text-[9px] font-mono text-emerald-600 bg-emerald-500/10 px-1 rounded ml-auto">NEW</span>
                    </a>
                    <a href={`${base}/image-to-pdf`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span>
                      <span>Image to PDF</span>
                    </a>
                    <a href={`${base}/pdf-to-jpg`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span>
                      <span>PDF to JPG Converter</span>
                    </a>
                    <a href={`${base}/image-converter`} class="flex items-center gap-2 rounded-[6px] p-1.5 hover:bg-[#fafafa] dark:hover:bg-[#141414] transition text-xs font-medium text-[#171717] dark:text-[#ededed]">
                      <span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span>
                      <span>Format Converter</span>
                    </a>
                  </div>

                </div>

                <!-- Bottom Banner: Browse All 29 Tools on Dashboard -->
                <div class="mt-3 pt-2.5 border-t border-[#ebebeb] dark:border-[#222222] flex items-center justify-between px-2">
                  <span class="text-[11px] text-[#8a8f98]">100% Client-Side • Zero Server Tracking</span>
                  <a
                    href={`${base}/tools`}
                    class="text-xs font-semibold text-[#0070f3] hover:underline flex items-center gap-1"
                  >
                    <span>Browse All 29 Tools on Dashboard</span>
                    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>

              </div>
            </div>
          </div>

          <!-- Vertical Divider Bar (|) -->
          <span class="h-4 w-px bg-[#e4e4e7] dark:bg-[#27272a] mx-1 shrink-0" aria-hidden="true"></span>

          <!-- Direct Company & SEO Policy Pages: ALWAYS VISIBLE, NEVER CUT OFF -->
          <a
            href={`${base}/blog`}
