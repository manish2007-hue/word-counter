---
// How CleanWordCounter Compares Feature Comparison Table - Nuanced Architectural Benchmark
interface FeatureRow {
  capability: string;
  cleanwordcounter: { text: string; highlight?: boolean };
  wordcounterNet: { text: string; positive?: boolean };
  hemingway: { text: string; positive?: boolean };
  grammarly: { text: string; positive?: boolean };
}

const features: FeatureRow[] = [
  {
    capability: "Data Privacy & Telemetry",
    cleanwordcounter: { text: "100% Local (Zero Network Calls)", highlight: true },
    wordcounterNet: { text: "Ad-Tracked & Analytics Cookies", positive: false },
    hemingway: { text: "Web Cloud / Desktop Local ($)", positive: false },
    grammarly: { text: "Cloud Storage & AI Training", positive: false },
  },
  {
    capability: "Ad-Free Writing Viewport",
    cleanwordcounter: { text: "100% Ad-Free (Zero Popups)", highlight: true },
    wordcounterNet: { text: "Heavy Banner & Video Ads", positive: false },
    hemingway: { text: "Ad-Free Interface", positive: true },
    grammarly: { text: "In-App Upgrade Modals", positive: false },
  },
  {
    capability: "In-Memory .DOCX & .PDF Parsing",
    cleanwordcounter: { text: "Native Client-Side WebAssembly", highlight: true },
    wordcounterNet: { text: "Not Supported", positive: false },
    hemingway: { text: "Plain Text / Markdown Only", positive: false },
    grammarly: { text: "Server-Side Upload Required", positive: false },
  },
  {
    capability: "Academic Citation Exclusion",
    cleanwordcounter: { text: "Auto-Filters APA/MLA Citations", highlight: true },
    wordcounterNet: { text: "Not Supported", positive: false },
    hemingway: { text: "Not Supported", positive: false },
    grammarly: { text: "Plagiarism Suite Only (Paid)", positive: false },
  },
  {
    capability: "Keyword Density & N-Grams",
    cleanwordcounter: { text: "1–3 Word N-Grams + Stopwords", highlight: true },
    wordcounterNet: { text: "1–3 Word N-Grams (Basic)", positive: true },
    hemingway: { text: "Not Supported", positive: false },
    grammarly: { text: "Not Supported", positive: false },
  },
  {
    capability: "Multi-Formula Readability",
    cleanwordcounter: { text: "4 Standard Consensus Formulas", highlight: true },
    wordcounterNet: { text: "Flesch Reading Ease Only", positive: false },
    hemingway: { text: "Automated Readability Index", positive: true },
    grammarly: { text: "Proprietary Clarity Index", positive: true },
  },
  {
    capability: "Style & Quality Audit",
    cleanwordcounter: { text: "Passive Voice + Filler Detection", highlight: true },
    wordcounterNet: { text: "Basic Thesaurus Only", positive: false },
    hemingway: { text: "Adverbs, Passive, Weak Words", positive: true },
    grammarly: { text: "Deep Grammar & Tone Checks", positive: true },
  },
  {
    capability: "Live Social & SERP Truncation",
    cleanwordcounter: { text: "10 Channels + SERP Snippet Preview", highlight: true },
    wordcounterNet: { text: "Character Counter Only", positive: false },
    hemingway: { text: "Not Supported", positive: false },
    grammarly: { text: "Character Counter Only", positive: false },
  },
  {
    capability: "Offline PWA Capability",
    cleanwordcounter: { text: "Full Progressive Web App (Offline)", highlight: true },
    wordcounterNet: { text: "Online Only (Ad-Dependent)", positive: false },
    hemingway: { text: "Paid Desktop App ($19.99)", positive: false },
    grammarly: { text: "Online Only (Requires Cloud)", positive: false },
  },
  {
    capability: "Draft Storage Architecture",
    cleanwordcounter: { text: "Instant Local Storage / Multi-Tab", highlight: true },
    wordcounterNet: { text: "Volatile Browser Cookies", positive: false },
    hemingway: { text: "Local Files (Desktop Version)", positive: true },
    grammarly: { text: "Cloud Account Sync", positive: true },
  },
];
---

<div class="vercel-card p-6 sm:p-10 transition-colors">
  
  <div class="mb-6">
    <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070] mb-2">Architectural Benchmark</div>
    <h2 class="text-2xl sm:text-3xl font-semibold text-[#171717] dark:text-[#ededed] tracking-[-0.04em]">
      How CleanWordCounter Compares
    </h2>
    <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] mt-1 font-mono">
      Nuanced technical comparison against popular writing and readability tools.
    </p>
  </div>

  <div class="overflow-x-auto -mx-2 sm:mx-0 rounded-[8px] border border-[#ebebeb] dark:border-[#222222]">
    <table class="w-full text-left text-xs sm:text-sm border-collapse min-w-[700px]">
      <thead>
        <tr class="border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e] text-[#8f8f8f] font-mono">
          <th class="py-3 px-4 font-medium w-[24%]">CAPABILITY</th>
          <th class="py-3 px-4 font-semibold text-[#0070f3] bg-[#0070f3]/5 dark:bg-[#0070f3]/10 w-[24%]">
            CleanWordCounter
          </th>
          <th class="py-3 px-3 font-medium text-[#4d4d4d] dark:text-[#a1a1a1] text-center w-[18%]">WordCounter.net</th>
          <th class="py-3 px-3 font-medium text-[#4d4d4d] dark:text-[#a1a1a1] text-center w-[17%]">Hemingway Editor</th>
          <th class="py-3 px-3 font-medium text-[#4d4d4d] dark:text-[#a1a1a1] text-center w-[17%]">Grammarly Free</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#ebebeb] dark:divide-[#222222]">
        {features.map((f) => (
          <tr class="hover:bg-black/5 dark:hover:bg-white/5 transition">
            <td class="py-3 px-4 font-medium text-[#171717] dark:text-[#ededed] text-xs">
              {f.capability}
            </td>

            <td class="py-3 px-4 bg-[#0070f3]/5 dark:bg-[#0070f3]/10 text-[#0070f3] font-semibold text-xs">
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-flex items-center justify-center h-4 w-4 rounded-full bg-[#0070f3]/20 text-[#0070f3] text-[10px]">✓</span>
                <span>{f.cleanwordcounter.text}</span>
              </span>
            </td>

            <td class="py-3 px-3 text-center text-xs">
              <span class={`inline-block px-2 py-0.5 rounded-[4px] text-[11px] font-mono ${
                f.wordcounterNet.positive 
                  ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20' 
                  : 'bg-[#fafafa] dark:bg-[#141414] text-[#8f8f8f] border border-[#ebebeb] dark:border-[#222222]'
              }`}>
                {f.wordcounterNet.text}
              </span>
            </td>

            <td class="py-3 px-3 text-center text-xs">
              <span class={`inline-block px-2 py-0.5 rounded-[4px] text-[11px] font-mono ${
                f.hemingway.positive 
                  ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20' 
                  : 'bg-[#fafafa] dark:bg-[#141414] text-[#8f8f8f] border border-[#ebebeb] dark:border-[#222222]'
              }`}>
                {f.hemingway.text}
              </span>
            </td>

            <td class="py-3 px-3 text-center text-xs">
              <span class={`inline-block px-2 py-0.5 rounded-[4px] text-[11px] font-mono ${
                f.grammarly.positive 
                  ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20' 
                  : 'bg-[#fafafa] dark:bg-[#141414] text-[#8f8f8f] border border-[#ebebeb] dark:border-[#222222]'
              }`}>
                {f.grammarly.text}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
