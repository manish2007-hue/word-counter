---
// How WordCountr Compares Feature Comparison Table
const features = [
  {
    capability: "Privacy (100% Client-Side)",
    wordcountr: true,
    wordcounterNet: false,
    quillbot: false,
    semrush: false,
  },
  {
    capability: "Offline & PWA Capability",
    wordcountr: true,
    wordcounterNet: false,
    quillbot: false,
    semrush: false,
  },
  {
    capability: "Ad-Free Writing Viewport",
    wordcountr: true,
    wordcounterNet: false,
    quillbot: true,
    semrush: true,
  },
  {
    capability: "Word Budget / Target Bar",
    wordcountr: true,
    wordcounterNet: false,
    quillbot: false,
    semrush: false,
  },
  {
    capability: "Direct .DOCX & .PDF Upload",
    wordcountr: true,
    wordcounterNet: false,
    quillbot: false,
    semrush: false,
  },
  {
    capability: "Academic Citation Exclusion",
    wordcountr: true,
    wordcounterNet: false,
    quillbot: false,
    semrush: false,
  },
  {
    capability: "Live Social Limits Dashboard",
    wordcountr: true,
    wordcounterNet: false,
    quillbot: false,
    semrush: false,
  },
  {
    capability: "Multi-Formula Readability",
    wordcountr: true,
    wordcounterNet: true,
    quillbot: false,
    semrush: true,
  },
  {
    capability: "Free Keyword Density Checker",
    wordcountr: true,
    wordcounterNet: true,
    quillbot: false,
    semrush: true,
  },
  {
    capability: "Auto-Save & Session Recovery",
    wordcountr: true,
    wordcounterNet: false,
    quillbot: false,
    semrush: false,
  },
];
---

<div class="vercel-card p-6 sm:p-10 transition-colors">
  
  <div class="mb-6">
    <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070] mb-2">Architectural Benchmark</div>
    <h2 class="text-2xl sm:text-3xl font-semibold text-[#171717] dark:text-[#ededed] tracking-[-0.04em]">
      How WordCountr Compares
    </h2>
    <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] mt-1 font-mono">
      Feature matrix versus legacy ad-network word counters.
    </p>
  </div>

  <div class="overflow-x-auto -mx-2 sm:mx-0 rounded-[8px] border border-[#ebebeb] dark:border-[#222222]">
    <table class="w-full text-left text-xs sm:text-sm border-collapse min-w-[620px]">
      <thead>
        <tr class="border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e] text-[#8f8f8f] font-mono">
          <th class="py-3 px-4 font-medium w-2/5">CAPABILITY</th>
          <th class="py-3 px-5 font-semibold text-[#0070f3] bg-[#0070f3]/5 dark:bg-[#0070f3]/10 w-1/5">
            WordCountr
          </th>
          <th class="py-3 px-4 font-medium text-[#4d4d4d] dark:text-[#a1a1a1] text-center w-1/5">WordCounter.net</th>
          <th class="py-3 px-4 font-medium text-[#4d4d4d] dark:text-[#a1a1a1] text-center w-1/5">QuillBot</th>
          <th class="py-3 px-4 font-medium text-[#4d4d4d] dark:text-[#a1a1a1] text-center w-1/5">Semrush</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#ebebeb] dark:divide-[#222222]">
        {features.map((f) => (
          <tr class="hover:bg-black/5 dark:hover:bg-white/5 transition">
            <td class="py-3 px-4 font-medium text-[#171717] dark:text-[#ededed]">
              {f.capability}
            </td>

            <td class="py-3 px-5 text-center bg-[#0070f3]/5 dark:bg-[#0070f3]/10 font-bold text-[#0070f3]">
              <span class="inline-flex items-center justify-center h-5 w-5 rounded-[4px] bg-[#0070f3]/15 text-[#0070f3] font-bold text-xs">
                ✓
              </span>
            </td>

            <td class="py-3 px-4 text-center">
              {f.wordcounterNet ? (
                <span class="text-[#0070f3] font-bold">✓</span>
              ) : (
                <span class="text-[#8f8f8f] font-mono">✕</span>
              )}
            </td>

            <td class="py-3 px-4 text-center">
              {f.quillbot ? (
                <span class="text-[#0070f3] font-bold">✓</span>
              ) : (
                <span class="text-[#8f8f8f] font-mono">✕</span>
              )}
            </td>

            <td class="py-3 px-4 text-center">
              {f.semrush ? (
                <span class="text-[#0070f3] font-bold">✓</span>
              ) : (
                <span class="text-[#8f8f8f] font-mono">✕</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
