              <span class="font-mono text-[10px] text-[#8f8f8f]">.txt</span>
            </button>
            <button class="export-opt w-full flex items-center justify-between rounded-[4px] px-2.5 py-1.5 text-left text-[#171717] dark:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#171717] transition cursor-pointer" data-export="md">
