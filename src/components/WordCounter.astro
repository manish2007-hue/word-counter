      `• Characters (without spaces): ${metrics.charactersNoSpaces.toLocaleString()}\n` +
      `• Sentences: ${metrics.sentences.toLocaleString()}\n` +
      `• Paragraphs: ${metrics.paragraphs.toLocaleString()}\n` +
      `• Reading Time: ${metrics.readingTimeFormatted}\n` +
      `• Speaking Time: ${metrics.speakingTimeFormatted}`;

    copyToClipboard(summary, '✓ Copied statistics to clipboard');
  });

  btnCopyText?.addEventListener('click', () => {
    if (!textarea.value.trim()) {
      notify('Editor is empty');
      return;
    }
    copyToClipboard(textarea.value, '✓ Copied text to clipboard');
  });

  let clearConfirmActive = false;
  let clearTimer: any = null;
  btnClearText?.addEventListener('click', () => {
    if (!textarea.value.trim()) return;

    if (!clearConfirmActive) {
      clearConfirmActive = true;
      btnClearText.innerHTML = `<span>Sure? Tap again</span>`;
      clearTimer = setTimeout(() => {
        clearConfirmActive = false;
        btnClearText.innerHTML = `
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          <span>Clear</span>
        `;
      }, 3000);
    } else {
      clearTimeout(clearTimer);
      clearConfirmActive = false;
      textarea.value = '';
      localStorage.removeItem('cleanwordcounter-draft');
      updateAll();
      textarea.focus();
      btnClearText.innerHTML = `
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        <span>Clear</span>
      `;
      notify('Editor cleared');
    }
  });

  // Explicit File Upload Trigger
  btnTriggerUpload?.addEventListener('click', () => {
    fileInput?.click();
  });

  fileInput?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    try {
      notify(`Parsing ${file.name}...`);
      autosaveLabel.textContent = `Parsing ${file.name}...`;
      const extracted = await parseUploadedFile(file);
      textarea.value = extracted;
      updateAll();
      autosaveLabel.textContent = `Loaded ${file.name}`;
      notify(`✓ Loaded ${file.name}`);
    } catch (err: any) {
      alert(`File parse error: ${err.message}`);
      autosaveLabel.textContent = 'File parse error';
    } finally {
      fileInput.value = '';
    }
  });

  // Drag & drop on container
  window.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropOverlay?.classList.remove('hidden');
  });
  window.addEventListener('dragleave', (e) => {
    if (e.relatedTarget === null) {
      dropOverlay?.classList.add('hidden');
    }
  });
  window.addEventListener('drop', async (e) => {
    e.preventDefault();
    dropOverlay?.classList.add('hidden');
    const file = e.dataTransfer?.files?.[0];
    if (file) {
      try {
        notify(`Parsing ${file.name}...`);
        autosaveLabel.textContent = `Parsing ${file.name}...`;
        const extracted = await parseUploadedFile(file);
        textarea.value = extracted;
        updateAll();
        autosaveLabel.textContent = `Loaded ${file.name}`;
        notify(`✓ Loaded ${file.name}`);
      } catch (err: any) {
        alert(`File parse error: ${err.message}`);
        autosaveLabel.textContent = 'File parse error';
      }
    }
  });

  // Initial calculation on mount
  updateAll();

  // If restored from saved draft, notify user
  if (restoredSession && savedText && savedText.trim().length > 0) {
    setTimeout(() => {
      notify('✓ Draft restored from previous session');
    }, 400);
  }
</script>
