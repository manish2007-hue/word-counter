    </div>

    <!-- PROOF READ AUDIO CONTROLS BAR (Browser-Native Text-To-Speech) -->
    <div id="proof-read-bar" class="hidden border-b border-[#ebebeb] dark:border-[#222222] bg-[#f0f9ff] dark:bg-[#081b2e] px-3 sm:px-4 py-2 text-xs">
