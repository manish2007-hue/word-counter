    }
  });

  // Social view toggle (10 Platform Grid vs Feed & SERP Previews)
  btnSocialViewGrid?.addEventListener('click', () => {
    socialGrid.classList.remove('hidden');
    socialPreviewsContainer?.classList.add('hidden');
    btnSocialViewGrid.className = 'px-2.5 py-1 rounded-[6px] bg-[#171717] text-white dark:bg-white dark:text-black font-medium transition cursor-pointer';
    if (btnSocialViewPreviews) {
      btnSocialViewPreviews.className = 'px-2.5 py-1 rounded-[6px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white font-medium transition cursor-pointer';
    }
  });

  btnSocialViewPreviews?.addEventListener('click', () => {
    socialGrid.classList.add('hidden');
    socialPreviewsContainer?.classList.remove('hidden');
    btnSocialViewPreviews.className = 'px-2.5 py-1 rounded-[6px] bg-[#171717] text-white dark:bg-white dark:text-black font-medium transition cursor-pointer';
    if (btnSocialViewGrid) {
      btnSocialViewGrid.className = 'px-2.5 py-1 rounded-[6px] border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white font-medium transition cursor-pointer';
    }
  });

  function updateAll() {
    if (!textarea) return;
    const text = textarea.value;

    // Check academic mode filtering
    let textToAnalyze = text;
    if (academicModeEnabled) {
      const acad = filterAcademicText(text);
      textToAnalyze = acad.cleanedText;
      acadGrossWords.textContent = acad.originalWords.toLocaleString();
      acadNetWords.textContent = acad.filteredWords.toLocaleString();
      acadExcludedWords.textContent = acad.excludedWords.toLocaleString();
      acadExcludedDesc.textContent = `${acad.inTextCitationsCount} in-text citations · ${acad.referencesWordCount} reference words`;
    } else {
      const acad = filterAcademicText(text);
      acadGrossWords.textContent = acad.originalWords.toLocaleString();
      acadNetWords.textContent = acad.originalWords.toLocaleString();
      acadExcludedWords.textContent = '0 (Disabled)';
      acadExcludedDesc.textContent = `Found ${acad.inTextCitationsCount} in-text citations · ${acad.referencesWordCount} ref words`;
    }

    // 1. Calculate Core Metrics with Customizable WPM
    const metrics = calculateMetrics(textToAnalyze, userReadingWpm, userSpeakingWpm);

    statWords.textContent = metrics.words.toLocaleString();
    statLongestWord.textContent = metrics.words > 0 ? `Avg ${metrics.averageWordLength} chars/word` : 'Avg 0 chars/word';
    statChars.textContent = metrics.characters.toLocaleString();
    statCharsNoSpaces.textContent = `${metrics.charactersNoSpaces.toLocaleString()} no spaces`;
    statSentences.textContent = metrics.sentences.toLocaleString();
    const wordsPerSent = metrics.sentences > 0 ? (metrics.words / metrics.sentences).toFixed(1) : '0';
    statWordsPerSentence.textContent = `${wordsPerSent} words/sent`;
    statParagraphs.textContent = metrics.paragraphs.toLocaleString();
    const sentsPerPara = metrics.paragraphs > 0 ? (metrics.sentences / metrics.paragraphs).toFixed(1) : '0';
    statSentsPerPara.textContent = `${sentsPerPara} sents/para`;
    statReadingTime.textContent = metrics.readingTimeFormatted;
    statSpeakingTime.textContent = metrics.speakingTimeFormatted;

    // Mobile Top Micro-Bar Stats
    if (mobileStatWords) mobileStatWords.textContent = `${metrics.words.toLocaleString()} Words`;
    if (mobileStatChars) mobileStatChars.textContent = `${metrics.characters.toLocaleString()} Chars`;
    if (mobileStatReading) mobileStatReading.textContent = `${metrics.readingTimeFormatted} Read`;

    // WordCounter.net Granular Drawer Stats
    if (statUniqueWords) statUniqueWords.textContent = metrics.uniqueWords.toLocaleString();
    if (statUniqueRatio) statUniqueRatio.textContent = `${metrics.uniqueWordsPercent}% vocabulary richness`;
    if (statSyllables) statSyllables.textContent = metrics.totalSyllables.toLocaleString();
    if (statSyllablesAvg) statSyllablesAvg.textContent = `~${metrics.syllablesPerWord} syllables/word`;
    if (statLines) statLines.textContent = metrics.lines.toLocaleString();
    if (statSentenceExtremes) statSentenceExtremes.textContent = `${metrics.shortestSentenceWords}w min · ${metrics.longestSentenceWords}w max`;
    if (statPublisherPages) statPublisherPages.textContent = `${metrics.publisherPages} book · ${metrics.standardPages} standard`;
    if (statHandwritingTime) statHandwritingTime.textContent = metrics.handwritingTimeFormatted;

    // Daily Activity & Streak Recording
    recordDailyActivity(metrics.words);

    // Sentence Flow Rhythm & Length Distribution (Tab 5)
    if (flowScoreVal) flowScoreVal.textContent = metrics.flow.flowScore.toString();
    if (flowScoreLabel) flowScoreLabel.textContent = metrics.flow.flowLabel;
    const sentTotal = Math.max(1, metrics.sentences);
    if (barFlowVshort) barFlowVshort.style.width = `${Math.min(100, Math.round((metrics.flow.veryShort / sentTotal) * 100))}%`;
    if (barFlowShort) barFlowShort.style.width = `${Math.min(100, Math.round((metrics.flow.short / sentTotal) * 100))}%`;
    if (barFlowMedium) barFlowMedium.style.width = `${Math.min(100, Math.round((metrics.flow.medium / sentTotal) * 100))}%`;
    if (barFlowLong) barFlowLong.style.width = `${Math.min(100, Math.round((metrics.flow.long / sentTotal) * 100))}%`;
    if (barFlowMarathon) barFlowMarathon.style.width = `${Math.min(100, Math.round((metrics.flow.marathon / sentTotal) * 100))}%`;
    if (countFlowVshort) countFlowVshort.textContent = metrics.flow.veryShort.toString();
    if (countFlowShort) countFlowShort.textContent = metrics.flow.short.toString();
    if (countFlowMedium) countFlowMedium.textContent = metrics.flow.medium.toString();
    if (countFlowLong) countFlowLong.textContent = metrics.flow.long.toString();
    if (countFlowMarathon) countFlowMarathon.textContent = metrics.flow.marathon.toString();

    // 2. Target Goal Progress Tracking
    if (currentTargetCount > 0) {
      const currentValue = currentTargetType === 'words' ? metrics.words : metrics.characters;
      const unit = currentTargetType === 'words' ? 'words' : 'chars';
      const pct = Math.min(100, Math.round((currentValue / currentTargetCount) * 100));
      const remaining = Math.max(0, currentTargetCount - currentValue);

      targetTextStatus.textContent = `${currentValue.toLocaleString()} / ${currentTargetCount.toLocaleString()} ${unit} (${pct}%) — ${remaining.toLocaleString()} left`;
      targetProgressFill.style.width = `${pct}%`;

      if (pct >= 100) {
        targetProgressFill.className = 'h-full transition-all duration-300 rounded-full bg-[#0070f3]';
      } else {
        targetProgressFill.className = 'h-full transition-all duration-300 rounded-full bg-[#0070f3]';
      }
    } else {
      targetTextStatus.textContent = 'No target set';
      targetProgressFill.style.width = '0%';
    }

    // 3. Readability Calculations
    try {
      const read = calculateReadability(textToAnalyze, metrics.words, metrics.sentences, metrics.charactersNoSpaces);
      if (readFreScore) readFreScore.textContent = read.fleschReadingEase.toString();
      if (readFreBadge) readFreBadge.textContent = read.fleschReadingEaseLabel;
      if (readGradeAvg) readGradeAvg.textContent = `Grade ${read.averageGradeLevel}`;
      if (readGradeSummary) readGradeSummary.textContent = read.gradeLevelSummary;
      if (readFkg) readFkg.textContent = read.fleschKincaidGrade.toFixed(1);
      if (readFog) readFog.textContent = read.gunningFog.toFixed(1);
      if (readCli) readCli.textContent = read.colemanLiau.toFixed(1);
      if (readAri) readAri.textContent = read.automatedReadabilityIndex.toFixed(1);

      if (readingLevelPill) {
        readingLevelPill.textContent = metrics.words > 0
          ? `Reading: Grade ${read.averageGradeLevel} (${read.fleschReadingEaseLabel})`
          : 'Reading Level: Ready';
      }
    } catch (e) {
      console.error('Readability calc error:', e);
    }

    // 4. Keyword Density Analysis
    try {
      const filterStop = checkStopwords ? checkStopwords.checked : true;
      const kwResult = calculateKeywordDensity(textToAnalyze, filterStop, 15);
      let activeKwList = kwResult.oneWord;
      if (currentNgram === 2) activeKwList = kwResult.twoWord;
      if (currentNgram === 3) activeKwList = kwResult.threeWord;

      if (!activeKwList || activeKwList.length === 0) {
        keywordsTableBody.innerHTML = `
          <tr>
            <td colspan="3" class="py-8 text-center text-[#8f8f8f] font-mono">
              ${metrics.words === 0 ? 'Type or paste text above to calculate keyword density.' : 'No keywords found matching current filter.'}
            </td>
          </tr>
        `;
      } else {
        keywordsTableBody.innerHTML = activeKwList.map((k) => `
          <tr class="hover:bg-black/5 dark:hover:bg-white/5 transition font-mono">
            <td class="py-2.5 px-3 font-medium text-[#171717] dark:text-[#ededed]">
              <button type="button" class="keyword-item hover:text-[#0070f3] hover:underline text-left cursor-pointer" data-phrase="${k.phrase}">
                ${k.phrase}
              </button>
            </td>
            <td class="py-2.5 px-3 text-center text-[#4d4d4d] dark:text-[#a1a1a1]">${k.count.toLocaleString()}</td>
            <td class="py-2.5 px-3 text-right font-medium text-[#0070f3]">${k.density}%</td>
          </tr>
        `).join('');

        document.querySelectorAll('.keyword-item').forEach((item) => {
          item.addEventListener('click', () => {
            const phrase = (item as HTMLElement).dataset.phrase;
            if (phrase) highlightWordInEditor(phrase);
          });
        });
      }

      // Update quick keywords strip directly under editor tool
      const editorKeywordsList = document.getElementById('editor-keywords-list');
      if (editorKeywordsList) {
        if (!kwResult.oneWord || kwResult.oneWord.length === 0) {
          editorKeywordsList.innerHTML = '<span class="text-[#8f8f8f] text-[10px]">Type text to view frequency</span>';
        } else {
          const topKeywords = kwResult.oneWord.slice(0, 4);
          editorKeywordsList.innerHTML = topKeywords.map(k => `
            <button type="button" class="quick-keyword-pill inline-flex items-center gap-1 px-1.5 py-0.5 rounded-[4px] bg-black/5 dark:bg-white/10 hover:bg-[#0070f3]/15 text-[#171717] dark:text-[#ededed] font-mono text-[10px] transition cursor-pointer" data-phrase="${k.phrase}" title="${k.count} occurrences (${k.density}%)">
              <span>${k.phrase}</span>
              <span class="text-[#0070f3] font-bold">(${k.count})</span>
            </button>
          `).join('');

          editorKeywordsList.querySelectorAll('.quick-keyword-pill').forEach(pill => {
            pill.addEventListener('click', () => {
              const phrase = (pill as HTMLElement).dataset.phrase;
              if (phrase) {
                highlightWordInEditor(phrase);
                switchTab('keywords');
                document.getElementById('analysis-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            });
          });
        }
      }
    } catch (e) {
      console.error('Keyword density error:', e);
    }

    // 5. Social Media Limits
    try {
      const socialCharCountLabel = document.getElementById('social-live-char-count');
      if (socialCharCountLabel) {
        socialCharCountLabel.textContent = `${metrics.characters.toLocaleString()} characters`;
      }

      const socialStatuses = evaluatePlatformLimits(metrics.characters);
      if (socialGrid) {
        socialGrid.innerHTML = socialStatuses.map((s) => {
          const isExceeded = s.isOverLimit;
          const isWarning = s.percentage >= 85 && !isExceeded;

          return `
            <div class="p-3.5 sm:p-4 rounded-[10px] border transition-all ${
              isExceeded
                ? 'bg-[#ee0000]/5 dark:bg-[#ee0000]/10 border-[#ee0000]/30'
                : isWarning
                ? 'bg-[#f5a623]/5 dark:bg-[#f5a623]/10 border-[#f5a623]/30'
                : 'bg-[#fafafa] dark:bg-[#0e0e0e] border-[#ebebeb] dark:border-[#222222]'
            }">
              <div class="flex items-center justify-between mb-2">
                <span class="font-semibold text-xs text-[#171717] dark:text-[#ededed]">
                  ${s.limit.name}
                </span>
                ${
                  isExceeded
                    ? `<span class="flex items-center gap-1 font-mono text-[10px] font-medium text-[#ee0000] bg-[#ee0000]/10 px-2 py-0.5 rounded-[4px]">
                        +${Math.abs(s.remainingChars).toLocaleString()}
                      </span>`
                    : isWarning
                    ? `<span class="flex items-center gap-1 font-mono text-[10px] font-medium text-[#f5a623] bg-[#f5a623]/10 px-2 py-0.5 rounded-[4px]">
                        ${s.remainingChars.toLocaleString()} left
                      </span>`
                    : `<span class="flex items-center gap-1 font-mono text-[10px] font-medium text-[#0070f3] bg-[#0070f3]/10 px-2 py-0.5 rounded-[4px]">
                        ${s.remainingChars.toLocaleString()} left
                      </span>`
                }
              </div>

              <!-- Progress Bar -->
              <div class="w-full h-1 bg-[#ebebeb] dark:bg-[#222222] rounded-full overflow-hidden mb-2">
                <div
                  class="h-full transition-all duration-300 ${
                    isExceeded
                      ? 'bg-[#ee0000]'
                      : isWarning
                      ? 'bg-[#f5a623]'
                      : 'bg-[#0070f3]'
                  }"
                  style="width: ${s.percentage}%"
                ></div>
              </div>

              <div class="flex items-center justify-between text-[11px] text-[#8f8f8f] font-mono">
                <span>${s.currentChars.toLocaleString()} / ${s.limit.maxChars.toLocaleString()}</span>
                <span>${s.percentage}%</span>
              </div>
            </div>
          `;
        }).join('');
      }
    } catch (e) {
      console.error('Social limits error:', e);
    }

    // 6. Style & Quality Audit (Filler Words & Passive Voice)
    const style = analyzeStyle(textToAnalyze);
    styleFillerCount.textContent = style.fillerWordsCount.toLocaleString();
    stylePassiveCount.textContent = style.passiveVoiceCount.toLocaleString();
    styleFillerDesc.textContent = style.fillerWordsCount > 0 ? `${style.fillerWordsCount} weak qualifiers detected.` : 'No weak fillers found. Your copy is clean.';
    stylePassiveDesc.textContent = style.passiveVoiceCount > 0 ? `${style.passiveVoiceCount} passive constructions flagged.` : 'No passive voice found. Strong active verbs.';

    if (style.fillerMatches.length === 0) {
      styleFillerList.innerHTML = `<span class="text-[#8f8f8f] font-mono text-xs">No filler words detected.</span>`;
    } else {
      styleFillerList.innerHTML = style.fillerMatches.map(f => `
        <button type="button" class="style-match-tag inline-flex items-center gap-1.5 px-2.5 py-1 rounded-[6px] border border-amber-500/20 bg-amber-500/10 text-amber-700 dark:text-amber-400 font-mono text-xs hover:bg-amber-500/20 transition cursor-pointer" data-phrase="${f.word}">
          <span>"${f.word}"</span>
          <span class="text-[10px] bg-amber-500/20 px-1 rounded-[4px] font-bold">${f.count}</span>
        </button>
      `).join('');
    }

    if (style.passiveMatches.length === 0) {
      stylePassiveList.innerHTML = `<span class="text-[#8f8f8f] font-mono text-xs">No passive voice detected.</span>`;
    } else {
      stylePassiveList.innerHTML = style.passiveMatches.map(p => `
        <button type="button" class="style-match-tag inline-flex items-center gap-1.5 px-2.5 py-1 rounded-[6px] border border-[#0070f3]/20 bg-[#0070f3]/10 text-[#0070f3] font-mono text-xs hover:bg-[#0070f3]/20 transition cursor-pointer" data-phrase="${p.phrase}">
          <span>"${p.phrase}"</span>
          <span class="text-[10px] bg-[#0070f3]/20 px-1 rounded-[4px] font-bold">${p.count}</span>
        </button>
      `).join('');
    }

    // Attach listeners for style tags
    document.querySelectorAll('.style-match-tag').forEach((btn) => {
      btn.addEventListener('click', () => {
        const phrase = (btn as HTMLElement).dataset.phrase;
        if (phrase) highlightWordInEditor(phrase);
      });
    });

    // 7. Update Live Feed & SERP Visual Previews
    try {
      const cleanText = textToAnalyze.trim();
      const firstLine = cleanText.split('\n').filter(Boolean)[0] || '';
      const docTitle = firstLine ? firstLine.slice(0, 70) : 'Precision Writing Analytics & Word Counter';
      const docDesc = cleanText.length > docTitle.length 
        ? cleanText.slice(docTitle.length).trim().slice(0, 180) 
        : cleanText || 'Instant client-side word count, character limits, readability, and LLM token estimator.';

      if (serpPreviewTitle) {
        serpPreviewTitle.textContent = docTitle.length > 60 ? docTitle.slice(0, 57) + '...' : docTitle;
      }
      if (serpPreviewDesc) {
        serpPreviewDesc.textContent = docDesc.length > 155 ? docDesc.slice(0, 152) + '...' : docDesc;
      }
      if (serpTitleCharBadge) {
        const titleLen = docTitle.length;
        serpTitleCharBadge.textContent = `${titleLen} / 60 chars`;
        serpTitleCharBadge.className = titleLen > 60 
          ? 'font-mono text-xs text-[#ee0000] font-bold' 
          : 'font-mono text-xs text-[#0070f3]';
      }

      if (xPreviewContent) {
        if (!cleanText) {
          xPreviewContent.innerHTML = '<span class="text-[#8f8f8f]">Your draft text will preview here inside the standard 280-character post container...</span>';
        } else if (cleanText.length <= 280) {
          xPreviewContent.textContent = cleanText;
        } else {
          const validPart = escapeHtml(cleanText.slice(0, 280));
          const excessPart = escapeHtml(cleanText.slice(280));
          xPreviewContent.innerHTML = `${validPart}<mark class="bg-[#ee0000]/20 text-[#ee0000] rounded px-0.5 font-medium" title="Exceeds 280 character limit">${excessPart}</mark>`;
        }
      }
      if (xPreviewCharBadge) {
        const len = cleanText.length;
        xPreviewCharBadge.textContent = `${len.toLocaleString()} / 280 chars`;
        xPreviewCharBadge.className = len > 280 
          ? 'font-mono text-xs bg-[#ee0000]/15 text-[#ee0000] px-2 py-0.5 rounded-[4px] font-bold' 
          : 'font-mono text-xs bg-[#0070f3]/10 text-[#0070f3] px-2 py-0.5 rounded-[4px]';
      }

      if (linkedinPreviewContent) {
        if (!cleanText) {
          linkedinPreviewContent.innerHTML = '<span class="text-[#8f8f8f]">Your professional hook appears here...</span>';
        } else if (cleanText.length <= 140) {
          linkedinPreviewContent.textContent = cleanText;
        } else {
          const hook = escapeHtml(cleanText.slice(0, 140));
          const remainder = escapeHtml(cleanText.slice(140));
          linkedinPreviewContent.innerHTML = `
            <div>
              <span class="font-medium text-[#171717] dark:text-[#ededed]">${hook}</span>
              <span class="text-[#0070f3] font-semibold"> ...see more</span>
            </div>
            <div class="mt-2 pt-2 border-t border-dashed border-[#ebebeb] dark:border-[#222222] text-[#8f8f8f] text-xs">
              ${remainder}
            </div>
          `;
        }
      }
      if (linkedinPreviewCharBadge) {
        linkedinPreviewCharBadge.textContent = `${cleanText.length.toLocaleString()} / 3,000 chars`;
      }
    } catch (e) {
      console.error('SERP/Feed preview error:', e);
    }

    // 8. Calculate 2020–2026 AI Token Metrics
    try {
      const activeModel = AI_MODELS_CATALOG.find(m => m.id === activeModelId) || AI_MODELS_CATALOG[0];
      const activeMetrics = calculateModelTokens(textToAnalyze, activeModel);

      if (tokenRatioStat) {
        tokenRatioStat.textContent = `~${activeMetrics.charsPerToken} chars/token`;
      }

      renderActiveModelHero(textToAnalyze);
      renderModelsGrid(textToAnalyze);
      renderHistoricalBenchmark(textToAnalyze);

      // Legacy fallback bindings for backward safety
      const gpt4oModel = AI_MODELS_CATALOG.find(m => m.id === 'gpt-4o') || activeModel;
      const claudeModel = AI_MODELS_CATALOG.find(m => m.id === 'claude-3-5-sonnet') || activeModel;
      const geminiModel = AI_MODELS_CATALOG.find(m => m.id === 'gemini-2-flash') || activeModel;
      const llamaModel = AI_MODELS_CATALOG.find(m => m.id === 'llama-3.1-70b') || activeModel;

      const gpt4oM = calculateModelTokens(textToAnalyze, gpt4oModel);
      const claudeM = calculateModelTokens(textToAnalyze, claudeModel);
      const geminiM = calculateModelTokens(textToAnalyze, geminiModel);
      const llamaM = calculateModelTokens(textToAnalyze, llamaModel);

      if (tokenGpt4oCount) tokenGpt4oCount.textContent = gpt4oM.tokens.toLocaleString();
      if (tokenGpt4oCost) tokenGpt4oCost.textContent = `$${gpt4oM.inputCost.toFixed(4)}`;
      if (tokenGpt4oPct) tokenGpt4oPct.textContent = `${gpt4oM.contextUsagePct}%`;
      if (tokenGpt4oBar) tokenGpt4oBar.style.width = `${Math.min(100, Math.max(gpt4oM.contextUsagePct > 0 ? 1 : 0, gpt4oM.contextUsagePct * 5))}%`;

      if (tokenClaudeCount) tokenClaudeCount.textContent = claudeM.tokens.toLocaleString();
      if (tokenClaudeCost) tokenClaudeCost.textContent = `$${claudeM.inputCost.toFixed(4)}`;
      if (tokenClaudePct) tokenClaudePct.textContent = `${claudeM.contextUsagePct}%`;
      if (tokenClaudeBar) tokenClaudeBar.style.width = `${Math.min(100, Math.max(claudeM.contextUsagePct > 0 ? 1 : 0, claudeM.contextUsagePct * 5))}%`;

      if (tokenGeminiCount) tokenGeminiCount.textContent = geminiM.tokens.toLocaleString();
      if (tokenGeminiCost) tokenGeminiCost.textContent = `$${geminiM.inputCost.toFixed(4)}`;
      if (tokenGeminiPct) tokenGeminiPct.textContent = `${geminiM.contextUsagePct}%`;
      if (tokenGeminiBar) tokenGeminiBar.style.width = `${Math.min(100, Math.max(geminiM.contextUsagePct > 0 ? 1 : 0, geminiM.contextUsagePct * 5))}%`;

      if (tokenLlamaCount) tokenLlamaCount.textContent = llamaM.tokens.toLocaleString();
      if (tokenLlamaCost) tokenLlamaCost.textContent = `$${llamaM.inputCost.toFixed(4)}`;
      if (tokenLlamaPct) tokenLlamaPct.textContent = `${llamaM.contextUsagePct}%`;
      if (tokenLlamaBar) tokenLlamaBar.style.width = `${Math.min(100, Math.max(llamaM.contextUsagePct > 0 ? 1 : 0, llamaM.contextUsagePct * 5))}%`;
    } catch (e) {
      console.error('AI token computation error:', e);
    }

    // Refresh inline highlights if visible
    if (isHighlightMode) {
      renderInlineHighlights();
    }

    // Immediate LocalStorage Auto-Save & Multi-Document Sync
    saveCurrentDocContent();
    renderDocumentTabs();
    autosaveLabel.textContent = `Saved locally at ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
  }

  // ─── 2020–2026 AI MODEL SUITE LOGIC & RENDERING ───
  function populateModelSelect() {
    if (!aiModelSelect) return;
    aiModelSelect.innerHTML = '';

    const eraGroups = [
      { label: '2025–2026 Reasoning & SOTA', minYear: 2025, maxYear: 2026 },
      { label: '2024 Omni & Multimodal Flagships', minYear: 2024, maxYear: 2024 },
      { label: '2023 ChatGPT & GPT-4 Era', minYear: 2023, maxYear: 2023 },
      { label: '2020–2022 GPT-3 & Codex Era', minYear: 2020, maxYear: 2022 },
    ];

    eraGroups.forEach((groupInfo) => {
      const groupEl = document.createElement('optgroup');
      groupEl.label = groupInfo.label;

      const groupModels = AI_MODELS_CATALOG.filter(m => m.year >= groupInfo.minYear && m.year <= groupInfo.maxYear);
      groupModels.forEach((m) => {
        const opt = document.createElement('option');
        opt.value = m.id;
        const ctxK = m.contextWindow >= 1000000 ? `${(m.contextWindow / 1000000).toFixed(1)}M` : `${Math.round(m.contextWindow / 1000)}k`;
        opt.textContent = `${m.name} (${m.provider}, ${ctxK} ctx)`;
        if (m.id === activeModelId) opt.selected = true;
        groupEl.appendChild(opt);
      });

      aiModelSelect.appendChild(groupEl);
    });
  }

  function getFilteredAIModels() {
    return AI_MODELS_CATALOG.filter((m) => {
      if (currentEraFilter === '2025-2026' && m.year < 2025) return false;
      if (currentEraFilter === '2024' && m.year !== 2024) return false;
      if (currentEraFilter === '2023' && m.year !== 2023) return false;
      if (currentEraFilter === '2020-2022' && m.year > 2022) return false;

      if (currentProviderFilter !== 'all' && m.provider !== currentProviderFilter) return false;

      if (currentSearchQuery.trim()) {
        const q = currentSearchQuery.toLowerCase();
        const matchesName = m.name.toLowerCase().includes(q);
        const matchesProv = m.provider.toLowerCase().includes(q);
        const matchesFam = m.family.toLowerCase().includes(q);
        const matchesYear = m.year.toString().includes(q);
        const matchesDesc = m.description.toLowerCase().includes(q);
        if (!matchesName && !matchesProv && !matchesFam && !matchesYear && !matchesDesc) {
          return false;
        }
      }

      return true;
    });
  }

