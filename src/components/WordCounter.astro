  // ─── LOCAL WRITING ACTIVITY & STREAK TRACKER (WordCounter.net feature) ───
  interface DayActivity {
    date: string; // YYYY-MM-DD
    words: number;
  }
  const ACTIVITY_STORAGE_KEY = 'cleanwordcounter-activity';
  function getDailyActivity(): DayActivity[] {
    try {
      const raw = localStorage.getItem(ACTIVITY_STORAGE_KEY);
      if (raw) return JSON.parse(raw);
    } catch (e) {}
    return [];
  }

  function recordDailyActivity(currentDocWords: number) {
    if (currentDocWords <= 0) {
      renderActivityStreak(getDailyActivity());
      return;
    }
    const todayStr = new Date().toISOString().slice(0, 10);
    let activities = getDailyActivity();
    let todayEntry = activities.find(a => a.date === todayStr);
    if (todayEntry) {
      todayEntry.words = Math.max(todayEntry.words, currentDocWords);
    } else {
      activities.push({ date: todayStr, words: currentDocWords });
    }
    activities = activities.slice(-30);
    try {
      localStorage.setItem(ACTIVITY_STORAGE_KEY, JSON.stringify(activities));
    } catch (e) {}
    renderActivityStreak(activities);
  }

  function renderActivityStreak(activities: DayActivity[]) {
    if (!activityChartBars) return;
    const days: { dateStr: string; dayLabel: string; words: number }[] = [];
    for (let i = 6; i >= 0; i--) {
      const d = new Date();
      d.setDate(d.getDate() - i);
      const dateStr = d.toISOString().slice(0, 10);
      const dayLabel = d.toLocaleDateString([], { weekday: 'narrow' });
      const found = activities.find(a => a.date === dateStr);
      days.push({ dateStr, dayLabel, words: found ? found.words : 0 });
    }
    const maxWords = Math.max(300, ...days.map(d => d.words));
    activityChartBars.innerHTML = days.map(d => {
      const heightPct = Math.min(100, Math.max(8, Math.round((d.words / maxWords) * 100)));
      const isToday = d.dateStr === new Date().toISOString().slice(0, 10);
      return `
        <div class="flex-1 flex flex-col items-center gap-1 group relative">
          <div class="w-full h-8 bg-black/5 dark:bg-white/5 rounded-[2px] flex items-end overflow-hidden" title="${d.dateStr}: ${d.words.toLocaleString()} words">
            <div class="w-full ${isToday ? 'bg-[#0070f3]' : 'bg-[#171717]/40 dark:bg-white/40'} rounded-t-[2px] transition-all" style="height: ${d.words > 0 ? heightPct : 0}%"></div>
          </div>
          <span class="text-[9px] font-mono ${isToday ? 'text-[#0070f3] font-bold' : 'text-[#8f8f8f]'}">${d.dayLabel}</span>
        </div>
      `;
    }).join('');

    let streak = 0;
    const todayStr = new Date().toISOString().slice(0, 10);
    for (let i = 0; i < 30; i++) {
      const d = new Date();
      d.setDate(d.getDate() - i);
      const dateStr = d.toISOString().slice(0, 10);
      const found = activities.find(a => a.date === dateStr && a.words > 0);
      if (found) {
        streak++;
      } else if (i === 0 && dateStr === todayStr) {
        continue;
      } else {
        break;
      }
    }
    if (streakCounterLabel) {
      streakCounterLabel.textContent = streak > 0 ? `${streak} day streak` : '0 days';
    }
  }

  // ─── UNDO / REDO STATE MACHINE ───
  function pushUndoState() {
    if (isUndoRedoRunning || !textarea) return;
    const val = textarea.value;
    if (undoHistory.length === 0 || undoHistory[undoHistory.length - 1] !== val) {
      undoHistory.push(val);
      if (undoHistory.length > 50) undoHistory.shift();
      redoHistory = [];
    }
  }
  if (textarea && textarea.value) {
    undoHistory.push(textarea.value);
  }

  btnUndo?.addEventListener('click', () => {
    if (undoHistory.length > 1) {
      isUndoRedoRunning = true;
      const current = undoHistory.pop()!;
      redoHistory.push(current);
      const prev = undoHistory[undoHistory.length - 1];
      textarea.value = prev;
      updateAll();
      updateFindMatches();
      isUndoRedoRunning = false;
      notify('Undo');
    } else {
      notify('Nothing to undo');
    }
  });

  btnRedo?.addEventListener('click', () => {
    if (redoHistory.length > 0) {
      isUndoRedoRunning = true;
      const next = redoHistory.pop()!;
      undoHistory.push(next);
      textarea.value = next;
      updateAll();
      updateFindMatches();
      isUndoRedoRunning = false;
      notify('Redo');
    } else {
      notify('Nothing to redo');
    }
  });

  // ─── FIND & REPLACE MICRO-TOOL ───
  btnFindReplaceToggle?.addEventListener('click', () => {
    if (findReplaceBar) {
      findReplaceBar.classList.toggle('hidden');
      if (!findReplaceBar.classList.contains('hidden')) {
        inputFind?.focus();
        updateFindMatches();
      }
    }
  });

  btnCloseFindReplace?.addEventListener('click', () => {
    findReplaceBar?.classList.add('hidden');
    textarea?.focus();
  });

  function updateFindMatches() {
    if (!inputFind || !textarea) return;
    const term = inputFind.value;
    if (!term) {
      if (findMatchCount) findMatchCount.textContent = '0 matches';
      findIndices = [];
      activeFindMatchIndex = -1;
      return;
    }
    const matchCase = checkFindCase?.checked || false;
    const wholeWord = checkFindWhole?.checked || false;
    const text = textarea.value;
    let regexStr = escapeRegExp(term);
    if (wholeWord) regexStr = `\\b${regexStr}\\b`;
    const flags = matchCase ? 'g' : 'gi';
    try {
      const regex = new RegExp(regexStr, flags);
      findIndices = [];
      let match;
      while ((match = regex.exec(text)) !== null) {
        findIndices.push(match.index);
        if (!regex.global) break;
      }
      if (findIndices.length > 0) {
        if (activeFindMatchIndex < 0 || activeFindMatchIndex >= findIndices.length) {
          activeFindMatchIndex = 0;
        }
        highlightCurrentFindMatch();
      } else {
        activeFindMatchIndex = -1;
        if (findMatchCount) findMatchCount.textContent = '0 matches';
      }
    } catch (e) {}
  }

  function highlightCurrentFindMatch() {
    if (activeFindMatchIndex < 0 || activeFindMatchIndex >= findIndices.length || !inputFind) return;
    const start = findIndices[activeFindMatchIndex];
    const len = inputFind.value.length;
    textarea.focus();
    textarea.setSelectionRange(start, start + len);
    if (findMatchCount) {
      findMatchCount.textContent = `${activeFindMatchIndex + 1} of ${findIndices.length}`;
    }
  }

  btnFindNext?.addEventListener('click', () => {
    if (findIndices.length === 0) return;
    activeFindMatchIndex = (activeFindMatchIndex + 1) % findIndices.length;
    highlightCurrentFindMatch();
  });

  btnFindPrev?.addEventListener('click', () => {
    if (findIndices.length === 0) return;
    activeFindMatchIndex = (activeFindMatchIndex - 1 + findIndices.length) % findIndices.length;
    highlightCurrentFindMatch();
  });

  inputFind?.addEventListener('input', updateFindMatches);
  checkFindCase?.addEventListener('change', updateFindMatches);
  checkFindWhole?.addEventListener('change', updateFindMatches);

  btnReplaceOne?.addEventListener('click', () => {
    if (!inputFind || !inputReplace || activeFindMatchIndex < 0 || activeFindMatchIndex >= findIndices.length) return;
    pushUndoState();
    const start = findIndices[activeFindMatchIndex];
    const term = inputFind.value;
    const replaceWith = inputReplace.value || '';
    const text = textarea.value;
    textarea.value = text.slice(0, start) + replaceWith + text.slice(start + term.length);
    updateAll();
    updateFindMatches();
    notify('Replaced 1 match');
  });

  btnReplaceAll?.addEventListener('click', () => {
    if (!inputFind || !inputReplace) return;
    const term = inputFind.value;
    if (!term) return;
    pushUndoState();
    const matchCase = checkFindCase?.checked || false;
    const wholeWord = checkFindWhole?.checked || false;
    let regexStr = escapeRegExp(term);
    if (wholeWord) regexStr = `\\b${regexStr}\\b`;
    const flags = matchCase ? 'g' : 'gi';
    const regex = new RegExp(regexStr, flags);
    const count = findIndices.length;
    textarea.value = textarea.value.replace(regex, inputReplace.value || '');
    updateAll();
    updateFindMatches();
    notify(`Replaced all ${count} matches`);
  });

  // ─── TALK TO TYPE (Web Speech API SpeechRecognition) ───
  const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
  btnTalkToType?.addEventListener('click', () => {
    if (!SpeechRecognition) {
      alert('Speech recognition is supported in modern Chrome, Edge, and Safari browsers. Please check your browser settings.');
      return;
    }
    if (isListeningSpeech) {
      recognition?.stop();
      isListeningSpeech = false;
      if (btnTalkToType) {
        btnTalkToType.className = 'vercel-btn-sm vercel-btn-sm-ghost text-xs flex items-center gap-1.5 cursor-pointer';
      }
      if (labelTalkToType) labelTalkToType.textContent = 'Talk to Type';
      notify('Voice dictation stopped');
    } else {
      try {
        recognition = new SpeechRecognition();
        recognition.continuous = true;
        recognition.interimResults = true;
        recognition.lang = 'en-US';
        recognition.onstart = () => {
          isListeningSpeech = true;
          if (btnTalkToType) {
            btnTalkToType.className = 'vercel-btn-sm text-xs flex items-center gap-1.5 border border-rose-500 bg-rose-500/10 text-rose-600 dark:text-rose-400 font-semibold cursor-pointer animate-pulse';
          }
          if (labelTalkToType) labelTalkToType.textContent = 'Listening...';
          notify('Microphone active — start speaking');
        };
        recognition.onresult = (event: any) => {
          let final = '';
          for (let i = event.resultIndex; i < event.results.length; ++i) {
            if (event.results[i].isFinal) {
              final += event.results[i][0].transcript;
            }
          }
          if (final) {
            pushUndoState();
            const spacer = textarea.value.length > 0 && !textarea.value.endsWith(' ') ? ' ' : '';
            textarea.value += spacer + final;
            updateAll();
          }
        };
        recognition.onerror = (err: any) => {
          console.error('Dictation error:', err);
          isListeningSpeech = false;
          if (btnTalkToType) {
            btnTalkToType.className = 'vercel-btn-sm vercel-btn-sm-ghost text-xs flex items-center gap-1.5 cursor-pointer';
          }
          if (labelTalkToType) labelTalkToType.textContent = 'Talk to Type';
          notify(`Dictation: ${err.error || 'microphone error'}`);
        };
        recognition.onend = () => {
          isListeningSpeech = false;
          if (btnTalkToType) {
            btnTalkToType.className = 'vercel-btn-sm vercel-btn-sm-ghost text-xs flex items-center gap-1.5 cursor-pointer';
          }
          if (labelTalkToType) labelTalkToType.textContent = 'Talk to Type';
        };
        recognition.start();
      } catch (e: any) {
        alert('Could not start microphone dictation.');
      }
    }
  });

  // ─── PROOF READ (SpeechSynthesis Audio Player) ───
  btnProofRead?.addEventListener('click', () => {
    if (!('speechSynthesis' in window)) {
