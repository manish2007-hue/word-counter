        localStorage.setItem('cleanwordcounter-draft', textarea.value);
      } catch (e) {}
    }
  }

  function renderDocumentTabs() {
    if (!docTabsList) return;
    docTabsList.innerHTML = documents.map(doc => {
      const isActive = doc.id === activeDocId;
      const wordCount = doc.content.trim() ? doc.content.trim().split(/\s+/).length : 0;
      return `
        <div class="doc-tab-item inline-flex items-center gap-1.5 px-2.5 py-1 rounded-[4px] text-xs font-mono transition cursor-pointer select-none ${
          isActive 
            ? 'bg-[#171717] text-white dark:bg-white dark:text-black font-medium shadow-2xs' 
            : 'bg-[#ebebeb]/60 dark:bg-[#1a1a1a] text-[#8f8f8f] hover:text-[#171717] dark:hover:text-[#ededed]'
        }" data-id="${doc.id}">
          <span class="tab-title truncate max-w-[110px]">${escapeHtml(doc.title)}</span>
          <span class="text-[10px] opacity-70">(${wordCount}w)</span>
          ${documents.length > 1 ? `<button type="button" class="tab-close hover:text-[#ee0000] ml-0.5 text-xs font-bold leading-none cursor-pointer" data-close-id="${doc.id}" title="Close document">×</button>` : ''}
        </div>
      `;
    }).join('');

    if (docCountBadge) {
      const activeDoc = documents.find(d => d.id === activeDocId);
      docCountBadge.textContent = `${activeDoc?.title || 'Draft'} (${documents.length} ${documents.length === 1 ? 'doc' : 'docs'})`;
    }

    // Attach listeners
    docTabsList.querySelectorAll('.doc-tab-item').forEach(tabEl => {
      tabEl.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('tab-close')) return;
        const targetId = (tabEl as HTMLElement).dataset.id;
        if (targetId && targetId !== activeDocId) {
          saveCurrentDocContent();
          activeDocId = targetId;
          const doc = documents.find(d => d.id === activeDocId);
          if (doc) {
            textarea.value = doc.content;
            renderDocumentTabs();
            updateAll();
            notify(`Switched to "${doc.title}"`);
          }
        }
      });

      // Double-click to rename tab
      tabEl.addEventListener('dblclick', () => {
        const docId = (tabEl as HTMLElement).dataset.id;
        const doc = documents.find(d => d.id === docId);
        if (doc) {
          const newName = prompt('Rename document tab:', doc.title);
          if (newName && newName.trim()) {
            doc.title = newName.trim();
            saveCurrentDocContent();
            renderDocumentTabs();
            notify(`Renamed tab to "${doc.title}"`);
          }
        }
      });
    });

    docTabsList.querySelectorAll('.tab-close').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const closeId = (btn as HTMLElement).dataset.closeId;
        if (closeId && documents.length > 1) {
          documents = documents.filter(d => d.id !== closeId);
          if (activeDocId === closeId) {
            activeDocId = documents[0].id;
            textarea.value = documents[0].content;
          }
          saveCurrentDocContent();
          renderDocumentTabs();
          updateAll();
          notify('Document closed');
        }
      });
    });
  }

