  btnTtsPlayPause?.addEventListener('click', () => {
    if (!textarea.value.trim()) {
      notify('Editor is empty');
      return;
    }
    if (window.speechSynthesis.speaking) {
      if (window.speechSynthesis.paused) {
        window.speechSynthesis.resume();
        isTtsPlaying = true;
        if (ttsPlayLabel) ttsPlayLabel.textContent = 'Pause';
        if (proofReadStatus) proofReadStatus.textContent = 'Playing audio proofread...';
      } else {
        window.speechSynthesis.pause();
        isTtsPlaying = false;
        if (ttsPlayLabel) ttsPlayLabel.textContent = 'Resume';
        if (proofReadStatus) proofReadStatus.textContent = 'Paused audio proofread';
      }
    } else {
      window.speechSynthesis.cancel();
      const ut = new SpeechSynthesisUtterance(textarea.value);
      ut.rate = parseFloat(selectTtsRate?.value || '1.0');
      ut.onstart = () => {
        isTtsPlaying = true;
        if (ttsPlayLabel) ttsPlayLabel.textContent = 'Pause';
        if (proofReadStatus) proofReadStatus.textContent = 'Playing audio proofread...';
      };
      ut.onend = () => {
        isTtsPlaying = false;
        if (ttsPlayLabel) ttsPlayLabel.textContent = 'Play';
        if (proofReadStatus) proofReadStatus.textContent = 'Completed proofread';
      };
      ut.onerror = () => {
        isTtsPlaying = false;
        if (ttsPlayLabel) ttsPlayLabel.textContent = 'Play';
        if (proofReadStatus) proofReadStatus.textContent = 'Audio playback error';
      };
      window.speechSynthesis.speak(ut);
    }
  });

