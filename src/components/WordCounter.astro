  // Robust Clipboard Helper
  function copyToClipboard(text: string, successMsg: string) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(() => {
        notify(successMsg);
      }).catch(() => fallbackCopy(text, successMsg));
    } else {
      fallbackCopy(text, successMsg);
    }
  }

  function fallbackCopy(text: string, successMsg: string) {
    const temp = document.createElement('textarea');
    temp.value = text;
    temp.style.position = 'fixed';
    temp.style.opacity = '0';
    document.body.appendChild(temp);
    temp.focus();
    temp.select();
    try {
      document.execCommand('copy');
      notify(successMsg);
    } catch (e) {
      alert('Unable to copy to clipboard.');
    }
    document.body.removeChild(temp);
  }

  // Hemingway Mode & Sentence Flow Highlight Renderer
  function renderInlineHighlights() {
    if (!styleHighlightViewport) return;
    const text = textarea.value;
    if (!text.trim()) {
      styleHighlightViewport.innerHTML = '<span class="text-[#8f8f8f] font-mono text-xs">Type or paste text in the editor to see live color-coded highlights for rhythm flow, weak fillers, and passive voice. Click here to return to writing.</span>';
      return;
    }

    // 1. Flow Rhythm Mode (WordCounter.net Sentence Length Highlighting)
    if (isFlowHighlightActive) {
      const rawSentences = text.split(/(?<=[.!?]+["”'’]?\s+)/gu);
      let flowHtml = '';
      for (const sent of rawSentences) {
        if (!sent.trim()) {
          flowHtml += escapeHtml(sent);
          continue;
        }
        const wCount = (sent.match(/[\p{L}\p{N}]+(?:['’\-][\p{L}\p{N}]+)*/gu) || []).length;
        const escapedSent = escapeHtml(sent);
        if (wCount <= 5) {
          flowHtml += `<mark class="bg-blue-500/20 text-blue-800 dark:text-blue-300 rounded px-1 py-0.5" title="Very Short (${wCount} words)">${escapedSent}</mark>`;
        } else if (wCount <= 14) {
          flowHtml += `<mark class="bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 rounded px-1 py-0.5" title="Short (${wCount} words)">${escapedSent}</mark>`;
        } else if (wCount <= 25) {
          flowHtml += `<span>${escapedSent}</span>`;
        } else if (wCount <= 39) {
          flowHtml += `<mark class="bg-amber-500/20 text-amber-800 dark:text-amber-300 rounded px-1 py-0.5" title="Long (${wCount} words)">${escapedSent}</mark>`;
        } else {
          flowHtml += `<mark class="bg-rose-500/25 text-rose-800 dark:text-rose-300 rounded px-1 py-0.5 border-b-2 border-rose-500" title="Marathon Run-On (${wCount} words)">${escapedSent}</mark>`;
        }
      }
      styleHighlightViewport.innerHTML = flowHtml;
      return;
    }

    const style = analyzeStyle(text);
    let html = escapeHtml(text);

    // 2. Highlight passive voice in blue
    style.passiveMatches.forEach(p => {
      const phraseEsc = escapeRegExp(p.phrase);
      const re = new RegExp(`\\b(${phraseEsc})\\b`, 'gi');
      html = html.replace(re, '<mark class="bg-[#0070f3]/20 dark:bg-[#0070f3]/30 text-[#0070f3] dark:text-[#79b8ff] px-1 py-0.5 rounded font-mono text-xs font-semibold" title="Passive voice phrase">$1</mark>');
    });

    // 3. Highlight weak filler words in amber
    style.fillerMatches.forEach(f => {
      const wordEsc = escapeRegExp(f.word);
      const re = new RegExp(`\\b(${wordEsc})\\b`, 'gi');
      html = html.replace(re, '<mark class="bg-amber-400/25 dark:bg-amber-500/25 text-amber-800 dark:text-amber-300 px-1 py-0.5 rounded font-mono text-xs font-semibold" title="Weak filler word">$1</mark>');
    });

    styleHighlightViewport.innerHTML = html;
  }

