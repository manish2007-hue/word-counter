---
interface Props {
  initialTab?: 'keywords' | 'readability' | 'social' | 'academic' | 'style';
  initialTarget?: number;
  showHeroCopy?: boolean;
}

const {
  initialTab = 'keywords',
  initialTarget = 0,
  showHeroCopy = true,
} = Astro.props;
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 pb-16" id="tool-container" data-initial-tab={initialTab} data-initial-target={initialTarget}>
  
  {showHeroCopy && (
    <div class="text-center mb-10 py-6 sm:py-8 vercel-hero-mesh rounded-[16px] relative overflow-hidden border border-[#ebebeb]/60 dark:border-[#222222]/60">
      <!-- Vercel Uppercase Technical Eyebrow -->
      <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white/80 dark:bg-[#0a0a0a]/80 px-3 py-1 mono-eyebrow text-[#8f8f8f] dark:text-[#707070] shadow-2xs mb-4">
        <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
        <span>Developer-Grade Writing Analytics</span>
      </div>
      
      <!-- Vercel Display Heading with Tight Tracking & Gradient Accent -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed] leading-[1.08]">
        Count smarter. <span class="vercel-gradient-develop">Write with precision.</span>
      </h1>
      
      <!-- Body Copy -->
      <p class="mt-3 text-[15px] sm:text-[17px] text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
        Real-time word, character, and readability analytics computed 100% inside your browser. 
        <span class="inline-block text-[#171717] dark:text-[#ededed] font-medium">Zero server calls. 100% client-side privacy.</span>
      </p>

      <!-- Vercel Marketing CTA Buttons (Pill Format) -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="#main-workspace" class="vercel-btn-primary">
          <span>Start Analyzing</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
          </svg>
        </a>
        <button id="btn-sample-text" type="button" class="vercel-btn-secondary">
          <span>Load Sample Essay</span>
        </button>
      </div>
    </div>
  )}

  <!-- MAIN LIVE METRIC STATS TILES (Vercel Hairline Cards Grid) -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 sm:gap-3.5 mb-5">
    
    <!-- Words Tile -->
    <div class="vercel-card p-3.5 sm:p-4">
      <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">Words</div>
      <div class="mt-1 font-mono text-2xl sm:text-3xl font-bold text-[#0070f3]" id="stat-words">0</div>
      <div class="text-[11px] text-[#8f8f8f] dark:text-[#707070] mt-0.5 truncate" id="stat-longest-word">Avg 0 chars/word</div>
    </div>

    <!-- Characters Tile -->
    <div class="vercel-card p-3.5 sm:p-4">
      <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">Characters</div>
      <div class="mt-1 font-mono text-2xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed]" id="stat-characters">0</div>
      <div class="text-[11px] text-[#8f8f8f] dark:text-[#707070] mt-0.5" id="stat-chars-no-spaces">0 no spaces</div>
    </div>

    <!-- Sentences Tile -->
    <div class="vercel-card p-3.5 sm:p-4">
      <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">Sentences</div>
      <div class="mt-1 font-mono text-2xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed]" id="stat-sentences">0</div>
      <div class="text-[11px] text-[#8f8f8f] dark:text-[#707070] mt-0.5" id="stat-words-per-sentence">0 words/sent</div>
    </div>

    <!-- Paragraphs Tile -->
    <div class="vercel-card p-3.5 sm:p-4">
      <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">Paragraphs</div>
      <div class="mt-1 font-mono text-2xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed]" id="stat-paragraphs">0</div>
      <div class="text-[11px] text-[#8f8f8f] dark:text-[#707070] mt-0.5" id="stat-sents-per-para">0 sents/para</div>
    </div>

    <!-- Reading Time Tile -->
    <div class="vercel-card p-3.5 sm:p-4">
      <div class="flex items-center justify-between mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">
        <span>Reading Time</span>
        <span class="text-[10px] text-[#8f8f8f] font-mono">225 wpm</span>
      </div>
      <div class="mt-1 font-mono text-2xl sm:text-3xl font-bold text-[#0070f3]" id="stat-reading-time">0 sec</div>
      <div class="text-[11px] text-[#8f8f8f] dark:text-[#707070] mt-0.5">Silent reading</div>
    </div>

    <!-- Speaking Time Tile -->
    <div class="vercel-card p-3.5 sm:p-4">
      <div class="flex items-center justify-between mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">
        <span>Speaking Time</span>
        <span class="text-[10px] text-[#8f8f8f] font-mono">130 wpm</span>
      </div>
      <div class="mt-1 font-mono text-2xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed]" id="stat-speaking-time">0 sec</div>
      <div class="text-[11px] text-[#8f8f8f] dark:text-[#707070] mt-0.5">Speech / keynote</div>
    </div>

  </div>

  <!-- WORD BUDGET / TARGET CAPSULE (Vercel Hairline Strip) -->
  <div id="target-budget-container" class="mb-4 vercel-card p-3.5 sm:p-4">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="font-semibold text-[#171717] dark:text-[#ededed] flex items-center gap-1.5 font-mono text-xs">
          <svg class="h-3.5 w-3.5 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          GOAL TARGET:
        </span>
        <span id="target-text-status" class="font-mono text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1]">
          No target set
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-1.5">
        <button id="btn-quick-target-280" type="button" class="vercel-btn-sm vercel-btn-sm-ghost text-[11px] py-1 px-2.5">280 Chars (X)</button>
        <button id="btn-quick-target-500" type="button" class="vercel-btn-sm vercel-btn-sm-ghost text-[11px] py-1 px-2.5">500 Words</button>
        <button id="btn-quick-target-1000" type="button" class="vercel-btn-sm vercel-btn-sm-ghost text-[11px] py-1 px-2.5">1,000 Words</button>
        <button id="btn-set-custom-target" type="button" class="vercel-btn-sm text-[11px] py-1 px-2.5 bg-[#0070f3]/10 dark:bg-[#0070f3]/20 text-[#0070f3] border border-[#0070f3]/30 font-medium">Custom Goal...</button>
      </div>
    </div>
    <!-- Visual Progress Capsule -->
    <div class="h-1.5 w-full overflow-hidden rounded-full bg-[#f2f2f2] dark:bg-[#1a1a1a]">
      <div id="target-progress-fill" class="h-full w-0 bg-[#0070f3] transition-all duration-300 rounded-full"></div>
    </div>
  </div>

  <!-- MAIN WORKSPACE BOX (Vercel Crisp Hairline Editor) -->
  <div id="main-workspace" class="vercel-card overflow-hidden relative">
    
    <!-- Action Bar / Toolbar (Vercel Inset Tool Strip) -->
    <div class="flex flex-wrap items-center justify-between gap-2.5 border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e] px-4 py-2.5">
      
      <!-- Left Controls: File Upload, Case Converter -->
      <div class="flex flex-wrap items-center gap-2">
        
        <!-- File Upload Button & Hidden Input (6px Square Button) -->
        <button
          id="btn-trigger-upload"
          type="button"
          class="vercel-btn-sm vercel-btn-sm-ghost"
        >
          <svg class="h-3.5 w-3.5 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
          </svg>
          <span>Upload File</span>
          <span class="text-[10px] text-[#8f8f8f] font-mono hidden sm:inline">(.docx, .pdf, .txt)</span>
        </button>
        <input type="file" id="file-upload-input" accept=".txt,.md,.rtf,.docx,.pdf" class="hidden" />

        <!-- Change Case Dropdown -->
        <div class="relative inline-block text-left" id="case-menu-wrapper">
          <button
            id="case-menu-btn"
            type="button"
            class="vercel-btn-sm vercel-btn-sm-ghost"
          >
            <span>Change Case</span>
            <svg class="h-3 w-3 text-[#8f8f8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          
          <div id="case-dropdown" class="hidden absolute left-0 mt-1.5 w-44 rounded-[8px] border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] p-1.5 shadow-xl z-30 text-xs">
            <button class="case-option w-full rounded-[4px] px-2.5 py-1.5 text-left text-[#171717] dark:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#171717] transition" data-case="sentence">Sentence case</button>
            <button class="case-option w-full rounded-[4px] px-2.5 py-1.5 text-left text-[#171717] dark:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#171717] transition" data-case="lower">lowercase</button>
            <button class="case-option w-full rounded-[4px] px-2.5 py-1.5 text-left text-[#171717] dark:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#171717] transition" data-case="upper">UPPERCASE</button>
            <button class="case-option w-full rounded-[4px] px-2.5 py-1.5 text-left text-[#171717] dark:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#171717] transition" data-case="title">Title Case</button>
          </div>
        </div>

      </div>

      <!-- Right Controls: Copy Stats, Copy Text, Export, Clear -->
      <div class="flex items-center gap-2">
        
        <!-- Copy Stats Button -->
        <button
          id="btn-copy-stats"
          type="button"
          class="vercel-btn-sm vercel-btn-sm-ghost"
          title="Copy formatted statistics summary"
        >
          <svg class="h-3.5 w-3.5 text-[#8f8f8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
          <span class="hidden sm:inline">Copy Stats</span>
        </button>

        <!-- Copy Text Button -->
        <button
          id="btn-copy-text"
          type="button"
          class="vercel-btn-sm vercel-btn-sm-ghost"
          title="Copy editor text to clipboard"
        >
          <svg class="h-3.5 w-3.5 text-[#8f8f8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          <span class="hidden sm:inline">Copy Text</span>
        </button>

        <!-- Export Dropdown -->
        <div class="relative">
          <button
            id="export-menu-btn"
            type="button"
            class="vercel-btn-sm vercel-btn-sm-ghost"
            title="Export text & report"
          >
            <svg class="h-3.5 w-3.5 text-[#8f8f8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            <span class="hidden sm:inline">Export</span>
          </button>
          
          <div
            id="export-dropdown"
            class="hidden absolute right-0 mt-1.5 w-44 rounded-[8px] border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] p-1.5 shadow-xl z-20 text-xs"
          >
            <button class="export-opt w-full rounded-[4px] px-2.5 py-1.5 text-left text-[#171717] dark:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#171717] transition" data-export="txt">Download as .TXT</button>
            <button class="export-opt w-full rounded-[4px] px-2.5 py-1.5 text-left text-[#171717] dark:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#171717] transition" data-export="md">Download as .MD</button>
            <button class="export-opt w-full rounded-[4px] px-2.5 py-1.5 text-left text-[#171717] dark:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#171717] transition" data-export="report">Copy Full Report</button>
          </div>
        </div>

        <!-- Clear Text Button -->
        <button
          id="btn-clear-text"
          type="button"
          class="vercel-btn-sm text-xs text-[#ee0000] border border-[#ee0000]/20 bg-[#ee0000]/5 hover:bg-[#ee0000]/10 transition"
          title="Clear editor text"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          <span>Clear</span>
        </button>

      </div>
    </div>

    <!-- Drag & Drop Visual Overlay (Vercel Inset Sheet) -->
    <div id="drop-overlay" class="hidden absolute inset-0 z-30 flex flex-col items-center justify-center bg-[#171717]/95 dark:bg-[#000000]/95 text-white backdrop-blur-md p-6 text-center">
      <div class="h-12 w-12 rounded-[8px] bg-white/10 flex items-center justify-center mb-3">
        <svg class="h-6 w-6 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
        </svg>
      </div>
      <p class="text-lg font-semibold tracking-tight">Drop file to count words locally</p>
      <p class="text-xs text-[#8f8f8f] mt-1 font-mono">100% processed in browser. Supports .docx, .pdf, .txt, .md</p>
    </div>

    <!-- MAIN ERGONOMIC TEXTAREA -->
    <div class="relative p-4 sm:p-6 bg-white dark:bg-[#0a0a0a]">
      <textarea
        id="main-text-input"
        rows="13"
        class="w-full resize-y bg-transparent text-[#171717] dark:text-[#ededed] placeholder:text-[#8f8f8f] font-normal leading-relaxed text-[15px] sm:text-[16px] focus:outline-hidden"
        placeholder="Type, paste (Ctrl+V), or drag & drop text, docx, or pdf here to begin..."
        spellcheck="true"
      ></textarea>
    </div>

    <!-- Bottom Status Bar: Auto-Save & Reading Grade -->
    <div class="flex items-center justify-between border-t border-[#ebebeb] dark:border-[#222222] px-4 py-2 text-[11px] text-[#8f8f8f] bg-[#fafafa] dark:bg-[#0e0e0e] font-mono">
      <div class="flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#0070f3]" id="autosave-indicator"></span>
        <span id="autosave-label">Saved to device memory</span>
      </div>
      <div id="reading-level-pill" class="font-medium text-[#4d4d4d] dark:text-[#a1a1a1]">
        Reading Level: Ready
      </div>
    </div>

  </div>

  <!-- VERCEL SEGMENTED ANALYSIS TABS -->
  <div class="mt-8 vercel-card overflow-hidden" id="analysis-section">
    
    <!-- Tab Navigation Segmented Bar (Vercel Category Tab Pills) -->
    <div class="p-2 border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e] overflow-x-auto">
      <div class="flex items-center gap-1 min-w-max">
        
        <button class="analysis-tab-btn flex items-center gap-2 px-3.5 py-1.5 vercel-category-pill text-xs font-medium bg-[#171717] text-white dark:bg-white dark:text-black shrink-0 transition" data-tab="keywords">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
          </svg>
          <span>Keyword Density</span>
        </button>

        <button class="analysis-tab-btn flex items-center gap-2 px-3.5 py-1.5 vercel-category-pill text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-black/5 dark:hover:bg-white/5 shrink-0 transition" data-tab="readability">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          <span>Readability & Grades</span>
        </button>

        <button class="analysis-tab-btn flex items-center gap-2 px-3.5 py-1.5 vercel-category-pill text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-black/5 dark:hover:bg-white/5 shrink-0 transition" data-tab="social">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
          </svg>
          <span>Social Media Limits</span>
        </button>

        <button class="analysis-tab-btn flex items-center gap-2 px-3.5 py-1.5 vercel-category-pill text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-black/5 dark:hover:bg-white/5 shrink-0 transition" data-tab="academic">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"/>
          </svg>
          <span>Academic Essay Mode</span>
        </button>

        <button class="analysis-tab-btn flex items-center gap-2 px-3.5 py-1.5 vercel-category-pill text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-black/5 dark:hover:bg-white/5 shrink-0 transition" data-tab="style">
          <svg class="h-3.5 w-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          <span>Style & Quality Audit</span>
        </button>

      </div>
    </div>

    <!-- Tab 1: Keyword Density Content -->
    <div id="tab-content-keywords" class="analysis-panel p-4 sm:p-6 bg-white dark:bg-[#0a0a0a]">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
        <div>
          <h3 class="text-[16px] font-semibold text-[#171717] dark:text-[#ededed] tracking-tight">Keyword Frequency & Density</h3>
          <p class="text-xs text-[#8f8f8f]">Identify recurring terms and calibrate your SEO phrase balance.</p>
        </div>
        <div class="flex items-center gap-3">
          <label class="flex items-center gap-2 text-xs text-[#4d4d4d] dark:text-[#a1a1a1] cursor-pointer font-mono">
            <input type="checkbox" id="check-filter-stopwords" checked class="rounded-[4px] border-[#ebebeb] text-[#0070f3] focus:ring-[#0070f3]" />
            <span>Filter stop words (the, is, at...)</span>
          </label>
        </div>
      </div>

      <!-- N-gram sub-selector (6px Vercel Square Buttons) -->
      <div class="flex gap-1.5 mb-4 font-mono">
        <button class="ngram-btn px-2.5 py-1 rounded-[6px] text-xs font-medium bg-[#171717] text-white dark:bg-white dark:text-black transition" data-ngram="1">1 Word</button>
        <button class="ngram-btn px-2.5 py-1 rounded-[6px] text-xs font-medium border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white transition" data-ngram="2">2 Words</button>
