            <button id="btn-find-next" type="button" class="px-2 py-1 rounded bg-[#ebebeb] dark:bg-[#222] hover:bg-[#e0e0e0] dark:hover:bg-[#2c2c2c] text-[10px] font-mono cursor-pointer" title="Next match">▼</button>
            <button id="btn-replace-one" type="button" class="px-2.5 py-1 rounded bg-[#0070f3] text-white hover:bg-[#0060df] text-[10px] font-mono font-medium cursor-pointer">Replace</button>
