---
import { SOCIAL_PLATFORMS } from '../lib/socialLimits';

interface Props {
  initialTab?: 'keywords' | 'readability' | 'social' | 'academic' | 'style' | 'tokens';
  initialTarget?: number;
  showHeroCopy?: boolean;
}

const {
  initialTab = 'keywords',
  initialTarget = 0,
  showHeroCopy = true,
} = Astro.props;
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 pt-4 pb-16" id="tool-container" data-initial-tab={initialTab} data-initial-target={initialTarget}>
  
  {showHeroCopy && (
    <div class="hidden md:block text-center mb-6 py-5 sm:py-6 vercel-hero-mesh rounded-[16px] relative overflow-hidden border border-[#ebebeb]/60 dark:border-[#222222]/60">
      <!-- Vercel Uppercase Technical Eyebrow -->
      <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white/80 dark:bg-[#0a0a0a]/80 px-3 py-1 mono-eyebrow text-[#8f8f8f] dark:text-[#707070] shadow-2xs mb-3">
        <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
        <span>Developer-Grade Writing &amp; LLM Analytics · 100% Client-Side Privacy</span>
      </div>
      
      <!-- Exact-Match Search Title & Tagline -->
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed] leading-[1.12]">
        Free Online Word Counter &amp; <span class="vercel-gradient-develop">Readability Engine</span>
      </h1>
      
      <!-- Body Copy -->
      <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
        Count words, characters, sentences, LLM tokens, and reading time in real time. In-memory PDF/DOCX parsing with zero server calls.
      </p>

      <!-- Vercel Marketing Action Buttons -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2.5">
        <button id="btn-sample-text" type="button" class="vercel-btn-secondary text-xs py-1.5 px-3">
          <span>Load Sample Document</span>
        </button>
        <span class="text-xs text-[#8f8f8f] font-mono hidden sm:inline">or paste text directly below ↓</span>
      </div>
    </div>
  )}

  <!-- MOBILE COMPACT 1-LINE MICRO-BAR (< md screens for instant above-the-fold access) -->
  <div class="md:hidden mb-2 rounded-[10px] border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0c0c0c] p-2.5 shadow-2xs">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2.5 font-mono">
        <div class="flex items-baseline gap-1">
          <span class="text-base font-bold text-[#0070f3]" id="mobile-stat-words">0</span>
          <span class="text-[9px] text-[#8f8f8f] uppercase font-semibold">words</span>
        </div>
        <span class="text-[#ebebeb] dark:text-[#262626]">·</span>
        <div class="flex items-baseline gap-1">
          <span class="text-base font-bold text-[#171717] dark:text-[#ededed]" id="mobile-stat-chars">0</span>
          <span class="text-[9px] text-[#8f8f8f] uppercase font-semibold">chars</span>
        </div>
        <span class="text-[#ebebeb] dark:text-[#262626]">·</span>
        <div class="flex items-baseline gap-1">
          <span class="text-xs font-semibold text-[#0070f3]" id="mobile-stat-reading">0s</span>
          <span class="text-[9px] text-[#8f8f8f]">read</span>
        </div>
      </div>
      <button
        id="btn-mobile-toggle-cards"
        type="button"
        class="flex items-center gap-1 rounded-[5px] px-2 py-1 text-[11px] font-medium text-[#0070f3] bg-[#0070f3]/10 hover:bg-[#0070f3]/20 transition cursor-pointer"
        aria-expanded="false"
      >
        <span id="mobile-cards-btn-label">More Stats</span>
        <svg id="mobile-cards-chevron" class="h-3 w-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- MAIN LIVE METRIC STATS TILES (Vercel Hairline Cards Grid) -->
  <div id="main-metric-cards" class="hidden md:grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 sm:gap-3.5 mb-3.5">
    
    <!-- Words Tile -->
    <div class="vercel-card p-3.5 sm:p-4">
      <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">Words</div>
      <div class="mt-1 font-mono text-2xl sm:text-3xl font-bold text-[#0070f3]" id="stat-words">0</div>
      <div class="text-[11px] text-[#8f8f8f] dark:text-[#707070] mt-0.5 truncate" id="stat-longest-word">Avg 0 chars/word</div>
    </div>

    <!-- Characters Tile -->
    <div class="vercel-card p-3.5 sm:p-4">
      <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">Characters</div>
      <div class="mt-1 font-mono text-2xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed]" id="stat-characters">0</div>
      <div class="text-[11px] text-[#8f8f8f] dark:text-[#707070] mt-0.5" id="stat-chars-no-spaces">0 no spaces</div>
    </div>

    <!-- Sentences Tile -->
    <div class="vercel-card p-3.5 sm:p-4">
      <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">Sentences</div>
      <div class="mt-1 font-mono text-2xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed]" id="stat-sentences">0</div>
      <div class="text-[11px] text-[#8f8f8f] dark:text-[#707070] mt-0.5" id="stat-words-per-sentence">0 words/sent</div>
    </div>

    <!-- Paragraphs Tile -->
    <div class="vercel-card p-3.5 sm:p-4">
      <div class="mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">Paragraphs</div>
      <div class="mt-1 font-mono text-2xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed]" id="stat-paragraphs">0</div>
      <div class="text-[11px] text-[#8f8f8f] dark:text-[#707070] mt-0.5" id="stat-sents-per-para">0 sents/para</div>
    </div>

    <!-- Reading Time Tile (Interactive Rate) -->
    <div class="vercel-card p-3.5 sm:p-4 relative">
      <div class="flex items-center justify-between mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">
        <span>Reading Time</span>
        <button
          id="btn-reading-speed-toggle"
          type="button"
          class="flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] font-mono text-[#0070f3] hover:bg-[#0070f3]/10 transition cursor-pointer"
          title="Customize reading speed"
        >
          <span id="reading-wpm-badge">225 wpm</span>
          <svg class="h-2.5 w-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>
      <div class="mt-1 font-mono text-2xl sm:text-3xl font-bold text-[#0070f3]" id="stat-reading-time">0 sec</div>
      <div class="text-[11px] text-[#8f8f8f] dark:text-[#707070] mt-0.5 truncate" id="reading-speed-label">Silent reading</div>

      <!-- Reading Speed Popover Dropdown -->
      <div id="popover-reading-speed" class="hidden absolute left-1 right-1 top-full mt-1.5 z-40 rounded-[10px] border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-2.5 shadow-2xl text-xs">
        <div class="flex items-center justify-between font-mono text-[10px] text-[#8f8f8f] uppercase font-semibold mb-2">
          <span>Reading Speed (WPM)</span>
          <button id="btn-close-reading-popover" type="button" class="text-xs hover:text-[#171717] dark:hover:text-white cursor-pointer">×</button>
        </div>
        <div class="grid grid-cols-2 gap-1 mb-2 font-mono text-[11px]">
          <button type="button" class="opt-reading-wpm px-2 py-1.5 rounded-[5px] bg-[#f5f5f5] dark:bg-[#181818] hover:bg-[#0070f3] hover:text-white transition text-left cursor-pointer" data-wpm="130" data-label="ESL / Language learner">130 WPM (ESL)</button>
          <button type="button" class="opt-reading-wpm px-2 py-1.5 rounded-[5px] bg-[#f5f5f5] dark:bg-[#181818] hover:bg-[#0070f3] hover:text-white transition text-left cursor-pointer" data-wpm="180" data-label="Careful proofreading">180 WPM (Careful)</button>
          <button type="button" class="opt-reading-wpm px-2 py-1.5 rounded-[5px] bg-[#f5f5f5] dark:bg-[#181818] hover:bg-[#0070f3] hover:text-white transition text-left cursor-pointer" data-wpm="225" data-label="Silent adult reading">225 WPM (Default)</button>
          <button type="button" class="opt-reading-wpm px-2 py-1.5 rounded-[5px] bg-[#f5f5f5] dark:bg-[#181818] hover:bg-[#0070f3] hover:text-white transition text-left cursor-pointer" data-wpm="300" data-label="Speed reading / Skimming">300 WPM (Fast)</button>
        </div>
        <div class="flex items-center gap-1.5 pt-1.5 border-t border-[#ebebeb] dark:border-[#222222]">
          <input id="input-custom-reading-wpm" type="number" min="50" max="1000" placeholder="Custom" class="w-16 px-1.5 py-1 rounded-[4px] border border-[#ebebeb] dark:border-[#333] bg-transparent font-mono text-[11px] text-[#171717] dark:text-[#ededed] focus:outline-hidden" />
          <button id="btn-save-custom-reading-wpm" type="button" class="px-2.5 py-1 rounded-[4px] bg-[#0070f3] text-white font-mono text-[10px] font-semibold hover:bg-[#0060df] transition cursor-pointer">Set WPM</button>
        </div>
      </div>
    </div>

    <!-- Speaking Time Tile (Interactive Rate) -->
    <div class="vercel-card p-3.5 sm:p-4 relative">
      <div class="flex items-center justify-between mono-eyebrow text-[#8f8f8f] dark:text-[#707070]">
        <span>Speaking Time</span>
        <button
          id="btn-speaking-speed-toggle"
          type="button"
          class="flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] font-mono text-[#171717] dark:text-[#ededed] hover:bg-black/5 dark:hover:bg-white/5 transition cursor-pointer"
          title="Customize speaking rate"
        >
          <span id="speaking-wpm-badge">130 wpm</span>
          <svg class="h-2.5 w-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>
      <div class="mt-1 font-mono text-2xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed]" id="stat-speaking-time">0 sec</div>
      <div class="text-[11px] text-[#8f8f8f] dark:text-[#707070] mt-0.5 truncate" id="speaking-speed-label">Speech / keynote</div>

      <!-- Speaking Speed Popover Dropdown -->
      <div id="popover-speaking-speed" class="hidden absolute left-1 right-1 top-full mt-1.5 z-40 rounded-[10px] border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-2.5 shadow-2xl text-xs">
        <div class="flex items-center justify-between font-mono text-[10px] text-[#8f8f8f] uppercase font-semibold mb-2">
          <span>Speaking Rate (WPM)</span>
          <button id="btn-close-speaking-popover" type="button" class="text-xs hover:text-[#171717] dark:hover:text-white cursor-pointer">×</button>
        </div>
        <div class="grid grid-cols-2 gap-1 mb-2 font-mono text-[11px]">
          <button type="button" class="opt-speaking-wpm px-2 py-1.5 rounded-[5px] bg-[#f5f5f5] dark:bg-[#181818] hover:bg-[#0070f3] hover:text-white transition text-left cursor-pointer" data-wpm="100" data-label="Slow / Keynote / Voiceover">100 WPM (Keynote)</button>
          <button type="button" class="opt-speaking-wpm px-2 py-1.5 rounded-[5px] bg-[#f5f5f5] dark:bg-[#181818] hover:bg-[#0070f3] hover:text-white transition text-left cursor-pointer" data-wpm="130" data-label="Conversational presentation">130 WPM (Default)</button>
          <button type="button" class="opt-speaking-wpm px-2 py-1.5 rounded-[5px] bg-[#f5f5f5] dark:bg-[#181818] hover:bg-[#0070f3] hover:text-white transition text-left cursor-pointer" data-wpm="150" data-label="Podcast / Dynamic pitch">150 WPM (Podcast)</button>
          <button type="button" class="opt-speaking-wpm px-2 py-1.5 rounded-[5px] bg-[#f5f5f5] dark:bg-[#181818] hover:bg-[#0070f3] hover:text-white transition text-left cursor-pointer" data-wpm="180" data-label="Rapid delivery / Fast pace">180 WPM (Rapid)</button>
        </div>
        <div class="flex items-center gap-1.5 pt-1.5 border-t border-[#ebebeb] dark:border-[#222222]">
          <input id="input-custom-speaking-wpm" type="number" min="50" max="1000" placeholder="Custom" class="w-16 px-1.5 py-1 rounded-[4px] border border-[#ebebeb] dark:border-[#333] bg-transparent font-mono text-[11px] text-[#171717] dark:text-[#ededed] focus:outline-hidden" />
          <button id="btn-save-custom-speaking-wpm" type="button" class="px-2.5 py-1 rounded-[4px] bg-[#0070f3] text-white font-mono text-[10px] font-semibold hover:bg-[#0060df] transition cursor-pointer">Set WPM</button>
        </div>
      </div>
    </div>

  </div>

  <!-- GRANULAR METRICS TOGGLE & EXPANDABLE DRAWER (WordCounter.net Granular Features) -->
  <div class="mb-3.5">
    <div class="flex items-center justify-between text-xs font-mono">
      <button
        id="btn-toggle-granular"
        type="button"
        class="inline-flex items-center gap-1.5 text-[11px] text-[#71717a] dark:text-[#a1a1aa] hover:text-[#0070f3] dark:hover:text-[#0070f3] transition cursor-pointer py-1"
        aria-expanded="false"
      >
        <svg id="chevron-granular" class="h-3 w-3 text-[#0070f3] transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span id="label-granular-toggle">+ Granular Metrics (Unique Words, Syllables, Lines, Pages, Handwriting)</span>
      </button>

      <!-- Streak / Daily Activity Pill -->
      <div id="streak-badge-container" class="flex items-center gap-1.5 text-[11px] font-mono text-amber-600 dark:text-amber-400">
        <span>🔥</span>
        <span id="streak-counter-label" class="font-semibold">0-Day Streak</span>
      </div>
    </div>

    <!-- Granular Metrics Drawer Panel -->
    <div id="drawer-granular-metrics" class="hidden mt-2 p-3 sm:p-4 rounded-[10px] border border-[#ebebeb] dark:border-[#222222] bg-[#fcfcfc] dark:bg-[#0c0c0c] text-xs">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 font-mono">
        <!-- Unique Words -->
        <div class="p-2.5 rounded-[6px] bg-white dark:bg-[#141414] border border-[#ebebeb] dark:border-[#222222]">
          <div class="text-[10px] text-[#8f8f8f] uppercase font-semibold">Unique Words</div>
          <div class="text-base font-bold text-[#171717] dark:text-white mt-0.5" id="stat-unique-words">0</div>
          <div class="text-[10px] text-[#8f8f8f] truncate" id="stat-unique-ratio">0% diversity</div>
        </div>

        <!-- Syllables -->
        <div class="p-2.5 rounded-[6px] bg-white dark:bg-[#141414] border border-[#ebebeb] dark:border-[#222222]">
          <div class="text-[10px] text-[#8f8f8f] uppercase font-semibold">Syllables</div>
          <div class="text-base font-bold text-[#171717] dark:text-white mt-0.5" id="stat-syllables">0</div>
          <div class="text-[10px] text-[#8f8f8f] truncate" id="stat-syllables-avg">0 avg/word</div>
        </div>

        <!-- Lines -->
        <div class="p-2.5 rounded-[6px] bg-white dark:bg-[#141414] border border-[#ebebeb] dark:border-[#222222]">
          <div class="text-[10px] text-[#8f8f8f] uppercase font-semibold">Lines</div>
          <div class="text-base font-bold text-[#171717] dark:text-white mt-0.5" id="stat-lines">0</div>
          <div class="text-[10px] text-[#8f8f8f]">Line count</div>
        </div>

        <!-- Sentence Extremes -->
        <div class="p-2.5 rounded-[6px] bg-white dark:bg-[#141414] border border-[#ebebeb] dark:border-[#222222]">
          <div class="text-[10px] text-[#8f8f8f] uppercase font-semibold">Sentence Length</div>
          <div class="text-xs font-bold text-[#171717] dark:text-white mt-1 truncate" id="stat-sentence-extremes">0 min / 0 max</div>
          <div class="text-[10px] text-[#8f8f8f]">Shortest vs longest</div>
        </div>

        <!-- Publisher Pages -->
        <div class="p-2.5 rounded-[6px] bg-white dark:bg-[#141414] border border-[#ebebeb] dark:border-[#222222]">
          <div class="text-[10px] text-[#8f8f8f] uppercase font-semibold">Publisher Pages</div>
          <div class="text-base font-bold text-[#0070f3] mt-0.5" id="stat-publisher-pages">0</div>
          <div class="text-[10px] text-[#8f8f8f]">250 words / book page</div>
        </div>

        <!-- Handwriting Time -->
        <div class="p-2.5 rounded-[6px] bg-white dark:bg-[#141414] border border-[#ebebeb] dark:border-[#222222]">
          <div class="text-[10px] text-[#8f8f8f] uppercase font-semibold">Handwriting Time</div>
          <div class="text-base font-bold text-[#171717] dark:text-white mt-0.5" id="stat-handwriting-time">0 sec</div>
          <div class="text-[10px] text-[#8f8f8f]">At ~13 WPM handwriting</div>
        </div>
      </div>

      <!-- 7-Day Activity Streak Chart -->
      <div class="mt-3 pt-3 border-t border-[#ebebeb] dark:border-[#222222] flex flex-wrap items-center justify-between gap-3 font-mono text-[11px]">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-[#171717] dark:text-[#ededed]">7-Day Writing Activity:</span>
          <span class="text-[10px] text-[#8f8f8f]">Daily words written (100% in browser)</span>
        </div>
        <div class="flex items-end gap-2 h-10" id="activity-chart-bars">
          <!-- 7 day mini bars rendered by JS -->
        </div>
      </div>
    </div>
  </div>

  <!-- WORD BUDGET / TARGET CAPSULE (Desktop only, tucked into mobile icon button) -->
  <div id="target-budget-container" class="hidden md:block mb-3.5 vercel-card p-3.5 sm:p-4">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="font-semibold text-[#171717] dark:text-[#ededed] flex items-center gap-1.5 font-mono text-xs">
          <svg class="h-3.5 w-3.5 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          GOAL TARGET:
        </span>
        <span id="target-text-status" class="font-mono text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1]">
          No target set
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-1.5">
        <button id="btn-quick-target-280" type="button" class="vercel-btn-sm vercel-btn-sm-ghost text-[11px] py-1 px-2.5">280 Chars (X)</button>
        <button id="btn-quick-target-500" type="button" class="vercel-btn-sm vercel-btn-sm-ghost text-[11px] py-1 px-2.5">500 Words</button>
        <button id="btn-quick-target-1000" type="button" class="vercel-btn-sm vercel-btn-sm-ghost text-[11px] py-1 px-2.5">1,000 Words</button>
        <button id="btn-set-custom-target" type="button" class="vercel-btn-sm text-[11px] py-1 px-2.5 bg-[#0070f3]/10 dark:bg-[#0070f3]/20 text-[#0070f3] border border-[#0070f3]/30 font-medium">Custom Goal...</button>
      </div>
    </div>
    <!-- Visual Progress Capsule -->
    <div class="h-1.5 w-full overflow-hidden rounded-full bg-[#f2f2f2] dark:bg-[#1a1a1a]">
      <div id="target-progress-fill" class="h-full w-0 bg-[#0070f3] transition-all duration-300 rounded-full"></div>
    </div>
  </div>

  <!-- MAIN WORKSPACE BOX (Vercel Crisp Hairline Editor) -->
  <div id="main-workspace" class="vercel-card overflow-hidden relative">
    
    <!-- MULTI-DOCUMENT WORKSPACE TABS BAR -->
    <div id="doc-tabs-bar" class="flex items-center gap-1.5 px-3 py-1.5 border-b border-[#ebebeb] dark:border-[#222222] bg-[#fbfbfb] dark:bg-[#0c0c0c] overflow-x-auto text-xs">
      <div id="doc-tabs-list" class="flex items-center gap-1 min-w-max">
        <!-- Populated dynamically via JS -->
      </div>
      <button
        id="btn-add-doc"
        type="button"
        class="flex items-center gap-1 px-2.5 py-1 rounded-[4px] text-[11px] font-mono text-[#8f8f8f] hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-black/5 dark:hover:bg-white/5 transition cursor-pointer"
        title="Add new document tab"
      >
        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        <span>New Tab</span>
      </button>

      <!-- Compact Mobile Goal Button (< md screens) -->
      <button
        id="btn-mobile-goal"
        type="button"
        class="md:hidden flex items-center gap-1 px-2 py-0.5 rounded-[4px] text-[11px] font-mono text-[#0070f3] bg-[#0070f3]/10 hover:bg-[#0070f3]/20 transition shrink-0 cursor-pointer"
        title="Set writing goal"
      >
        <span>🎯</span>
        <span id="mobile-goal-label">Goal</span>
      </button>

      <div class="ml-auto flex items-center gap-2 text-[11px] font-mono text-[#8f8f8f] shrink-0 pl-2">
        <span id="doc-count-badge">Draft 1</span>
      </div>
    </div>

    <!-- Action Bar / Toolbar (Horizontally scrollable with micro-tools) -->
    <div class="flex items-center justify-between gap-2 border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e] px-3 sm:px-4 py-2 overflow-x-auto whitespace-nowrap">
      
      <!-- Left Controls: Undo/Redo, Voice, Find, Upload, Case, Highlight -->
      <div class="flex items-center gap-1.5 shrink-0">
        
