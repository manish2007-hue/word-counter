---
interface Props {
  initialTab?: 'keywords' | 'readability' | 'social' | 'academic';
  initialTarget?: number;
  showHeroCopy?: boolean;
}

const {
  initialTab = 'keywords',
  initialTarget = 0,
  showHeroCopy = true,
} = Astro.props;
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 pb-16" id="tool-container" data-initial-tab={initialTab} data-initial-target={initialTarget}>
  
  {showHeroCopy && (
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#d2d2d7] dark:border-[#3a3a3c] bg-white dark:bg-[#1c1c1e] px-3.5 py-1 text-[12px] font-medium text-[#515154] dark:text-[#a1a1a6] shadow-2xs mb-4">
        <span class="h-1.5 w-1.5 rounded-full bg-[#0066cc] dark:bg-[#2997ff]"></span>
        <span>The Precision Writing Instrument</span>
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7]">
        Count smarter. <span class="text-[#0066cc] dark:text-[#2997ff]">Write with precision.</span>
      </h1>
      <p class="mt-3 text-[15px] sm:text-[17px] text-[#86868b] max-w-2xl mx-auto leading-relaxed">
        Real-time word, character, and readability analytics computed 100% inside your browser. 
        <span class="inline-block text-[#1d1d1f] dark:text-[#f5f5f7] font-medium">Your text never leaves your device.</span>
      </p>
    </div>
  )}

  <!-- MAIN LIVE METRIC STATS TILES (Apple Museum Tile Grid) -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 sm:gap-3.5 mb-5">
    
    <!-- Words Tile -->
    <div class="rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white dark:bg-[#1c1c1e] p-3.5 sm:p-4 shadow-2xs transition-all hover:border-[#0066cc]/40 dark:hover:border-[#2997ff]/40">
      <div class="text-[11px] font-semibold uppercase tracking-wider text-[#86868b]">Words</div>
      <div class="mt-1 font-mono-numbers text-2xl sm:text-3xl font-bold text-[#0066cc] dark:text-[#2997ff]" id="stat-words">0</div>
      <div class="text-[11px] text-[#86868b] mt-0.5 truncate" id="stat-longest-word">Avg 0 chars/word</div>
    </div>

    <!-- Characters Tile -->
    <div class="rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white dark:bg-[#1c1c1e] p-3.5 sm:p-4 shadow-2xs transition-all hover:border-[#0066cc]/40 dark:hover:border-[#2997ff]/40">
      <div class="text-[11px] font-semibold uppercase tracking-wider text-[#86868b]">Characters</div>
      <div class="mt-1 font-mono-numbers text-2xl sm:text-3xl font-bold text-[#1d1d1f] dark:text-[#f5f5f7]" id="stat-characters">0</div>
      <div class="text-[11px] text-[#86868b] mt-0.5" id="stat-chars-no-spaces">0 no spaces</div>
    </div>

    <!-- Sentences Tile -->
    <div class="rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white dark:bg-[#1c1c1e] p-3.5 sm:p-4 shadow-2xs transition-all hover:border-[#0066cc]/40 dark:hover:border-[#2997ff]/40">
      <div class="text-[11px] font-semibold uppercase tracking-wider text-[#86868b]">Sentences</div>
      <div class="mt-1 font-mono-numbers text-2xl sm:text-3xl font-bold text-[#1d1d1f] dark:text-[#f5f5f7]" id="stat-sentences">0</div>
      <div class="text-[11px] text-[#86868b] mt-0.5" id="stat-words-per-sentence">0 words/sent</div>
    </div>

    <!-- Paragraphs Tile -->
    <div class="rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white dark:bg-[#1c1c1e] p-3.5 sm:p-4 shadow-2xs transition-all hover:border-[#0066cc]/40 dark:hover:border-[#2997ff]/40">
      <div class="text-[11px] font-semibold uppercase tracking-wider text-[#86868b]">Paragraphs</div>
      <div class="mt-1 font-mono-numbers text-2xl sm:text-3xl font-bold text-[#1d1d1f] dark:text-[#f5f5f7]" id="stat-paragraphs">0</div>
      <div class="text-[11px] text-[#86868b] mt-0.5" id="stat-sents-per-para">0 sents/para</div>
    </div>

    <!-- Reading Time Tile -->
    <div class="rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white dark:bg-[#1c1c1e] p-3.5 sm:p-4 shadow-2xs transition-all hover:border-[#0066cc]/40 dark:hover:border-[#2997ff]/40">
      <div class="flex items-center justify-between text-[11px] font-semibold uppercase tracking-wider text-[#86868b]">
        <span>Reading Time</span>
        <span class="text-[10px] text-[#86868b]">225 wpm</span>
      </div>
      <div class="mt-1 font-mono-numbers text-2xl sm:text-3xl font-bold text-emerald-600 dark:text-emerald-400" id="stat-reading-time">0 sec</div>
      <div class="text-[11px] text-[#86868b] mt-0.5">Silent reading</div>
    </div>

    <!-- Speaking Time Tile -->
    <div class="rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white dark:bg-[#1c1c1e] p-3.5 sm:p-4 shadow-2xs transition-all hover:border-[#0066cc]/40 dark:hover:border-[#2997ff]/40">
      <div class="flex items-center justify-between text-[11px] font-semibold uppercase tracking-wider text-[#86868b]">
        <span>Speaking Time</span>
        <span class="text-[10px] text-[#86868b]">130 wpm</span>
      </div>
      <div class="mt-1 font-mono-numbers text-2xl sm:text-3xl font-bold text-[#0066cc] dark:text-[#2997ff]" id="stat-speaking-time">0 sec</div>
      <div class="text-[11px] text-[#86868b] mt-0.5">Speech / presentation</div>
    </div>

  </div>

  <!-- WORD BUDGET / TARGET CAPSULE -->
  <div id="target-budget-container" class="mb-4 rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white dark:bg-[#1c1c1e] p-3.5 sm:p-4 shadow-2xs">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] flex items-center gap-1.5">
          <svg class="h-4 w-4 text-[#0066cc] dark:text-[#2997ff]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Word Target Goal:
        </span>
        <span id="target-text-status" class="font-mono-numbers font-medium text-[#515154] dark:text-[#a1a1a6]">
          No target set
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-1.5">
        <button id="btn-quick-target-280" type="button" class="px-2.5 py-1 rounded-full text-[11px] font-medium bg-[#f5f5f7] dark:bg-[#2c2c2e] hover:bg-[#e5e5e7] dark:hover:bg-[#3a3a3c] text-[#1d1d1f] dark:text-[#f5f5f7] transition apple-button">280 Chars (X)</button>
        <button id="btn-quick-target-500" type="button" class="px-2.5 py-1 rounded-full text-[11px] font-medium bg-[#f5f5f7] dark:bg-[#2c2c2e] hover:bg-[#e5e5e7] dark:hover:bg-[#3a3a3c] text-[#1d1d1f] dark:text-[#f5f5f7] transition apple-button">500 Words</button>
        <button id="btn-quick-target-1000" type="button" class="px-2.5 py-1 rounded-full text-[11px] font-medium bg-[#f5f5f7] dark:bg-[#2c2c2e] hover:bg-[#e5e5e7] dark:hover:bg-[#3a3a3c] text-[#1d1d1f] dark:text-[#f5f5f7] transition apple-button">1,000 Words</button>
        <button id="btn-set-custom-target" type="button" class="px-3 py-1 rounded-full text-[11px] bg-[#0066cc]/10 dark:bg-[#2997ff]/15 text-[#0066cc] dark:text-[#2997ff] font-semibold hover:bg-[#0066cc]/20 transition apple-button">Custom Goal...</button>
      </div>
    </div>
    <!-- Visual Progress Capsule -->
    <div class="h-2 w-full overflow-hidden rounded-full bg-[#f0f0f2] dark:bg-[#2c2c2e]">
      <div id="target-progress-fill" class="h-full w-0 bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-300 rounded-full"></div>
    </div>
  </div>

  <!-- MAIN WORKSPACE BOX -->
  <div class="rounded-3xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white dark:bg-[#1c1c1e] shadow-xs overflow-hidden relative">
    
    <!-- Action Bar / Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-2.5 border-b border-[#e5e5e7] dark:border-[#2c2c2e] bg-[#fafafc] dark:bg-[#19191b] px-4 py-3">
      
      <!-- Left Controls: File Upload, Case Converter -->
      <div class="flex flex-wrap items-center gap-2">
        
        <!-- File Upload Button & Hidden Input -->
        <button
          id="btn-trigger-upload"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-full border border-[#d2d2d7] dark:border-[#3a3a3c] bg-white dark:bg-[#2c2c2e] px-3.5 py-1.5 text-xs font-medium text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#f5f5f7] dark:hover:bg-[#38383a] transition apple-button"
        >
          <svg class="h-3.5 w-3.5 text-[#0066cc] dark:text-[#2997ff]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
          </svg>
          <span>Upload File</span>
          <span class="text-[10px] text-[#86868b] hidden sm:inline">(.docx, .pdf, .txt)</span>
        </button>
        <input type="file" id="file-upload-input" accept=".txt,.md,.rtf,.docx,.pdf" class="hidden" />

        <!-- Change Case Dropdown -->
        <div class="relative inline-block text-left" id="case-menu-wrapper">
          <button
            id="case-menu-btn"
            type="button"
            class="inline-flex items-center gap-1 rounded-full border border-[#d2d2d7] dark:border-[#3a3a3c] bg-white dark:bg-[#2c2c2e] px-3 py-1.5 text-xs font-medium text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#f5f5f7] dark:hover:bg-[#38383a] transition apple-button"
          >
            <span>Change Case</span>
            <svg class="h-3 w-3 text-[#86868b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          
          <div id="case-dropdown" class="hidden absolute left-0 mt-1.5 w-44 rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white/95 dark:bg-[#1c1c1e]/95 backdrop-blur-xl p-1.5 shadow-xl z-30 text-xs">
            <button class="case-option w-full rounded-xl px-3 py-2 text-left text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#0066cc]/10 dark:hover:bg-[#2997ff]/15 transition" data-case="sentence">Sentence case</button>
            <button class="case-option w-full rounded-xl px-3 py-2 text-left text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#0066cc]/10 dark:hover:bg-[#2997ff]/15 transition" data-case="lower">lowercase</button>
            <button class="case-option w-full rounded-xl px-3 py-2 text-left text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#0066cc]/10 dark:hover:bg-[#2997ff]/15 transition" data-case="upper">UPPERCASE</button>
            <button class="case-option w-full rounded-xl px-3 py-2 text-left text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#0066cc]/10 dark:hover:bg-[#2997ff]/15 transition" data-case="title">Title Case</button>
          </div>
        </div>

      </div>

      <!-- Right Controls: Copy Stats, Copy Text, Clear -->
      <div class="flex items-center gap-2">
        
        <!-- Copy Stats Button -->
        <button
          id="btn-copy-stats"
          type="button"
          class="inline-flex items-center gap-1 rounded-full border border-[#d2d2d7] dark:border-[#3a3a3c] bg-white dark:bg-[#2c2c2e] px-3 py-1.5 text-xs font-medium text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#f5f5f7] dark:hover:bg-[#38383a] transition apple-button"
          title="Copy formatted statistics summary"
        >
          <svg class="h-3.5 w-3.5 text-[#86868b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
          <span class="hidden sm:inline">Copy Stats</span>
        </button>

        <!-- Copy Text Button -->
        <button
          id="btn-copy-text"
          type="button"
          class="inline-flex items-center gap-1 rounded-full border border-[#d2d2d7] dark:border-[#3a3a3c] bg-white dark:bg-[#2c2c2e] px-3 py-1.5 text-xs font-medium text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#f5f5f7] dark:hover:bg-[#38383a] transition apple-button"
          title="Copy editor text to clipboard"
        >
          <svg class="h-3.5 w-3.5 text-[#86868b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          <span class="hidden sm:inline">Copy Text</span>
        </button>

        <!-- Export Dropdown -->
        <div class="relative">
          <button
            id="export-menu-btn"
            type="button"
            class="inline-flex items-center gap-1 rounded-full border border-[#d2d2d7] dark:border-[#3a3a3c] bg-white dark:bg-[#2c2c2e] px-3 py-1.5 text-xs font-medium text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#f5f5f7] dark:hover:bg-[#38383a] transition apple-button"
            title="Export text & report"
          >
            <svg class="h-3.5 w-3.5 text-[#86868b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            <span class="hidden sm:inline">Export</span>
          </button>
          
          <div
            id="export-dropdown"
            class="hidden absolute right-0 mt-1.5 w-44 rounded-2xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white dark:bg-[#1c1c1e] p-1.5 shadow-xl z-20 text-xs"
          >
            <button class="export-opt w-full rounded-xl px-3 py-2 text-left text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#0066cc]/10 dark:hover:bg-[#2997ff]/15 transition" data-export="txt">Download as .TXT</button>
            <button class="export-opt w-full rounded-xl px-3 py-2 text-left text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#0066cc]/10 dark:hover:bg-[#2997ff]/15 transition" data-export="md">Download as .MD</button>
            <button class="export-opt w-full rounded-xl px-3 py-2 text-left text-[#1d1d1f] dark:text-[#f5f5f7] hover:bg-[#0066cc]/10 dark:hover:bg-[#2997ff]/15 transition" data-export="report">Copy Full Report</button>
          </div>
        </div>

        <!-- Clear Text Button -->
        <button
          id="btn-clear-text"
          type="button"
          class="inline-flex items-center gap-1 rounded-full border border-rose-200 dark:border-rose-900/40 bg-rose-50/60 dark:bg-rose-950/20 px-3 py-1.5 text-xs font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-100 dark:hover:bg-rose-900/40 transition apple-button"
          title="Clear editor text"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          <span>Clear</span>
        </button>

      </div>
    </div>

    <!-- Drag & Drop Visual Overlay -->
    <div id="drop-overlay" class="hidden absolute inset-0 z-30 flex flex-col items-center justify-center bg-[#0066cc]/90 dark:bg-[#0055b3]/95 text-white backdrop-blur-md rounded-3xl p-6 text-center">
      <svg class="h-14 w-14 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
      </svg>
      <p class="mt-4 text-xl font-bold">Release to count words instantly</p>
      <p class="text-xs text-blue-100 mt-1">100% processed in browser. Supports .docx, .pdf, .txt, .md</p>
    </div>

    <!-- MAIN ERGONOMIC TEXTAREA -->
    <div class="relative p-4 sm:p-6">
      <textarea
        id="main-text-input"
        rows="13"
        class="w-full resize-y bg-transparent text-[#1d1d1f] dark:text-[#f5f5f7] placeholder:text-[#86868b] font-normal leading-relaxed text-[16px] sm:text-[17px] focus:outline-hidden"
        placeholder="Start typing, paste your text here (Ctrl+V), or drag & drop a .docx, .pdf, or .txt file..."
        spellcheck="true"
      ></textarea>
    </div>

    <!-- Bottom Status Bar: Auto-Save & Reading Grade -->
    <div class="flex items-center justify-between border-t border-[#e5e5e7] dark:border-[#2c2c2e] px-4 py-2.5 text-[11px] text-[#86868b] bg-[#fafafc] dark:bg-[#19191b]">
      <div class="flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500" id="autosave-indicator"></span>
        <span id="autosave-label">Saved to device memory</span>
      </div>
      <div id="reading-level-pill" class="font-medium text-[#515154] dark:text-[#a1a1a6]">
        Reading Level: Ready
      </div>
    </div>

  </div>

  <!-- APPLE-STYLE SEGMENTED ANALYSIS TABS -->
  <div class="mt-8 rounded-3xl border border-[#e5e5e7] dark:border-[#2c2c2e] bg-white dark:bg-[#1c1c1e] shadow-xs overflow-hidden" id="analysis-section">
    
    <!-- Tab Navigation Segmented Bar -->
    <div class="p-2 border-b border-[#e5e5e7] dark:border-[#2c2c2e] bg-[#fafafc] dark:bg-[#19191b] overflow-x-auto">
      <div class="flex items-center gap-1.5 min-w-max">
        
        <button class="analysis-tab-btn flex items-center gap-2 px-4 py-2 rounded-full text-xs font-semibold bg-[#0066cc] text-white dark:bg-[#2997ff] dark:text-black transition apple-button shrink-0" data-tab="keywords">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
          </svg>
          <span>Keyword Density</span>
        </button>

        <button class="analysis-tab-btn flex items-center gap-2 px-4 py-2 rounded-full text-xs font-medium text-[#515154] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5 transition apple-button shrink-0" data-tab="readability">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          <span>Readability & Grades</span>
        </button>

        <button class="analysis-tab-btn flex items-center gap-2 px-4 py-2 rounded-full text-xs font-medium text-[#515154] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5 transition apple-button shrink-0" data-tab="social">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
          </svg>
          <span>Social Media Limits</span>
        </button>

        <button class="analysis-tab-btn flex items-center gap-2 px-4 py-2 rounded-full text-xs font-medium text-[#515154] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5 transition apple-button shrink-0" data-tab="academic">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
