<!-- CLIENT SCRIPT COMPONENT LOGIC -->
<script>
  import { calculateMetrics } from '../lib/metrics';
  import { calculateReadability } from '../lib/readability';
  import { calculateKeywordDensity } from '../lib/keywords';
  import { filterAcademicText } from '../lib/academic';
  import { parseUploadedFile } from '../lib/fileParser';
  import { evaluatePlatformLimits } from '../lib/socialLimits';
  import { analyzeStyle } from '../lib/styleAnalyzer';

  // Container & initial props
  const container = document.getElementById('tool-container') as HTMLElement;
  const initialTab = container?.dataset.initialTab || 'keywords';
  const initialTargetVal = parseInt(container?.dataset.initialTarget || '0', 10);

  // DOM elements
  const textarea = document.getElementById('main-text-input') as HTMLTextAreaElement;
  const statWords = document.getElementById('stat-words')!;
  const statLongestWord = document.getElementById('stat-longest-word')!;
  const statChars = document.getElementById('stat-characters')!;
  const statCharsNoSpaces = document.getElementById('stat-chars-no-spaces')!;
  const statSentences = document.getElementById('stat-sentences')!;
  const statWordsPerSentence = document.getElementById('stat-words-per-sentence')!;
  const statParagraphs = document.getElementById('stat-paragraphs')!;
  const statSentsPerPara = document.getElementById('stat-sents-per-para')!;
  const statReadingTime = document.getElementById('stat-reading-time')!;
  const statSpeakingTime = document.getElementById('stat-speaking-time')!;

  const targetTextStatus = document.getElementById('target-text-status')!;
  const targetProgressFill = document.getElementById('target-progress-fill')!;
  const autosaveLabel = document.getElementById('autosave-label')!;
  const readingLevelPill = document.getElementById('reading-level-pill')!;

  // File upload
  const btnTriggerUpload = document.getElementById('btn-trigger-upload');
  const fileInput = document.getElementById('file-upload-input') as HTMLInputElement;
  const dropOverlay = document.getElementById('drop-overlay')!;

  // Action Buttons
  const btnCopyStats = document.getElementById('btn-copy-stats')!;
  const btnCopyText = document.getElementById('btn-copy-text')!;
  const btnClearText = document.getElementById('btn-clear-text')!;

  // Target Goal Modal & Presets
  const targetModal = document.getElementById('target-modal')!;
  const customTargetInput = document.getElementById('custom-target-input') as HTMLInputElement;
  const btnSetCustomTarget = document.getElementById('btn-set-custom-target')!;
  const btnCancelTargetModal = document.getElementById('btn-cancel-target-modal')!;
  const btnClearTarget = document.getElementById('btn-clear-target')!;
  const btnSaveTargetModal = document.getElementById('btn-save-target-modal')!;

  const btnTarget280 = document.getElementById('btn-quick-target-280')!;
  const btnTarget500 = document.getElementById('btn-quick-target-500')!;
  const btnTarget1000 = document.getElementById('btn-quick-target-1000')!;

  // Analysis Tabs
  const tabButtons = document.querySelectorAll('.analysis-tab-btn');
  const panels = document.querySelectorAll('.analysis-panel');

  // Keyword Elements
  const keywordsTableBody = document.getElementById('keywords-table-body')!;
  const checkStopwords = document.getElementById('check-filter-stopwords') as HTMLInputElement;
  const ngramButtons = document.querySelectorAll('.ngram-btn');

  // Readability Elements
  const readFreScore = document.getElementById('read-fre-score')!;
  const readFreBadge = document.getElementById('read-fre-badge')!;
  const readFreDesc = document.getElementById('read-fre-desc')!;
  const readGradeAvg = document.getElementById('read-grade-avg')!;
  const readGradeSummary = document.getElementById('read-grade-summary')!;
  const readFkg = document.getElementById('read-fkg')!;
  const readFog = document.getElementById('read-fog')!;
  const readCli = document.getElementById('read-cli')!;
  const readAri = document.getElementById('read-ari')!;

  // Social Grid
  const socialGrid = document.getElementById('social-cards-grid')!;

  // Academic Elements
  const toggleAcademic = document.getElementById('toggle-academic-mode') as HTMLInputElement;
  const acadGrossWords = document.getElementById('acad-gross-words')!;
  const acadNetWords = document.getElementById('acad-net-words')!;
  const acadExcludedWords = document.getElementById('acad-excluded-words')!;
  const acadExcludedDesc = document.getElementById('acad-excluded-desc')!;

  // Style Elements
  const styleFillerCount = document.getElementById('style-filler-count')!;
  const styleFillerDesc = document.getElementById('style-filler-desc')!;
  const styleFillerList = document.getElementById('style-filler-list')!;
  const stylePassiveCount = document.getElementById('style-passive-count')!;
  const stylePassiveDesc = document.getElementById('style-passive-desc')!;
  const stylePassiveList = document.getElementById('style-passive-list')!;

  // State variables
  let currentTargetCount = initialTargetVal || 0;
  let currentTargetType: 'words' | 'characters' = 'words';
  let currentNgram = 1;
  let academicModeEnabled = false;
  let autoSaveTimeout: any = null;

  // Restore session from localStorage if available
  const savedText = localStorage.getItem('wordcountr-draft');
  let restoredSession = false;
  if (savedText && textarea && !textarea.value) {
    textarea.value = savedText;
    restoredSession = true;
  }
  const savedTarget = localStorage.getItem('wordcountr-target');
  if (savedTarget && !currentTargetCount) {
    currentTargetCount = parseInt(savedTarget, 10) || 0;
  }

  // Toast Helper
  function notify(msg: string) {
    if (typeof (window as any).showToast === 'function') {
      (window as any).showToast(msg);
    }
  }

  // Robust Clipboard Helper (with fallback for mobile/non-https)
  function copyToClipboard(text: string, successMsg: string) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(() => {
        notify(successMsg);
      }).catch(() => fallbackCopy(text, successMsg));
    } else {
      fallbackCopy(text, successMsg);
    }
  }

  function fallbackCopy(text: string, successMsg: string) {
    const temp = document.createElement('textarea');
    temp.value = text;
    temp.style.position = 'fixed';
    temp.style.opacity = '0';
    document.body.appendChild(temp);
    temp.focus();
    temp.select();
    try {
      document.execCommand('copy');
      notify(successMsg);
    } catch (e) {
      alert('Unable to copy to clipboard.');
    }
    document.body.removeChild(temp);
  }

  function updateAll() {
    if (!textarea) return;
    const text = textarea.value;

    // Check academic mode filtering
    let textToAnalyze = text;
    if (academicModeEnabled) {
      const acad = filterAcademicText(text);
      textToAnalyze = acad.cleanedText;
      acadGrossWords.textContent = acad.originalWords.toLocaleString();
      acadNetWords.textContent = acad.filteredWords.toLocaleString();
      acadExcludedWords.textContent = acad.excludedWords.toLocaleString();
      acadExcludedDesc.textContent = `${acad.inTextCitationsCount} in-text citations · ${acad.referencesWordCount} reference words`;
    } else {
      const acad = filterAcademicText(text);
      acadGrossWords.textContent = acad.originalWords.toLocaleString();
      acadNetWords.textContent = acad.originalWords.toLocaleString();
      acadExcludedWords.textContent = '0 (Disabled)';
      acadExcludedDesc.textContent = `Found ${acad.inTextCitationsCount} in-text citations · ${acad.referencesWordCount} ref words`;
    }

    // 1. Calculate Core Metrics
    const metrics = calculateMetrics(textToAnalyze);

    statWords.textContent = metrics.words.toLocaleString();
    statLongestWord.textContent = metrics.longestWord ? `Longest: "${metrics.longestWord}"` : `Avg ${metrics.averageWordLength} chars/word`;
    statChars.textContent = metrics.characters.toLocaleString();
    statCharsNoSpaces.textContent = `${metrics.charactersNoSpaces.toLocaleString()} no spaces`;
    statSentences.textContent = metrics.sentences.toLocaleString();
    const wordsPerSent = metrics.sentences > 0 ? (metrics.words / metrics.sentences).toFixed(1) : '0';
    statWordsPerSentence.textContent = `${wordsPerSent} words/sent`;
    statParagraphs.textContent = metrics.paragraphs.toLocaleString();
    const sentsPerPara = metrics.paragraphs > 0 ? (metrics.sentences / metrics.paragraphs).toFixed(1) : '0';
    statSentsPerPara.textContent = `${sentsPerPara} sents/para`;
    statReadingTime.textContent = metrics.readingTimeFormatted;
    statSpeakingTime.textContent = metrics.speakingTimeFormatted;

    // 2. Target Goal Bar
    if (currentTargetCount > 0) {
      const current = currentTargetType === 'words' ? metrics.words : metrics.characters;
      const unit = currentTargetType;
      const percent = Math.min(100, Math.round((current / currentTargetCount) * 100));
      const remaining = currentTargetCount - current;

      targetProgressFill.style.width = `${percent}%`;

      if (remaining > 0) {
        targetTextStatus.innerHTML = `<span class="font-bold text-[#0066cc] dark:text-[#2997ff]">${current.toLocaleString()}</span> of <span class="font-bold">${currentTargetCount.toLocaleString()}</span> ${unit} (${remaining.toLocaleString()} remaining · ${percent}%)`;
        targetProgressFill.className = 'h-full bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-300 rounded-full';
      } else if (remaining === 0) {
        targetTextStatus.innerHTML = `🎯 <span class="font-bold text-emerald-600 dark:text-emerald-400">Goal Reached! Exactly ${currentTargetCount.toLocaleString()} ${unit}</span>`;
        targetProgressFill.className = 'h-full bg-emerald-500 transition-all duration-300 rounded-full';
      } else {
        const over = Math.abs(remaining);
        targetTextStatus.innerHTML = `⚠️ <span class="font-bold text-rose-600 dark:text-rose-400">${current.toLocaleString()}</span> of ${currentTargetCount.toLocaleString()} ${unit} (<span class="text-rose-600 dark:text-rose-400 font-bold">${over.toLocaleString()} over limit</span>)`;
        targetProgressFill.className = 'h-full bg-rose-500 transition-all duration-300 rounded-full';
      }
    } else {
      targetProgressFill.style.width = '0%';
      targetTextStatus.textContent = 'No target set';
    }

    // 3. Readability Scores
    const readability = calculateReadability(textToAnalyze, metrics.words, metrics.sentences, metrics.charactersNoSpaces);
    readFreScore.textContent = readability.fleschReadingEase.toString();
    readFreBadge.textContent = readability.fleschReadingEaseLabel;
    readGradeAvg.textContent = readability.averageGradeLevel > 0 ? readability.averageGradeLevel.toString() : 'N/A';
    readGradeSummary.textContent = readability.gradeLevelSummary;
    readFkg.textContent = readability.fleschKincaidGrade.toFixed(1);
    readFog.textContent = readability.gunningFog.toFixed(1);
    readCli.textContent = readability.colemanLiau.toFixed(1);
    readAri.textContent = readability.automatedReadabilityIndex.toFixed(1);

    readingLevelPill.textContent = readability.averageGradeLevel > 0 
      ? `Reading Level: Grade ${readability.averageGradeLevel} (${readability.fleschReadingEaseLabel})` 
      : 'Reading Level: —';

    // 4. Keyword Density
    const kwResult = calculateKeywordDensity(textToAnalyze, checkStopwords?.checked ?? true, 12);
    let activeKwList = kwResult.oneWord;
    if (currentNgram === 2) activeKwList = kwResult.twoWord;
    if (currentNgram === 3) activeKwList = kwResult.threeWord;

    if (activeKwList.length === 0) {
      keywordsTableBody.innerHTML = `<tr><td colspan="3" class="py-8 text-center text-[#86868b]">No matching keyword phrases detected.</td></tr>`;
    } else {
      keywordsTableBody.innerHTML = activeKwList.map((k) => `
        <tr class="keyword-row hover:bg-black/5 dark:hover:bg-white/5 transition cursor-pointer" data-keyword="${k.phrase}" title="Click to highlight in text editor">
          <td class="py-2.5 font-medium text-[#1d1d1f] dark:text-[#f5f5f7] flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#0066cc] dark:text-[#2997ff] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <span>${k.phrase}</span>
          </td>
          <td class="py-2.5 text-center font-mono-numbers text-[#515154] dark:text-[#a1a1a6] font-semibold">${k.count}</td>
          <td class="py-2.5 text-right font-mono-numbers">
            <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-semibold ${k.density > 4 ? 'bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-400' : 'bg-[#f5f5f7] text-[#1d1d1f] dark:bg-[#2c2c2e] dark:text-[#f5f5f7]'}">
              ${k.density}%
            </span>
          </td>
        </tr>
      `).join('');

      // Attach click-to-highlight listeners
      keywordsTableBody.querySelectorAll('.keyword-row').forEach((row) => {
        row.addEventListener('click', () => {
          const phrase = (row as HTMLElement).dataset.keyword;
          if (phrase) highlightWordInEditor(phrase);
        });
      });
    }

    // 5. Social Media Limits
    const socialCharCountLabel = document.getElementById('social-live-char-count');
    if (socialCharCountLabel) {
      socialCharCountLabel.textContent = `${metrics.characters.toLocaleString()} characters`;
    }

    const socialStatuses = evaluatePlatformLimits(metrics.characters);
    socialGrid.innerHTML = socialStatuses.map((s) => {
      const isExceeded = s.isOverLimit;
      const isWarning = s.percentage >= 85 && !isExceeded;

      return `
        <div class="p-3.5 sm:p-4 rounded-2xl border transition-all ${
          isExceeded
            ? 'bg-[#fff2f2] dark:bg-[#2b1616] border-[#ff3b30]/30'
            : isWarning
            ? 'bg-[#fffaf0] dark:bg-[#2b2416] border-[#ff9500]/30'
            : 'bg-[#fafafc] dark:bg-[#161617] border-[#e5e5ea] dark:border-[#2c2c2e]'
        }">
          <div class="flex items-center justify-between mb-2">
            <span class="font-semibold text-xs text-[#1d1d1f] dark:text-[#f5f5f7]">
              ${s.limit.name}
            </span>
            ${
              isExceeded
                ? `<span class="flex items-center gap-1 text-[10px] font-bold text-[#ff3b30] bg-[#ffe5e5] dark:bg-[#3a1515] px-2 py-0.5 rounded-full">
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9" stroke-width="2"/><path d="M12 8v4m0 4h.01" stroke-width="2" stroke-linecap="round"/></svg>
                    +${Math.abs(s.remainingChars).toLocaleString()}
                  </span>`
                : isWarning
                ? `<span class="flex items-center gap-1 text-[10px] font-bold text-[#ff9500] bg-[#fff3cd] dark:bg-[#3a2e15] px-2 py-0.5 rounded-full">
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    ${s.remainingChars.toLocaleString()} left
                  </span>`
                : `<span class="flex items-center gap-1 text-[10px] font-semibold text-[#34c759] bg-[#e8f5e9] dark:bg-[#1b3a24] px-2 py-0.5 rounded-full">
                    <svg class="w-3 h-3 text-[#34c759]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    ${s.remainingChars.toLocaleString()} left
                  </span>`
            }
          </div>

          <!-- Progress Bar -->
          <div class="w-full h-1 bg-[#e5e5ea] dark:bg-[#2c2c2e] rounded-full overflow-hidden mb-2">
            <div
              class="h-full transition-all duration-300 ${
                isExceeded
                  ? 'bg-[#ff3b30]'
                  : isWarning
                  ? 'bg-[#ff9500]'
                  : 'bg-[#0071e3] dark:bg-[#2997ff]'
              }"
              style="width: ${s.percentage}%"
            ></div>
          </div>

          <div class="flex items-center justify-between text-[11px] text-[#86868b] font-mono-numbers">
            <span>${s.currentChars.toLocaleString()} / ${s.limit.maxChars.toLocaleString()}</span>
            <span>${s.percentage}%</span>
          </div>
        </div>
      `;
    }).join('');

    // 6. Style & Quality Audit (Filler Words & Passive Voice)
    const style = analyzeStyle(textToAnalyze);
    styleFillerCount.textContent = style.fillerWordsCount.toLocaleString();
    stylePassiveCount.textContent = style.passiveVoiceCount.toLocaleString();
    styleFillerDesc.textContent = style.fillerWordsCount > 0 ? `${style.fillerWordsCount} weak qualifiers detected.` : 'No weak fillers found. Your copy is clean.';
    stylePassiveDesc.textContent = style.passiveVoiceCount > 0 ? `${style.passiveVoiceCount} passive constructions flagged.` : 'No passive voice found. Strong active verbs.';

    if (style.fillerMatches.length === 0) {
      styleFillerList.innerHTML = `<span class="text-[#86868b]">No filler words detected.</span>`;
    } else {
      styleFillerList.innerHTML = style.fillerMatches.map(f => `
        <button type="button" class="style-match-tag inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 text-amber-800 dark:text-amber-400 font-medium hover:bg-amber-500/20 transition cursor-pointer" data-phrase="${f.word}">
          <span>"${f.word}"</span>
          <span class="text-[10px] bg-amber-500/20 px-1.5 py-0.5 rounded-full font-bold">${f.count}</span>
        </button>
      `).join('');
    }

    if (style.passiveMatches.length === 0) {
      stylePassiveList.innerHTML = `<span class="text-[#86868b]">No passive voice detected.</span>`;
    } else {
      stylePassiveList.innerHTML = style.passiveMatches.map(p => `
        <button type="button" class="style-match-tag inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-800 dark:text-indigo-400 font-medium hover:bg-indigo-500/20 transition cursor-pointer" data-phrase="${p.phrase}">
          <span>"${p.phrase}"</span>
          <span class="text-[10px] bg-indigo-500/20 px-1.5 py-0.5 rounded-full font-bold">${p.count}</span>
        </button>
      `).join('');
    }

    // Attach listeners for style tags
    document.querySelectorAll('.style-match-tag').forEach((btn) => {
      btn.addEventListener('click', () => {
        const phrase = (btn as HTMLElement).dataset.phrase;
        if (phrase) highlightWordInEditor(phrase);
      });
    });

    // Immediate LocalStorage Auto-Save
    localStorage.setItem('wordcountr-draft', text);
    autosaveLabel.textContent = `Saved locally at ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
  }

  // Event Listeners for Editor
  textarea?.addEventListener('input', updateAll);
  textarea?.addEventListener('paste', () => setTimeout(updateAll, 50));
  checkStopwords?.addEventListener('change', updateAll);
  toggleAcademic?.addEventListener('change', (e) => {
    academicModeEnabled = (e.target as HTMLInputElement).checked;
    updateAll();
  });

  // Switch Active Tab function
  function switchTab(targetTab: string) {
    tabButtons.forEach((btn) => {
      const b = btn as HTMLElement;
      if (b.dataset.tab === targetTab) {
        b.className = 'analysis-tab-btn flex items-center gap-2 px-4 py-2 rounded-full text-xs font-semibold bg-[#0066cc] text-white dark:bg-[#2997ff] dark:text-black transition apple-button shrink-0';
      } else {
        b.className = 'analysis-tab-btn flex items-center gap-2 px-4 py-2 rounded-full text-xs font-medium text-[#515154] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5 transition apple-button shrink-0';
      }
    });

    panels.forEach((p) => p.classList.add('hidden'));
    const activePanel = document.getElementById(`tab-content-${targetTab}`);
    if (activePanel) activePanel.classList.remove('hidden');
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabName = (btn as HTMLElement).dataset.tab;
      if (tabName) switchTab(tabName);
    });
  });

  // Initialize with initialTab prop
  if (initialTab && initialTab !== 'keywords') {
    switchTab(initialTab);
    if (initialTab === 'academic') {
      academicModeEnabled = true;
      if (toggleAcademic) toggleAcademic.checked = true;
    }
  }

  // N-Gram Buttons
  ngramButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentNgram = parseInt((btn as HTMLElement).dataset.ngram || '1', 10);
      ngramButtons.forEach((b) => {
        (b as HTMLElement).className = 'ngram-btn px-3 py-1 rounded-full text-xs font-medium bg-[#f5f5f7] dark:bg-[#2c2c2e] text-[#515154] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white transition apple-button';
      });
      (btn as HTMLElement).className = 'ngram-btn px-3 py-1 rounded-full text-xs font-semibold bg-[#0066cc]/10 dark:bg-[#2997ff]/15 text-[#0066cc] dark:text-[#2997ff] transition apple-button';
      updateAll();
    });
  });

  // Target Goal Buttons
  btnTarget280?.addEventListener('click', () => {
    currentTargetCount = 280;
    currentTargetType = 'characters';
    localStorage.setItem('wordcountr-target', '280');
    updateAll();
    notify('Target set to 280 characters (X post)');
  });
  btnTarget500?.addEventListener('click', () => {
    currentTargetCount = 500;
    currentTargetType = 'words';
    localStorage.setItem('wordcountr-target', '500');
    updateAll();
    notify('Target set to 500 words');
  });
  btnTarget1000?.addEventListener('click', () => {
    currentTargetCount = 1000;
    currentTargetType = 'words';
    localStorage.setItem('wordcountr-target', '1000');
    updateAll();
    notify('Target set to 1,000 words');
  });

  btnSetCustomTarget?.addEventListener('click', () => {
    customTargetInput.value = currentTargetCount > 0 ? currentTargetCount.toString() : '';
    targetModal.classList.remove('hidden');
    setTimeout(() => customTargetInput.focus(), 50);
  });
  btnCancelTargetModal?.addEventListener('click', () => targetModal.classList.add('hidden'));
  btnClearTarget?.addEventListener('click', () => {
    currentTargetCount = 0;
    localStorage.removeItem('wordcountr-target');
    targetModal.classList.add('hidden');
    updateAll();
    notify('Target goal removed');
  });
  btnSaveTargetModal?.addEventListener('click', () => {
    const val = parseInt(customTargetInput.value, 10);
    if (!isNaN(val) && val > 0) {
      currentTargetCount = val;
      currentTargetType = 'words';
      localStorage.setItem('wordcountr-target', val.toString());
      notify(`Target goal set to ${val.toLocaleString()} words`);
    }
    targetModal.classList.add('hidden');
    updateAll();
  });
  customTargetInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      btnSaveTargetModal.click();
    } else if (e.key === 'Escape') {
      targetModal.classList.add('hidden');
    }
  });

  // Case Converter Dropdown
  const caseMenuBtn = document.getElementById('case-menu-btn');
  const caseDropdown = document.getElementById('case-dropdown');
  caseMenuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    caseDropdown?.classList.toggle('hidden');
  });
  window.addEventListener('click', () => caseDropdown?.classList.add('hidden'));

  document.querySelectorAll('.case-option').forEach((opt) => {
    opt.addEventListener('click', () => {
      const caseType = (opt as HTMLElement).dataset.case;
      const text = textarea.value;
      if (!text) {
        notify('Editor is empty');
        return;
      }
      if (caseType === 'upper') {
        textarea.value = text.toUpperCase();
        notify('Converted to UPPERCASE');
      } else if (caseType === 'lower') {
        textarea.value = text.toLowerCase();
        notify('Converted to lowercase');
      } else if (caseType === 'sentence') {
        textarea.value = text.toLowerCase().replace(/(^\s*\w|[.!?]\s*\w)/g, (c) => c.toUpperCase());
        notify('Converted to Sentence case');
      } else if (caseType === 'title') {
        textarea.value = text.toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
        notify('Converted to Title Case');
      }
      caseDropdown?.classList.add('hidden');
      updateAll();
    });
  });

  // Interactive Word Highlighter in Textarea
  function highlightWordInEditor(phrase: string) {
    if (!textarea || !phrase) return;
    const text = textarea.value;
    const lowerText = text.toLowerCase();
    const lowerPhrase = phrase.toLowerCase();
    const idx = lowerText.indexOf(lowerPhrase);
    if (idx !== -1) {
      textarea.focus();
      textarea.setSelectionRange(idx, idx + phrase.length);
      notify(`✓ Highlighted "${phrase}" in text`);
    } else {
      notify(`Word "${phrase}" not found in current text`);
    }
  }
  (window as any).highlightWord = highlightWordInEditor;
  (window as any).switchAnalysisTab = switchTab;

  // Export Menu (Download TXT, MD, Copy Full Report)
  const exportBtn = document.getElementById('export-menu-btn');
  const exportDropdown = document.getElementById('export-dropdown');
  exportBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    exportDropdown?.classList.toggle('hidden');
  });
  window.addEventListener('click', () => exportDropdown?.classList.add('hidden'));

  document.querySelectorAll('.export-opt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = (btn as HTMLElement).dataset.export;
      const text = textarea.value;
      if (!text.trim()) {
        notify('Editor is empty');
        return;
      }
      if (type === 'txt') {
        const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `wordcountr-document-${Date.now()}.txt`;
        a.click();
        notify('✓ Downloaded document.txt');
      } else if (type === 'md') {
        const blob = new Blob([text], { type: 'text/markdown;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `wordcountr-document-${Date.now()}.md`;
        a.click();
        notify('✓ Downloaded document.md');
      } else if (type === 'report') {
        const m = calculateMetrics(text);
        const r = calculateReadability(text, m.words, m.sentences, m.charactersNoSpaces);
        const s = analyzeStyle(text);
        const report = `═══════════════════════════════════════\n` +
          `       WORDCOUNTR PRO ANALYSIS REPORT   \n` +
          `═══════════════════════════════════════\n\n` +
          `• Words: ${m.words.toLocaleString()}\n` +
          `• Characters (with spaces): ${m.characters.toLocaleString()}\n` +
          `• Characters (no spaces): ${m.charactersNoSpaces.toLocaleString()}\n` +
          `• Sentences: ${m.sentences.toLocaleString()}\n` +
          `• Paragraphs: ${m.paragraphs.toLocaleString()}\n` +
          `• Average Word Length: ${m.averageWordLength} chars\n` +
          `• Reading Time (225 WPM): ${m.readingTimeFormatted}\n` +
          `• Speaking Time (130 WPM): ${m.speakingTimeFormatted}\n\n` +
          `READABILITY & GRADES:\n` +
          `• Flesch Reading Ease: ${r.fleschReadingEase} (${r.fleschReadingEaseLabel})\n` +
          `• Average Grade Level: Grade ${r.averageGradeLevel} (${r.gradeLevelSummary})\n` +
          `• Flesch-Kincaid Grade: ${r.fleschKincaidGrade.toFixed(1)}\n` +
          `• Gunning Fog Index: ${r.gunningFog.toFixed(1)}\n` +
          `• Coleman-Liau: ${r.colemanLiau.toFixed(1)}\n` +
          `• ARI: ${r.automatedReadabilityIndex.toFixed(1)}\n\n` +
          `STYLE & QUALITY AUDIT:\n` +
          `• Filler Words Detected: ${s.fillerWordsCount}\n` +
          `• Passive Voice Phrases: ${s.passiveVoiceCount}\n\n` +
          `═══════════════════════════════════════\n` +
          `Generated via WordCountr Pro — 100% Private\n`;
        copyToClipboard(report, '✓ Copied complete analysis report');
      }
      exportDropdown?.classList.add('hidden');
    });
  });

  // Action Buttons: Copy Stats, Copy Text, Clear
  btnCopyStats?.addEventListener('click', () => {
    if (!textarea.value.trim()) {
      notify('Editor is empty');
      return;
    }
    const metrics = calculateMetrics(textarea.value);
    const summary = `📊 Text Analysis (via WordCountr.app):\n` +
      `• Words: ${metrics.words.toLocaleString()}\n` +
      `• Characters (with spaces): ${metrics.characters.toLocaleString()}\n` +
      `• Characters (without spaces): ${metrics.charactersNoSpaces.toLocaleString()}\n` +
      `• Sentences: ${metrics.sentences.toLocaleString()}\n` +
      `• Paragraphs: ${metrics.paragraphs.toLocaleString()}\n` +
      `• Reading Time: ${metrics.readingTimeFormatted}\n` +
      `• Speaking Time: ${metrics.speakingTimeFormatted}`;

    copyToClipboard(summary, '✓ Copied statistics to clipboard');
  });

  btnCopyText?.addEventListener('click', () => {
    if (!textarea.value.trim()) {
      notify('Editor is empty');
      return;
    }
    copyToClipboard(textarea.value, '✓ Copied text to clipboard');
  });

  let clearConfirmActive = false;
  let clearTimer: any = null;
  btnClearText?.addEventListener('click', () => {
    if (!textarea.value.trim()) return;

    if (!clearConfirmActive) {
      clearConfirmActive = true;
      btnClearText.innerHTML = `<span>Sure? Tap again</span>`;
      clearTimer = setTimeout(() => {
        clearConfirmActive = false;
        btnClearText.innerHTML = `
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          <span>Clear</span>
        `;
      }, 3000);
    } else {
      clearTimeout(clearTimer);
      clearConfirmActive = false;
      textarea.value = '';
      localStorage.removeItem('wordcountr-draft');
      updateAll();
      textarea.focus();
      btnClearText.innerHTML = `
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        <span>Clear</span>
      `;
      notify('Editor cleared');
    }
  });

  // Explicit File Upload Trigger
  btnTriggerUpload?.addEventListener('click', () => {
    fileInput?.click();
  });

  fileInput?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    try {
      notify(`Parsing ${file.name}...`);
      autosaveLabel.textContent = `Parsing ${file.name}...`;
      const extracted = await parseUploadedFile(file);
      textarea.value = extracted;
      updateAll();
      autosaveLabel.textContent = `Loaded ${file.name}`;
      notify(`✓ Loaded ${file.name}`);
    } catch (err: any) {
      alert(`File parse error: ${err.message}`);
      autosaveLabel.textContent = 'File parse error';
    } finally {
      fileInput.value = ''; // Reset so the same file can be reloaded if desired
    }
  });

  // Drag & drop on container
  window.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropOverlay?.classList.remove('hidden');
  });
  window.addEventListener('dragleave', (e) => {
    if (e.relatedTarget === null) {
      dropOverlay?.classList.add('hidden');
    }
  });
  window.addEventListener('drop', async (e) => {
    e.preventDefault();
    dropOverlay?.classList.add('hidden');
    const file = e.dataTransfer?.files?.[0];
    if (file) {
      try {
        notify(`Parsing ${file.name}...`);
        autosaveLabel.textContent = `Parsing ${file.name}...`;
        const extracted = await parseUploadedFile(file);
        textarea.value = extracted;
        updateAll();
        autosaveLabel.textContent = `Loaded ${file.name}`;
        notify(`✓ Loaded ${file.name}`);
      } catch (err: any) {
        alert(`File parse error: ${err.message}`);
        autosaveLabel.textContent = 'File parse error';
      }
    }
  });

  // Initial calculation on mount
  updateAll();

  // If restored from saved draft, notify user
  if (restoredSession && savedText && savedText.trim().length > 0) {
    setTimeout(() => {
      notify('✓ Draft restored from previous session');
    }, 400);
  }
</script>
