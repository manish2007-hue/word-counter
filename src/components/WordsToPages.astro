---
// Words to Pages Conversion Reference Guide (High-Intent SEO Asset)
const conversionData = [
  { words: 250, single: '0.5 page', double: '1 page', readTime: '1.1 min', useCase: 'Abstract, Short Assignment' },
  { words: 500, single: '1 page', double: '2 pages', readTime: '2.2 min', useCase: 'College Essay, Cover Letter' },
  { words: 750, single: '1.5 pages', double: '3 pages', readTime: '3.3 min', useCase: 'Standard Blog Post, Opinion Column' },
  { words: 1000, single: '2 pages', double: '4 pages', readTime: '4.4 min', useCase: 'Term Paper, Editorial Article' },
  { words: 1500, single: '3 pages', double: '6 pages', readTime: '6.6 min', useCase: 'Comprehensive Guide, Academic Paper' },
  { words: 2000, single: '4 pages', double: '8 pages', readTime: '8.8 min', useCase: 'Research Report, University Thesis' },
  { words: 2500, single: '5 pages', double: '10 pages', readTime: '11.1 min', useCase: 'Long-form Case Study, Monograph' },
  { words: 5000, single: '10 pages', double: '20 pages', readTime: '22.2 min', useCase: 'Dissertation Chapter, Whitepaper' },
];
---

<section class="mt-12 vercel-card p-6 sm:p-8" id="words-to-pages">
  <div class="max-w-3xl mb-6">
    <div class="mono-eyebrow text-[#0070f3] mb-2">
      Academic & Publishing Spec
    </div>
    <h2 class="text-xl sm:text-2xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-[#ededed]">
      Words to Pages Conversion Matrix
    </h2>
    <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] mt-1.5 leading-relaxed">
      Standard page estimates based on 12pt typography with 1-inch margins. Academic submissions follow standard double-spaced format (approx. 250 words per page).
    </p>
  </div>

  <div class="overflow-x-auto rounded-[8px] border border-[#ebebeb] dark:border-[#222222]">
    <table class="w-full text-left text-xs sm:text-sm">
      <thead>
        <tr class="border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#0e0e0e] text-[#8f8f8f] font-mono">
          <th class="py-2.5 px-4 font-medium">WORD COUNT</th>
          <th class="py-2.5 px-4 font-medium">SINGLE-SPACED</th>
          <th class="py-2.5 px-4 font-medium text-[#0070f3]">DOUBLE-SPACED</th>
          <th class="py-2.5 px-4 font-medium">READ TIME</th>
          <th class="py-2.5 px-4 font-medium hidden md:table-cell">SPEC USE CASE</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#ebebeb] dark:divide-[#222222]">
        {conversionData.map((row) => (
          <tr class="hover:bg-black/5 dark:hover:bg-white/5 transition font-mono">
            <td class="py-2.5 px-4 font-semibold text-[#171717] dark:text-[#ededed]">
              <a href={`/words-to-pages/${row.words}-words`} class="text-[#0070f3] hover:underline flex items-center gap-1">
                <span>{row.words.toLocaleString()} words</span>
                <span class="text-[10px] text-[#8f8f8f]">↗</span>
              </a>
            </td>
            <td class="py-2.5 px-4 text-[#4d4d4d] dark:text-[#a1a1a1]">
              {row.single}
            </td>
            <td class="py-2.5 px-4 font-semibold text-[#0070f3]">
              {row.double}
            </td>
            <td class="py-2.5 px-4 text-[#8f8f8f]">
              {row.readTime}
            </td>
            <td class="py-2.5 px-4 text-[#8f8f8f] font-sans hidden md:table-cell">
              {row.useCase}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-xs text-[#8f8f8f] bg-[#fafafa] dark:bg-[#0e0e0e] p-3 rounded-[8px] border border-[#ebebeb] dark:border-[#222222] font-mono">
    <div>
      💡 <strong>Standard:</strong> Double-spaced pages ≈ Words ÷ 250 &bull; Single-spaced pages ≈ Words ÷ 500.
    </div>
    <div class="text-[11px]">
      Computed at silent reading baseline of 225 WPM.
    </div>
  </div>
</section>
