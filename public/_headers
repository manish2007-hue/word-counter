# Prevent indexing of all Cloudflare Pages and preview URLs
https://*.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://wordcountr-5t5.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://*.wordcountr-5t5.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Global security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Service worker must never be cached by edge or browser
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# HTML documents should always revalidate so users see immediate updates
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
